# Build output
/build/

# Bundled toolchain (large; fetched locally, not committed)
/.toolchain/

# Extracted / local game data (never commit proprietary assets)
/gamedata/
/assets_extracted/

# Editor / OS cruft
*.obj
*.o
*.exe
*.pdb
*.ilk
.vs/
.vscode/
*.user
Thumbs.db

# Per-worktree scratch, reverse-engineering snapshots and logs
/work/
/.claude/


# Runtime log written to the working directory by core::Log
wfc.log

# Python bytecode
__pycache__/
*.pyc

# Frontend runtime state in the working directory: decoded movie audio cache, local profile, input overrides
wfc_cache/
wfc_profile.ini
