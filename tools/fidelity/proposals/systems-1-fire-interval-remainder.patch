From cb324f03164fc2de7ab01f91a7ca1f034ba09556 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 1 Oct 2026 16:26:19 -0500
Subject: [PATCH] Fire interval remainder

---
 src/game/Weapon.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/game/Weapon.h b/src/game/Weapon.h
index 872b841..caeb3c0 100644
--- a/src/game/Weapon.h
+++ b/src/game/Weapon.h
@@ -51,7 +51,10 @@ struct Weapon {
     bool reloading() const { return reloadTimer > 0.0f; }
     bool canFire() const { return cooldown <= 0.0f && ammo > 0 && !reloading(); }
     void onFired() {
-        cooldown = fireInterval;
+        // Carry the sub-step remainder like a UE3 looping refire timer (Count -= Rate) so sustained
+        // fire averages exactly FireInterval (923 RPM) at any tick rate; tick() stops counting at
+        // <= 0, so after a pause the carry is bounded by one step.
+        cooldown = (cooldown < 0.0f ? cooldown : 0.0f) + fireInterval;
         if (ammo > 0) --ammo;
         ++shotSerial;
         sinceFire = 0.0f;
-- 
