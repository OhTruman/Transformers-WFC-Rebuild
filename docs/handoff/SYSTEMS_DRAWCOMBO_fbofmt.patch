+// The bound draw framebuffer's format: per attachment (GL_FRAMEBUFFER_ATTACHMENT_* queries need no binding change) the
+// component type and the packed R / G / B / A (or depth / stencil) bit sizes; GL_NONE attachments are 0. The default
+// framebuffer uses GL_BACK_LEFT / GL_DEPTH / GL_STENCIL.
+void fboFormat(GLint fbo, GLint* out) {
+    if (!getFbAttach) return;
+    const GLenum target = 0x8CA9;                                               // GL_DRAW_FRAMEBUFFER
+    const GLenum col[2] = {fbo ? 0x8CE0u : 0x0402u, fbo ? 0x8CE1u : 0u};        // COLOR_ATTACHMENT0 / 1, or BACK_LEFT
+    const GLenum dep = fbo ? 0x8D00u : 0x1801u, sten = fbo ? 0x8D20u : 0x1802u; // DEPTH_ / STENCIL_ATTACHMENT, or DEPTH / STENCIL
+    auto q = [&](GLenum att, GLenum pname) { GLint v = 0; getFbAttach(target, att, pname, &v); return v; };
+    for (int i = 0; i < 2; ++i) {
+        if (!col[i] || q(col[i], 0x8CD0) == 0) continue;                        // GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE: GL_NONE
+        out[i * 2] = q(col[i], 0x8211);                                         // _COMPONENT_TYPE
+        out[i * 2 + 1] = q(col[i], 0x8212) | q(col[i], 0x8213) << 8 | q(col[i], 0x8214) << 16 | q(col[i], 0x8215) << 24;
+    }
+    if (q(dep, 0x8CD0) != 0) out[4] = q(dep, 0x8216);                           // _DEPTH_SIZE
+    if (q(sten, 0x8CD0) != 0) out[4] |= q(sten, 0x8217) << 8;                   // _STENCIL_SIZE
+    out[5] = geti(0x80A9);                                                      // GL_SAMPLES of the bound draw framebuffer
+    out[6] = 0;
+}
