diff -ruN a/src/net/Lockstep.cpp b/src/net/Lockstep.cpp
--- a/src/net/Lockstep.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/Lockstep.cpp	2026-10-17 12:43:16.923201900 -0500
@@ -0,0 +1,262 @@
+// [Systems] Lockstep layer - see Lockstep.h.
+#include "net/Lockstep.h"
+
+#include "core/Log.h"
+#include "game/World.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+
+namespace net {
+namespace {
+
+double nowMs() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+constexpr float kR = 65536.0f / 6.2831853f;   // rotator units per radian (the same constant as World::encodeLocalCommand)
+
+void put8(std::vector<uint8_t>& b, uint8_t v) { b.push_back(v); }
+void put32(std::vector<uint8_t>& b, uint32_t v) { for (int i = 0; i < 4; ++i) b.push_back((uint8_t)(v >> (8 * i))); }
+void put64(std::vector<uint8_t>& b, uint64_t v) { for (int i = 0; i < 8; ++i) b.push_back((uint8_t)(v >> (8 * i))); }
+uint32_t get32(const uint8_t* p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+uint64_t get64(const uint8_t* p) { return (uint64_t)get32(p) | ((uint64_t)get32(p + 4) << 32); }
+
+enum : uint8_t { kCmds = 1, kHello = 2, kHash = 3, kBye = 4 };
+
+}  // namespace
+
+WireCommand encodeCommand(const game::RemoteCommand& c) {
+    WireCommand w{};
+    w[0] = (uint8_t)c.moveForward; w[1] = (uint8_t)c.moveRight;
+    for (int i = 0; i < 4; ++i) { w[2 + i] = (uint8_t)(c.buttons >> (8 * i)); w[6 + i] = (uint8_t)(c.pressed >> (8 * i)); }
+    const uint16_t qy = (uint16_t)(std::lround(c.aimYaw * kR) & 0xffff);
+    const int16_t qp = (int16_t)std::lround(std::max(-1.5707963f, std::min(1.5707963f, c.aimPitch)) * kR);
+    w[10] = (uint8_t)qy; w[11] = (uint8_t)(qy >> 8); w[12] = (uint8_t)qp; w[13] = (uint8_t)((uint16_t)qp >> 8);
+    const float a[3] = {c.aimPoint.x, c.aimPoint.y, c.aimPoint.z};
+    for (int k = 0; k < 3; ++k) {
+        long v = std::lround(a[k] * 100.0f);
+        v = std::max(-8388607L, std::min(8388607L, v));
+        const uint32_t u = (uint32_t)v & 0xffffff;
+        w[14 + 3 * k] = (uint8_t)u; w[15 + 3 * k] = (uint8_t)(u >> 8); w[16 + 3 * k] = (uint8_t)(u >> 16);
+    }
+    return w;
+}
+
+void decodeCommand(const WireCommand& w, uint32_t tick, game::RemoteCommand& c) {
+    c = game::RemoteCommand{};
+    c.tick = tick;
+    c.moveForward = (int8_t)w[0]; c.moveRight = (int8_t)w[1];
+    c.buttons = (uint32_t)w[2] | ((uint32_t)w[3] << 8) | ((uint32_t)w[4] << 16) | ((uint32_t)w[5] << 24);
+    c.pressed = (uint32_t)w[6] | ((uint32_t)w[7] << 8) | ((uint32_t)w[8] << 16) | ((uint32_t)w[9] << 24);
+    const uint16_t qy = (uint16_t)(w[10] | (w[11] << 8));
+    const int16_t qp = (int16_t)(uint16_t)(w[12] | (w[13] << 8));
+    c.aimYaw = std::remainder((float)qy / kR, 6.2831853f);   // as World::encodeLocalCommand decodes its own grid value
+    c.aimPitch = (float)qp / kR;
+    float a[3];
+    for (int k = 0; k < 3; ++k) {
+        uint32_t u = (uint32_t)w[14 + 3 * k] | ((uint32_t)w[15 + 3 * k] << 8) | ((uint32_t)w[16 + 3 * k] << 16);
+        if (u & 0x800000u) u |= 0xff000000u;   // sign-extend the 24-bit value
+        a[k] = (float)(int32_t)u / 100.0f;
+    }
+    c.aimPoint = core::Vec3{a[0], a[1], a[2]};
+}
+
+Lockstep::Lockstep(INetTransport& t, const Config& c) : t_(t), cfg_(c) {
+    cmds_.resize((size_t)cfg_.seats);
+    contiguous_.assign((size_t)cfg_.seats, 0);
+    peerAck_.assign((size_t)cfg_.seats, 0);
+    hello_.assign((size_t)cfg_.seats, 0);
+    hello_[(size_t)cfg_.self] = 1;
+    if (!cfg_.logPath.empty()) {
+        log_ = std::fopen(cfg_.logPath.c_str(), "w");
+        if (log_) std::fprintf(log_, "tick,simhash,bundlehash,stall_ms,bytes_in,bytes_out,rtt_ms\n");
+    }
+    std::vector<uint8_t> b; put8(b, kHello); put8(b, (uint8_t)cfg_.self); put64(b, cfg_.launchHash);
+    for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) t_.sendReliable(s, b.data(), b.size());
+    LOG_INFO("NET lockstep: seat %d of %d, D %d, hash every %d, launch hash %016llx", cfg_.self, cfg_.seats, cfg_.delay, cfg_.hashEvery,
+             (unsigned long long)cfg_.launchHash);
+}
+
+Lockstep::~Lockstep() { if (log_) std::fclose(log_); }
+
+void Lockstep::fail(Status s, const std::string& why) {
+    if (status_ != Status::Running) return;
+    status_ = s; statusText_ = why;
+    LOG_ERROR("NET %s", why.c_str());
+}
+
+bool Lockstep::everyoneHere() const {
+    for (char h : hello_) if (!h) return false;
+    return true;
+}
+
+void Lockstep::pump() {
+    t_.service();
+    NetPacket p;
+    while (t_.poll(p)) handle(p);
+    // The last commands again every 15 ms (a lost packet or a stalled peer must not deadlock the exchange).
+    if (localHigh_ > 0 && nowMs() - lastSendMs_ >= 15.0)
+        for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) sendCommands(s);
+}
+
+void Lockstep::handle(const NetPacket& p) {
+    const std::vector<uint8_t>& d = p.data;
+    if (d.size() < 2 || p.from < 0 || p.from >= cfg_.seats) return;
+    const int seat = p.from;
+    switch (d[0]) {
+    case kCmds: {
+        if (d.size() < 11) return;
+        const uint32_t ack = get32(&d[2]), first = get32(&d[6]);
+        const size_t count = d[10];
+        if (d.size() < 11 + count * kWireCommandBytes) return;
+        peerAck_[(size_t)seat] = std::max(peerAck_[(size_t)seat], ack);
+        auto& m = cmds_[(size_t)seat];
+        for (size_t i = 0; i < count; ++i) {
+            WireCommand w;
+            std::copy(d.begin() + 11 + (long)(i * kWireCommandBytes), d.begin() + 11 + (long)((i + 1) * kWireCommandBytes), w.begin());
+            m.emplace(first + (uint32_t)i, w);   // duplicates / resends: the first copy stays (they are identical)
+        }
+        uint32_t& c = contiguous_[(size_t)seat];
+        while (m.count(c + 1)) ++c;
+        break;
+    }
+    case kHello: {
+        if (d.size() < 10) return;
+        const uint64_t h = get64(&d[2]);
+        if (h != cfg_.launchHash) {
+            char buf[160];
+            std::snprintf(buf, sizeof buf, "launch mismatch with seat %d (%016llx vs ours %016llx): the match settings changed", seat,
+                          (unsigned long long)h, (unsigned long long)cfg_.launchHash);
+            fail(Status::LaunchMismatch, buf);
+        }
+        if (!hello_[(size_t)seat]) LOG_INFO("NET seat %d here", seat);
+        hello_[(size_t)seat] = 1;
+        break;
+    }
+    case kHash: {
+        if (d.size() < 14) return;
+        const uint32_t tick = get32(&d[2]);
+        const uint64_t h = get64(&d[6]);
+        auto own = ownHash_.find(tick);
+        if (own != ownHash_.end() && own->second != h) {
+            char buf[160];
+            std::snprintf(buf, sizeof buf, "DESYNC at tick %u: seat %d %016llx, ours (seat %d) %016llx", tick, seat, (unsigned long long)h,
+                          cfg_.self, (unsigned long long)own->second);
+            fail(Status::Desync, buf);
+        } else if (own == ownHash_.end()) {
+            peerHash_[tick].push_back({seat, h});
+        }
+        break;
+    }
+    case kBye:
+        LOG_INFO("NET seat %d left", seat);
+        if (seat == 0) fail(Status::HostLost, "the host left");
+        break;
+    default: break;
+    }
+}
+
+void Lockstep::sendCommands(int peer) {
+    // From the tick after the peer's ack (their contiguous copy of my seat) to my latest, at most maxResend ticks.
+    uint32_t first = peerAck_[(size_t)peer] + 1;
+    if (localHigh_ >= (uint32_t)cfg_.maxResend && first + (uint32_t)cfg_.maxResend <= localHigh_) first = localHigh_ - (uint32_t)cfg_.maxResend + 1;
+    if (first > localHigh_) first = localHigh_;   // nothing new: repeat the latest (keeps the ack flowing back)
+    const auto& mine = cmds_[(size_t)cfg_.self];
+    std::vector<uint8_t> b;
+    put8(b, kCmds); put8(b, (uint8_t)cfg_.self); put32(b, contiguous_[(size_t)peer]); put32(b, first);
+    const size_t countAt = b.size(); put8(b, 0);
+    uint8_t count = 0;
+    for (uint32_t t = first; t <= localHigh_ && count < 255; ++t) {
+        auto it = mine.find(t);
+        if (it == mine.end()) break;
+        b.insert(b.end(), it->second.begin(), it->second.end());
+        ++count;
+    }
+    b[countAt] = count;
+    t_.sendUnreliable(peer, b.data(), b.size());
+    lastSendMs_ = nowMs();
+}
+
+void Lockstep::submitLocal(uint32_t tick, const game::RemoteCommand& c) {
+    cmds_[(size_t)cfg_.self][tick] = encodeCommand(c);
+    localHigh_ = std::max(localHigh_, tick);
+    uint32_t& h = contiguous_[(size_t)cfg_.self];
+    while (cmds_[(size_t)cfg_.self].count(h + 1)) ++h;
+    for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) sendCommands(s);
+}
+
+bool Lockstep::haveAll(uint32_t tick) const {
+    for (const auto& m : cmds_) if (!m.count(tick)) return false;
+    return true;
+}
+
+void Lockstep::command(int seat, uint32_t tick, game::RemoteCommand& out) const {
+    const auto& m = cmds_[(size_t)seat];
+    auto it = m.find(tick);
+    if (it == m.end()) { out = game::RemoteCommand{}; out.tick = tick; return; }
+    decodeCommand(it->second, tick, out);
+}
+
+uint64_t Lockstep::bundleHash(uint32_t tick) const {
+    uint64_t h = 1469598103934665603ULL;
+    for (const auto& m : cmds_) {
+        auto it = m.find(tick);
+        if (it == m.end()) continue;
+        for (uint8_t b : it->second) { h ^= b; h *= 1099511628211ULL; }
+    }
+    return h;
+}
+
+void Lockstep::reportHash(uint32_t tick, uint64_t h) {
+    if (cfg_.hashEvery <= 0 || tick % (uint32_t)cfg_.hashEvery != 0) return;
+    ownHash_[tick] = h;
+    std::vector<uint8_t> b; put8(b, kHash); put8(b, (uint8_t)cfg_.self); put32(b, tick); put64(b, h);
+    for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) t_.sendReliable(s, b.data(), b.size());
+    auto it = peerHash_.find(tick);
+    if (it != peerHash_.end()) {
+        for (const auto& ph : it->second)
+            if (ph.second != h) {
+                char buf[160];
+                std::snprintf(buf, sizeof buf, "DESYNC at tick %u: seat %d %016llx, ours (seat %d) %016llx", tick, ph.first,
+                              (unsigned long long)ph.second, cfg_.self, (unsigned long long)h);
+                fail(Status::Desync, buf);
+            }
+        peerHash_.erase(it);
+    }
+    while (ownHash_.size() > 512) ownHash_.erase(ownHash_.begin());
+}
+
+void Lockstep::stalled(double ms) {
+    stallMs_ += ms; stallTotalMs_ += ms;
+    if (stallMs_ >= cfg_.peerTimeoutS * 1000.0) {
+        std::string missing;
+        for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) missing += " " + std::to_string(s) + "@" + std::to_string(contiguous_[(size_t)s]);
+        fail(Status::PeerTimeout, "peer timeout: no commands for " + std::to_string((int)(stallMs_ / 1000.0)) + " s (seat@tick:" + missing + ")");
+    }
+}
+
+void Lockstep::stepped(uint32_t tick, uint64_t stateHash) {
+    if (log_) {
+        const NetStats st = t_.stats();
+        std::fprintf(log_, "%u,%016llx,%016llx,%.2f,%llu,%llu,%.1f\n", tick, (unsigned long long)stateHash, (unsigned long long)bundleHash(tick),
+                     stallMs_, (unsigned long long)st.bytesReceived, (unsigned long long)st.bytesSent, st.rttMs);
+    }
+    stallMs_ = 0.0;
+}
+
+void Lockstep::forget(uint32_t belowTick) {
+    for (auto& m : cmds_) while (!m.empty() && m.begin()->first < belowTick) m.erase(m.begin());
+}
+
+void Lockstep::bye() {
+    std::vector<uint8_t> b; put8(b, kBye); put8(b, (uint8_t)cfg_.self);
+    for (int s = 0; s < cfg_.seats; ++s) if (s != cfg_.self) t_.sendReliable(s, b.data(), b.size());
+    for (int i = 0; i < 20; ++i) t_.service();   // flush best-effort (the peers' acks may not come back before exit)
+    const NetStats st = t_.stats();
+    LOG_INFO("NET bye: sent %llu B / %llu pkts, received %llu B / %llu pkts, resends %llu, rtt %.1f ms, stalled %.0f ms total",
+             (unsigned long long)st.bytesSent, (unsigned long long)st.packetsSent, (unsigned long long)st.bytesReceived,
+             (unsigned long long)st.packetsReceived, (unsigned long long)st.resends, st.rttMs, stallTotalMs_);
+}
+
+}  // namespace net
diff -ruN a/src/net/Lockstep.h b/src/net/Lockstep.h
--- a/src/net/Lockstep.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/Lockstep.h	2026-10-17 12:43:16.928219000 -0500
@@ -0,0 +1,81 @@
+#pragma once
+// [Systems] Lockstep layer (ONLINE_MP_ARCHITECTURE.md sections 4, 5, 10.2): every peer simulates every human seat from the same command
+// stream. A seat's command for tick N is produced at N - D (input delay D) and sent to every other peer; tick N steps on a peer only once
+// every seat's command for N is in (a missing one stalls the step, never a hole). Commands travel as the 23-byte wire form of
+// game::RemoteCommand and every peer, the sender too, simulates the DECODED form - one code path per peer, deterministic by construction.
+// Packets (the transport payload, little endian):
+//   1 CMDS  (unreliable) u8 type, u8 seat, u32 ack (the highest tick of YOUR seat I hold contiguously), u32 first, u8 count, count x 23
+//   2 HELLO (reliable)   u8 type, u8 seat, u64 launch hash (the launch record + sim build: a mismatch refuses the match)
+//   3 HASH  (reliable)   u8 type, u8 seat, u32 tick, u64 simStateHash (desync detector, every hashEvery ticks)
+//   4 BYE   (reliable)   u8 type, u8 seat
+// Wire command (23 bytes): i8 forward, i8 right, u32 buttons, u32 pressed, u16 yaw, i16 pitch (rotator units, 65536 = 360 deg),
+//   i24 x / y / z aim point (cm; valid with kRemoteBitAimPoint).
+#include "net/NetTransport.h"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace game { struct RemoteCommand; }
+
+namespace net {
+
+constexpr size_t kWireCommandBytes = 23;
+using WireCommand = std::array<uint8_t, kWireCommandBytes>;
+WireCommand encodeCommand(const game::RemoteCommand& c);
+void decodeCommand(const WireCommand& w, uint32_t tick, game::RemoteCommand& out);
+
+class Lockstep {
+public:
+    struct Config {
+        int seats = 2;              // humans (seat 0 = host)
+        int self = 0;
+        int delay = 4;              // D (ticks)
+        int maxResend = 32;         // ticks of commands per CMDS packet at most (from the peer's ack)
+        int hashEvery = 60;         // desync-detector period (ticks)
+        double peerTimeoutS = 10.0; // a stall this long = the peer is lost
+        uint64_t launchHash = 0;
+        std::string logPath;        // per-tick CSV (WFC_NET_LOG)
+    };
+    enum class Status { Running = 0, Desync = 3, PeerTimeout = 4, HostLost = 5, LaunchMismatch = 6 };
+
+    Lockstep(INetTransport& t, const Config& c);
+    ~Lockstep();
+    void pump();                                  // transport service + receive; periodic command resend; call every loop iteration
+    bool everyoneHere() const;                    // every peer's HELLO arrived (and matched)
+    void submitLocal(uint32_t tick, const game::RemoteCommand& c);   // this seat's command for `tick` (encoded, stored, sent)
+    bool haveAll(uint32_t tick) const;
+    void command(int seat, uint32_t tick, game::RemoteCommand& out) const;   // decoded (also for this seat)
+    uint64_t bundleHash(uint32_t tick) const;     // FNV over every seat's wire bytes for `tick` (transport / merge check)
+    void reportHash(uint32_t tick, uint64_t h);   // own state hash (sent every hashEvery ticks, compared with the peers')
+    void stalled(double ms);                      // the loop could not step this long (timeout + log accounting)
+    void stepped(uint32_t tick, uint64_t stateHash);   // log row
+    void forget(uint32_t belowTick);              // drop stored commands older than this
+    void bye();
+    Status status() const { return status_; }
+    const std::string& statusText() const { return statusText_; }
+    uint32_t localHigh() const { return localHigh_; }
+
+private:
+    void handle(const NetPacket& p);
+    void sendCommands(int peer);
+    void fail(Status s, const std::string& why);
+    INetTransport& t_;
+    Config cfg_;
+    std::vector<std::map<uint32_t, WireCommand>> cmds_;   // per seat
+    std::vector<uint32_t> contiguous_;                    // per seat: highest tick held with no gap from 1
+    std::vector<uint32_t> peerAck_;                       // per peer: their ack of MY commands
+    std::vector<char> hello_;
+    std::map<uint32_t, uint64_t> ownHash_;
+    std::map<uint32_t, std::vector<std::pair<int, uint64_t>>> peerHash_;
+    uint32_t localHigh_ = 0;
+    double lastSendMs_ = 0.0, stallMs_ = 0.0, stallTotalMs_ = 0.0;
+    Status status_ = Status::Running;
+    std::string statusText_;
+    FILE* log_ = nullptr;
+};
+
+}  // namespace net
diff -ruN a/src/net/NetTransport.h b/src/net/NetTransport.h
--- a/src/net/NetTransport.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/NetTransport.h	2026-10-17 12:43:16.929724800 -0500
@@ -0,0 +1,44 @@
+#pragma once
+// [Systems] Online transport (ONLINE_MP_ARCHITECTURE.md section 3, NETCODE_HARNESS.md section 2): one INetTransport per peer process,
+// two channels - unreliable unordered datagrams (the lockstep commands: one packet per tick carrying the last R ticks) and a reliable
+// ordered channel (control: hello / start / hashes / bye). Peers are addressed by seat index (0..N-1); the sender's seat travels in
+// every packet, so a relay in between (netshim, a relay server) never has to keep source addresses.
+// Implementations: UdpTransport (LAN / direct IP / the netshim harness), LoopbackTransport (two peers in one process, unit tests).
+// A WebRTC transport (browser peers) implements the same interface later.
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace net {
+
+struct NetPacket {
+    int from = -1;                 // sender seat
+    bool reliable = false;
+    std::vector<uint8_t> data;
+};
+
+struct NetStats {
+    uint64_t bytesSent = 0, bytesReceived = 0, packetsSent = 0, packetsReceived = 0, resends = 0;
+    float rttMs = 0.0f;            // smoothed reliable-channel round trip (0 = unknown)
+};
+
+class INetTransport {
+public:
+    virtual ~INetTransport() = default;
+    virtual int self() const = 0;                                       // this process's seat
+    virtual void sendUnreliable(int peer, const uint8_t* p, size_t n) = 0;
+    virtual void sendReliable(int peer, const uint8_t* p, size_t n) = 0;
+    virtual bool poll(NetPacket& out) = 0;                              // non-blocking; drain until false
+    virtual void service() = 0;                                         // resends / acks; call often (each loop iteration)
+    virtual NetStats stats() const = 0;
+};
+
+// UDP over one socket. bind = "host:port"; peers = seat -> "host:port" (where this process sends that seat's packets).
+std::unique_ptr<INetTransport> createUdpTransport(int self, const std::string& bind, const std::vector<std::pair<int, std::string>>& peers,
+                                                  std::string& error);
+// Two (or more) in-process peers sharing queues: createLoopbackGroup(n) -> n transports, seat i = element i.
+std::vector<std::unique_ptr<INetTransport>> createLoopbackGroup(int n);
+
+}  // namespace net
diff -ruN a/src/net/UdpTransport.cpp b/src/net/UdpTransport.cpp
--- a/src/net/UdpTransport.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/UdpTransport.cpp	2026-10-17 12:43:16.931229600 -0500
@@ -0,0 +1,275 @@
+// [Systems] UdpTransport + LoopbackTransport (NetTransport.h). Datagram framing (little endian):
+//   u8 kind (0 unreliable, 1 reliable data, 2 ack), u8 from (seat), u16 reserved, u32 seq (reliable / ack; 0 for unreliable), payload.
+// Reliable channel: per peer a send sequence, the unacked packets resent every max(2 x RTT, 40 ms) (cap 250 ms) until acked; the
+// receiver acks every reliable packet (also duplicates: the first ack may have been lost), delivers in sequence order and buffers
+// out-of-order ones. Unreliable packets are delivered as they come (the lockstep layer tolerates loss, reorder and duplicates).
+#include "net/NetTransport.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+namespace net {
+namespace {
+
+double nowMs() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+constexpr size_t kHeader = 8;
+enum : uint8_t { kUnreliable = 0, kReliable = 1, kAck = 2 };
+
+void putHeader(std::vector<uint8_t>& b, uint8_t kind, int from, uint32_t seq) {
+    b.resize(kHeader);
+    b[0] = kind; b[1] = (uint8_t)from; b[2] = 0; b[3] = 0;
+    b[4] = (uint8_t)seq; b[5] = (uint8_t)(seq >> 8); b[6] = (uint8_t)(seq >> 16); b[7] = (uint8_t)(seq >> 24);
+}
+
+// The reliable-channel state machine, shared by both transports (the loopback one runs it too, so reorder / loss tests can use it).
+struct PeerChannel {
+    uint32_t nextSend = 1;                       // next outgoing reliable seq
+    struct Pending { std::vector<uint8_t> datagram; double lastSent = 0.0, firstSent = 0.0; };
+    std::map<uint32_t, Pending> unacked;
+    uint32_t nextDeliver = 1;                    // next in-order reliable seq to hand up
+    std::map<uint32_t, std::vector<uint8_t>> early;   // received ahead of nextDeliver
+};
+
+class ChannelSet {
+public:
+    explicit ChannelSet(int self) : self_(self) {}
+    // Wraps a payload; returns the datagram to send.
+    std::vector<uint8_t> wrap(int peer, bool reliable, const uint8_t* p, size_t n) {
+        std::vector<uint8_t> d;
+        uint32_t seq = 0;
+        if (reliable) seq = ch_[peer].nextSend++;
+        putHeader(d, reliable ? kReliable : kUnreliable, self_, seq);
+        d.insert(d.end(), p, p + n);
+        if (reliable) { auto& u = ch_[peer].unacked[seq]; u.datagram = d; u.lastSent = u.firstSent = nowMs(); }
+        return d;
+    }
+    // Handles one received datagram: queues deliverable packets; may produce an ack to send back (ackOut non-empty).
+    void receive(const uint8_t* d, size_t n, std::deque<NetPacket>& inbox, std::vector<uint8_t>& ackOut, int& ackTo) {
+        ackOut.clear(); ackTo = -1;
+        if (n < kHeader) return;
+        const uint8_t kind = d[0];
+        const int from = d[1];
+        const uint32_t seq = (uint32_t)d[4] | ((uint32_t)d[5] << 8) | ((uint32_t)d[6] << 16) | ((uint32_t)d[7] << 24);
+        if (kind == kUnreliable) {
+            NetPacket p; p.from = from; p.reliable = false; p.data.assign(d + kHeader, d + n);
+            inbox.push_back(std::move(p));
+        } else if (kind == kReliable) {
+            putHeader(ackOut, kAck, self_, seq); ackTo = from;
+            PeerChannel& c = ch_[from];
+            if (seq >= c.nextDeliver && !c.early.count(seq)) c.early[seq].assign(d + kHeader, d + n);
+            while (!c.early.empty() && c.early.begin()->first == c.nextDeliver) {
+                NetPacket p; p.from = from; p.reliable = true; p.data = std::move(c.early.begin()->second);
+                inbox.push_back(std::move(p));
+                c.early.erase(c.early.begin());
+                ++c.nextDeliver;
+            }
+        } else if (kind == kAck) {
+            PeerChannel& c = ch_[from];
+            auto it = c.unacked.find(seq);
+            if (it != c.unacked.end()) {
+                if (it->second.lastSent == it->second.firstSent) {   // only first transmissions time the RTT (Karn)
+                    const float s = (float)(nowMs() - it->second.firstSent);
+                    rttMs_ = rttMs_ <= 0.0f ? s : rttMs_ * 0.875f + s * 0.125f;
+                }
+                c.unacked.erase(it);
+            }
+        }
+    }
+    // Datagrams due for resend now: (peer, bytes).
+    template <class F> void resendDue(F&& send) {
+        const double t = nowMs();
+        const double rto = std::min(250.0, std::max(40.0, 2.0 * (double)rttMs_));
+        for (auto& kv : ch_)
+            for (auto& u : kv.second.unacked)
+                if (t - u.second.lastSent >= rto) { u.second.lastSent = t; ++resends_; send(kv.first, u.second.datagram); }
+    }
+    float rttMs() const { return rttMs_; }
+    uint64_t resends() const { return resends_; }
+
+private:
+    int self_;
+    std::map<int, PeerChannel> ch_;
+    float rttMs_ = 0.0f;
+    uint64_t resends_ = 0;
+};
+
+#ifdef _WIN32
+using Socket = SOCKET;
+const Socket kBad = INVALID_SOCKET;
+void closeSock(Socket s) { closesocket(s); }
+#else
+using Socket = int;
+const Socket kBad = -1;
+void closeSock(Socket s) { close(s); }
+#endif
+
+bool parseAddr(const std::string& hp, sockaddr_in& out) {
+    const size_t c = hp.rfind(':');
+    if (c == std::string::npos) return false;
+    std::memset(&out, 0, sizeof out);
+    out.sin_family = AF_INET;
+    out.sin_port = htons((uint16_t)std::atoi(hp.c_str() + c + 1));
+    return inet_pton(AF_INET, hp.substr(0, c).c_str(), &out.sin_addr) == 1;
+}
+
+class UdpTransport final : public INetTransport {
+public:
+    UdpTransport(int self, Socket s, std::map<int, sockaddr_in> peers) : self_(self), sock_(s), peers_(std::move(peers)), ch_(self) {}
+    ~UdpTransport() override { if (sock_ != kBad) closeSock(sock_); }
+    int self() const override { return self_; }
+    void sendUnreliable(int peer, const uint8_t* p, size_t n) override { raw(peer, ch_.wrap(peer, false, p, n)); }
+    void sendReliable(int peer, const uint8_t* p, size_t n) override { raw(peer, ch_.wrap(peer, true, p, n)); }
+    bool poll(NetPacket& out) override {
+        drainSocket();
+        if (inbox_.empty()) return false;
+        out = std::move(inbox_.front());
+        inbox_.pop_front();
+        return true;
+    }
+    void service() override {
+        drainSocket();
+        ch_.resendDue([this](int peer, const std::vector<uint8_t>& d) { raw(peer, d); });
+    }
+    NetStats stats() const override { NetStats s = stats_; s.rttMs = ch_.rttMs(); s.resends = ch_.resends(); return s; }
+
+private:
+    void raw(int peer, const std::vector<uint8_t>& d) {
+        auto it = peers_.find(peer);
+        if (it == peers_.end()) return;
+        sendto(sock_, (const char*)d.data(), (int)d.size(), 0, (const sockaddr*)&it->second, sizeof it->second);
+        stats_.bytesSent += d.size(); ++stats_.packetsSent;
+    }
+    void drainSocket() {
+        uint8_t buf[2048];
+        for (;;) {
+            sockaddr_in from{};
+#ifdef _WIN32
+            int fl = sizeof from;
+#else
+            socklen_t fl = sizeof from;
+#endif
+            const int n = (int)recvfrom(sock_, (char*)buf, sizeof buf, 0, (sockaddr*)&from, &fl);
+            if (n <= 0) break;
+            stats_.bytesReceived += (uint64_t)n; ++stats_.packetsReceived;
+            std::vector<uint8_t> ack; int ackTo = -1;
+            ch_.receive(buf, (size_t)n, inbox_, ack, ackTo);
+            if (!ack.empty()) raw(ackTo, ack);
+        }
+    }
+    int self_;
+    Socket sock_;
+    std::map<int, sockaddr_in> peers_;
+    ChannelSet ch_;
+    std::deque<NetPacket> inbox_;
+    NetStats stats_;
+};
+
+// In-process group: datagrams go straight into the destination's queue (no loss); the reliable framing still runs.
+struct LoopbackHub;
+class LoopbackTransport final : public INetTransport {
+public:
+    LoopbackTransport(int self, std::shared_ptr<LoopbackHub> hub) : self_(self), hub_(std::move(hub)), ch_(self) {}
+    int self() const override { return self_; }
+    void sendUnreliable(int peer, const uint8_t* p, size_t n) override { deliver(peer, ch_.wrap(peer, false, p, n)); }
+    void sendReliable(int peer, const uint8_t* p, size_t n) override { deliver(peer, ch_.wrap(peer, true, p, n)); }
+    bool poll(NetPacket& out) override;
+    void service() override;
+    NetStats stats() const override { NetStats s = stats_; s.rttMs = ch_.rttMs(); s.resends = ch_.resends(); return s; }
+    void deliver(int peer, const std::vector<uint8_t>& d);
+    std::deque<std::vector<uint8_t>> wire;   // datagrams addressed to this transport
+
+private:
+    int self_;
+    std::shared_ptr<LoopbackHub> hub_;
+    ChannelSet ch_;
+    std::deque<NetPacket> inbox_;
+    NetStats stats_;
+};
+struct LoopbackHub { std::vector<LoopbackTransport*> members; };
+
+void LoopbackTransport::deliver(int peer, const std::vector<uint8_t>& d) {
+    if (peer < 0 || peer >= (int)hub_->members.size() || !hub_->members[(size_t)peer]) return;
+    hub_->members[(size_t)peer]->wire.push_back(d);
+    stats_.bytesSent += d.size(); ++stats_.packetsSent;
+}
+bool LoopbackTransport::poll(NetPacket& out) {
+    service();
+    if (inbox_.empty()) return false;
+    out = std::move(inbox_.front());
+    inbox_.pop_front();
+    return true;
+}
+void LoopbackTransport::service() {
+    while (!wire.empty()) {
+        std::vector<uint8_t> d = std::move(wire.front());
+        wire.pop_front();
+        stats_.bytesReceived += d.size(); ++stats_.packetsReceived;
+        std::vector<uint8_t> ack; int ackTo = -1;
+        ch_.receive(d.data(), d.size(), inbox_, ack, ackTo);
+        if (!ack.empty()) deliver(ackTo, ack);
+    }
+    ch_.resendDue([this](int peer, const std::vector<uint8_t>& d) { deliver(peer, d); });
+}
+
+}  // namespace
+
+std::unique_ptr<INetTransport> createUdpTransport(int self, const std::string& bind, const std::vector<std::pair<int, std::string>>& peers,
+                                                  std::string& error) {
+#ifdef _WIN32
+    static bool wsa = [] { WSADATA w; return WSAStartup(MAKEWORD(2, 2), &w) == 0; }();
+    if (!wsa) { error = "WSAStartup failed"; return nullptr; }
+#endif
+    sockaddr_in local{};
+    if (!parseAddr(bind, local)) { error = "bad bind address " + bind; return nullptr; }
+    std::map<int, sockaddr_in> to;
+    for (const auto& pr : peers) {
+        sockaddr_in a{};
+        if (!parseAddr(pr.second, a)) { error = "bad peer address " + pr.second; return nullptr; }
+        to[pr.first] = a;
+    }
+    Socket s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kBad) { error = "socket() failed"; return nullptr; }
+    if (::bind(s, (const sockaddr*)&local, sizeof local) != 0) { closeSock(s); error = "bind " + bind + " failed"; return nullptr; }
+#ifdef _WIN32
+    u_long nb = 1; ioctlsocket(s, FIONBIO, &nb);
+    int rcv = 1 << 20; setsockopt(s, SOL_SOCKET, SO_RCVBUF, (const char*)&rcv, sizeof rcv);
+#else
+    fcntl(s, F_SETFL, fcntl(s, F_GETFL, 0) | O_NONBLOCK);
+#endif
+    return std::make_unique<UdpTransport>(self, s, std::move(to));
+}
+
+std::vector<std::unique_ptr<INetTransport>> createLoopbackGroup(int n) {
+    auto hub = std::make_shared<LoopbackHub>();
+    std::vector<std::unique_ptr<INetTransport>> out;
+    hub->members.resize((size_t)n, nullptr);
+    for (int i = 0; i < n; ++i) {
+        auto t = std::make_unique<LoopbackTransport>(i, hub);
+        hub->members[(size_t)i] = t.get();
+        out.push_back(std::move(t));
+    }
+    return out;
+}
+
+}  // namespace net
