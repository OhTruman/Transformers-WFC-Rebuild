+// Escalation HUD values (Gameplay E1, names agreed 2026-10-23: HudGameState svWave / svNextWaveTime / svGameOver; svPower
+// declared for E2), detected until they land; MP_ESCALATION_RE 8.1. static_assert once on integration (trait-glue rule).
+template <class H, class = void> struct HasSurvivalHud : std::false_type {};
+template <class H>
+struct HasSurvivalHud<H, std::void_t<decltype(std::declval<H&>().svWave), decltype(std::declval<H&>().svNextWaveTime),
+                                     decltype(std::declval<H&>().svGameOver)>> : std::true_type {};
+template <class H, class = void> struct HasSurvivalPower : std::false_type {};
+template <class H> struct HasSurvivalPower<H, std::void_t<decltype(std::declval<H&>().svPower)>> : std::true_type {};
+template <class H> void fillSurvival(const H& h, frontend::MatchValues& v) {
+    if constexpr (HasSurvivalHud<H>::value) {
+        v.svWave = h.svWave;
+        v.svNextWaveTime = h.svNextWaveTime;
+        v.svGameOver = h.svGameOver;
+    }
+    if constexpr (HasSurvivalPower<H>::value) {
+        for (frontend::MatchValues::Player& p : v.players) if (p.local) p.power = std::clamp(h.svPower, 0, 9999);
+    }
+    (void)h; (void)v;
+}
