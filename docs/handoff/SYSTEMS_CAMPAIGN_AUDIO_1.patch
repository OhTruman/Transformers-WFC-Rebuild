diff -ruN a/src/core/Application_CampaignAudio.cpp b/src/core/Application_CampaignAudio.cpp
--- a/src/core/Application_CampaignAudio.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/core/Application_CampaignAudio.cpp	2026-10-23 02:14:37.204408300 -0500
