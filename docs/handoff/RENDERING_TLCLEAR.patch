+    if (blendOn) glEnable(GL_BLEND);
+    if (cullOn) glEnable(GL_CULL_FACE);
+    UseProgram((GLuint)prevProg);
+    glViewport(prevVp[0], prevVp[1], prevVp[2], prevVp[3]);
+    glx::uniformCacheForgetCurrent();
+}
