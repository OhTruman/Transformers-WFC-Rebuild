+        serializeRs_ = d3d ? (PFN_D3D12_SERIALIZE_ROOT_SIGNATURE)(void*)GetProcAddress(d3d, "D3D12SerializeRootSignature") : nullptr;
+#else
+        d3d12SelectAgility();
