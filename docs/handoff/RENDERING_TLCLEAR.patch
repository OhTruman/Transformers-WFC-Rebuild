+            glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_FLOAT, rg.data());
+            if (FILE* f = std::fopen("rt_dump_shadowao.bin", "wb")) { std::fwrite(rg.data(), 4, rg.size(), f); std::fclose(f); }
