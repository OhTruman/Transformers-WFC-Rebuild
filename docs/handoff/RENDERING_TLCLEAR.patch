+            }
+        }
+        glBindTexture(GL_TEXTURE_2D, 0);
+        std::string m;
+        for (int i = 0; i < 16; ++i) m += " " + std::to_string(viewProj_.m[i]);
+        for (int i = 0; i < 16; ++i) m += " " + std::to_string(camView_.m[i]);
