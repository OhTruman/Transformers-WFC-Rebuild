+        GLuint cf = vs ? compileShader(GL_FRAGMENT_SHADER, kRtCompositeR1FS, "rt_composite_r1.fs") : 0;
+        rtCompositeR1Prog_ = cf ? linkProgram(vs, cf, "rt_composite_r1") : 0;
+        for (GLuint sh : {vs, cf}) if (sh) DeleteShader(sh);
