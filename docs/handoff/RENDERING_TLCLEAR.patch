+                ++n;
+            }
+            fr.shadowLightN = n;
+            for (int k = 0; k < tlN_ && k < 4; ++k) { std::memcpy(fr.transLights[k], tlPos_[k], 16); fr.transLights[k][3] = 1.0f / std::max(tlPos_[k][3], 1e-6f); }
