+        for (GLuint t : vbTex_) pages += t ? 1 : 0;
+        LOG_INFO("RT R1 (first Realistic frame): %s (V_bake pages %zu, arrays %zu)", r1 ? "sun swap ON" :
+                 "sun swap OFF (no usable V_bake fit / GL entry points / WFC_RT_R1=0)",
