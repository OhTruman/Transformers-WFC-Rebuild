+                glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_FLOAT, rf.data());
+                if (FILE* f = std::fopen("rt_dump_refl.bin", "wb")) { std::fwrite(rf.data(), 4, rf.size(), f); std::fclose(f); }
