+            if (table == 3) {                            // D: u0 the soft output, u1 the denoised visibility, u2 the normals
+                uav(soft_.res, DXGI_FORMAT_R8_UNORM); uav(dnOut_.res, DXGI_FORMAT_R8_UNORM);
