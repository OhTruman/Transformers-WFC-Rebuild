+void GfxRendererGL::verifyImage() {
+    recording_ = false;
+    const size_t n = (size_t)w_ * (size_t)h_ * 4;
+    auto readBack = [&](std::vector<unsigned char>& out) {   // resolve the movie target and read it (MSAA targets cannot be read)
+        glDisable(GL_STENCIL_TEST);
+        glx::BindFramebuffer(GL_READ_FRAMEBUFFER, msFbo_);
+        glx::BindFramebuffer(GL_DRAW_FRAMEBUFFER, resFbo_);
+        glx::BlitFramebuffer(0, 0, w_, h_, 0, 0, w_, h_, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glx::BindFramebuffer(GL_READ_FRAMEBUFFER, resFbo_);
+        out.resize(n);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(0, 0, w_, h_, GL_RGBA, GL_UNSIGNED_BYTE, out.data());
+    };
+    readBack(verifyB_);
+    if (shSnap_) shadowTargetsCopy(false);
+    refMode_ = true;
+    invalidateGlShadow();
+    inMask_ = false;
+    beginTarget(w_, h_);
+    for (const Recorded& r : recorded_) draw(r.items, r.alpha);
+    refMode_ = false;
+    readBack(verifyA_);
+    invalidateGlShadow();
+    size_t diff = 0, first = n;
+    for (size_t i = 0; i < n; ++i) if (verifyA_[i] != verifyB_[i]) { if (!diff) first = i; ++diff; }
+    ++gImgFrames;
+    if (diff) {
+        ++gImgBad;
+        if (gImgBad <= 20) LOG_ERROR("GFXVERIFY image mismatch (HUD frame %u): %zu of %zu bytes differ, first at pixel (%zu, %zu)", frame_, diff, n,
+                                    (first / 4) % (size_t)w_, (first / 4) / (size_t)w_);
+    }
+    if (gImgFrames % 100 == 0) LOG_INFO("GFXVERIFY %ld HUD frames compared, %ld mismatched", gImgFrames, gImgBad);
+    recorded_.clear();
+}
