+void GfxRendererGL::shadowTargetsCopy(bool save) {
+    if (!glx::CopyImageSubData || !shTex_[0] || shW_ <= 0 || shH_ <= 0) return;
+    if (save) {
+        if (!shBak_[0] || shBakW_ != shW_ || shBakH_ != shH_) {
+            if (shBak_[0]) glDeleteTextures(2, shBak_);
+            glGenTextures(2, shBak_);
+            for (int k = 0; k < 2; ++k) {
+                glBindTexture(GL_TEXTURE_2D, shBak_[k]);
+                glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, shW_, shH_, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            }
+            shBakW_ = shW_; shBakH_ = shH_;
+        }
+        for (int k = 0; k < 2; ++k)
+            glx::CopyImageSubData(shTex_[k], GL_TEXTURE_2D, 0, 0, 0, 0, shBak_[k], GL_TEXTURE_2D, 0, 0, 0, 0, shW_, shH_, 1);
+        shSnap_ = true;
+    } else if (shBakW_ == shW_ && shBakH_ == shH_) {
+        for (int k = 0; k < 2; ++k)
+            glx::CopyImageSubData(shBak_[k], GL_TEXTURE_2D, 0, 0, 0, 0, shTex_[k], GL_TEXTURE_2D, 0, 0, 0, 0, shW_, shH_, 1);
+    }
+}
