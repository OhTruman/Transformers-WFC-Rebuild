--- /dev/null
+++ b/src/render/d3d12/D3D12Dlss.h
@@ -0,0 +1,23 @@
+// Clean-room reconstruction — optional NVIDIA DLSS super resolution over D3D12 via Streamline (PC ADAPTATION, M5 D; OFF by
+// default; Systems). The same interface and inputs as the FSR 3.1 upscaler (D3D12Upscaler.h): the renderer copies its
+// render-size HDR colour, depth (R32F) and motion vectors into the shared targets, calls dlssDispatch, then samples the
+// display-size output. Only on NVIDIA RTX GPUs with the Streamline / DLSS DLLs beside the exe (dlssAvailable()).
+#pragma once
+#include "render/d3d12/D3D12Upscaler.h"
+
+namespace render {
+
+// The Upscaling row's DLSS modes: 0 Quality, 1 Balanced, 2 Performance, 3 Ultra Performance, 4 DLAA (native).
+constexpr int kDlssModes = 5;
+float dlssRenderScale(int mode);                 // NVIDIA's per-axis ratios: 0.667, 0.58, 0.5, 0.333, 1.0
+const char* dlssModeName(int mode);
+
+// (Re)creates the shared targets / DLSS resources on first use or a size / mode change. False: DLSS unavailable (the caller
+// keeps its other path). t: the same roles as FSR 3.1's (reactive is created for the shared copy code but not read by DLSS).
+bool dlssPrepare(int mode, int inW, int inH, int outW, int outH, Fsr3Targets* t);
+// GL inputs written: GL -> DLSS -> GL (GPU waits on both sides). frameIndex: the renderer's frame counter (the Streamline
+// frame token). p.sharpness is ignored (DLSS 3.7+ has no sharpening). False: the evaluation failed this frame.
+bool dlssDispatch(const Fsr3Params& p, unsigned frameIndex);
+bool dlssDeviceLost();                           // Streamline's D3D12 device was removed (DLSS cannot recover in-process)
+
+}  // namespace render
diff --git a/src/render/d3d12/D3D12Dlss.cpp b/src/render/d3d12/D3D12Dlss.cpp
