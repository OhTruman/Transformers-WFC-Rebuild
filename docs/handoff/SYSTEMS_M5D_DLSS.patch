--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -60,6 +60,17 @@ if(WIN32 AND EXISTS "${CMAKE_SOURCE_DIR}/third_party/ffx_sdk/api/include/ffx_api
         "${CMAKE_SOURCE_DIR}/third_party/ffx_sdk/bin/amd_fidelityfx_framegeneration_dx12.dll"
         "${CMAKE_SOURCE_DIR}/third_party/ffx_sdk/license.md" $<TARGET_FILE_DIR:wfc_rebuild>)
 endif()
+# Optional NVIDIA DLSS via Streamline (M5 D, src/render/d3d12/D3D12Streamline.cpp / D3D12Dlss.cpp): the SDK headers + the
+# signed production DLLs fetched by tools/render/fetch_streamline.py into third_party/streamline (not committed: NVIDIA's
+# licences); without them DLSS builds as an unavailable stub. The DLLs are only loaded on NVIDIA GPUs.
+if(WIN32 AND EXISTS "${CMAKE_SOURCE_DIR}/third_party/streamline/include/sl.h")
+    target_include_directories(wfc_rebuild PRIVATE "${CMAKE_SOURCE_DIR}/third_party/streamline/include")
+    target_compile_definitions(wfc_rebuild PRIVATE WFC_STREAMLINE_SDK=1)
+    target_link_libraries(wfc_rebuild PRIVATE wintrust crypt32)   # (sl_security.h: the interposer's NVIDIA signature check)
+    file(GLOB WFC_SL_DLLS "${CMAKE_SOURCE_DIR}/third_party/streamline/bin/*.dll")
+    add_custom_command(TARGET wfc_rebuild POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different ${WFC_SL_DLLS}
+        $<TARGET_FILE_DIR:wfc_rebuild>)
+endif()
 # D3D12 Agility SDK runtime (tools/render/fetch_d3d12_agility.py, not committed): FSR 3.1 needs shader model 6.6;
 # the exe exports D3D12SDKVersion / D3D12SDKPath (src/render/d3d12/D3D12Agility.cpp) and D3D12Core.dll goes to bin/D3D12
 if(WIN32 AND EXISTS "${CMAKE_SOURCE_DIR}/third_party/d3d12_agility/bin/D3D12Core.dll")
