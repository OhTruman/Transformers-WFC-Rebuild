+// WFC_ONLINEFLOWTEST [Frontend] (no window, no device, loopback only: 127.0.0.1 binds, no firewall prompt, no UPnP / STUN): two
+// FrontendRuntimes in this process, each with a real net::UdpSession - the GameFlow paths the menus drive, end to end over UDP.
+// Host: Private Match (Online.HostPrivateNow) -> the hosted game lobby with a LAN code; member: Online.JoinGame(code) -> the
+// member's game lobby; both see both members; the host picks the map and starts (Online.BeginLobbyExitCountdown) -> both
+// travel to the same match URL with the same seed and the host's slots; the member quits -> the host sees it leave. One
+// SUMMARY line. Run it from a scratch folder (both flows write wfc_profile.ini there).
+void core::Application::runOnlineFlowTest() {
+    int fails = 0;
+    auto check = [&fails](bool ok, const std::string& what) { LOG_INFO("ONLINEFLOWTEST %s: %s", ok ? "PASS" : "FAIL", what.c_str()); if (!ok) ++fails; };
+    net::UdpSession::Options o;
+    o.bindIp = "127.0.0.1"; o.hostPort = 14140; o.joinTimeoutS = 3.0;
+    o.internet = false;
+    frontend::FrontendRuntime A, B;
+    const bool initA = A.init(), initB = B.init();
+    check(initA && initB, "both frontend runtimes initialise");
+    if (!initA || !initB) { LOG_INFO("ONLINEFLOWTEST SUMMARY: %d failure(s)", fails + 1); return; }
+    for (frontend::FrontendRuntime* r : {&A, &B}) r->flow().profile().onlineFirstRunShown = true;   // the one-time prompt is not under test
+    A.flow().setSession(std::make_unique<net::UdpSession>(o));
+    B.flow().setSession(std::make_unique<net::UdpSession>(o));
+    frontend::GameFlow& a = A.flow();
+    frontend::GameFlow& b = B.flow();
+    auto last = std::chrono::steady_clock::now();
+    auto pump = [&](double forS, const std::function<bool()>& until) {
+        const auto end = std::chrono::steady_clock::now() + std::chrono::duration<double>(forS);
+        platform::InputFrame none;
+        while (std::chrono::steady_clock::now() < end) {
+            const auto t = std::chrono::steady_clock::now();
+            const float dt = std::clamp((float)std::chrono::duration<double>(t - last).count(), 0.001f, 0.05f);
+            last = t;
+            A.update(none, dt);
+            B.update(none, dt);
+            if (until && until()) return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+        return false;
+    };
+    using L = frontend::LevelKind;
+    using Role = frontend::GameFlow::SessionRole;
+    const bool started = pump(20.0, [&] { return a.frontEndStarted() && b.frontEndStarted(); });
+    check(started, "both reach the main menu");
+    a.call("Online.OpenPartyLobby", {"GTS_TeamGame"});
+    b.call("Online.OpenPartyLobby", {"GTS_TeamGame"});
+    check(pump(10.0, [&] { return a.level() == L::PartyLobby && b.level() == L::PartyLobby && !a.loading().active && !b.loading().active; }),
+          "both in the party lobby");
+    a.call("Online.HostPrivateNow", {});
+    const bool hosted = pump(10.0, [&] { return a.level() == L::GameLobby && !a.loading().active && a.sessionRole() == Role::Host && !a.joinCode().empty(); });
+    check(hosted, "host: Private Match -> the hosted game lobby with a join code (" + a.joinCode() + ")");
+    // The LAN code carries the PC's LAN address; the test binds loopback only, so the member types the host's address (the
+    // Join Game prompt takes a code or an address; the code's own round trip is WFC_UDPSESSIONTEST's).
+    b.call("Online.JoinGame", {"127.0.0.1:" + std::to_string(o.hostPort)});
+    const bool joined = pump(10.0, [&] { return b.level() == L::GameLobby && !b.loading().active && b.sessionRole() == Role::Member; });
+    check(joined, "member: Join Game with the host's address -> the member's game lobby");
+    check(pump(5.0, [&] { return a.onlineMembers().size() == 1 && b.onlineMembers().size() == 1; }),   // onlineMembers: the others
+          "each lists the other (host " + std::to_string(a.onlineMembers().size()) + ", member " + std::to_string(b.onlineMembers().size()) + ")");
+    pump(2.5, nullptr);   // the lobby's Select Map selector sends its own first SetSelectedMapID when its list fills
+    a.call("Online.SetSelectedMapID", {"508"});
+    a.call("Online.BeginLobbyExitCountdown", {});
+    // Both start loading the match map (no world loads in this test, so the flows stay on the map's loading screen).
+    auto loadingMap = [](frontend::GameFlow& g) { return g.loading().active && g.loading().kind == "Map" && !g.currentMatch().url.map().empty(); };
+    const bool launched = pump(30.0, [&] { return loadingMap(a) && loadingMap(b); });
+    check(launched, "the host's start takes both flows to the match map's loading screen");
+    if (launched) {
+        const frontend::MatchLaunch& ma = a.currentMatch();
+        const frontend::MatchLaunch& mb = b.currentMatch();
+        check(ma.mapId == 508 && mb.mapId == 508 && ma.modeTag == mb.modeTag, "same map and mode on both (" + ma.modeTag + " " + std::to_string(mb.mapId) + ")");
+        check(ma.seed != 0 && ma.seed == mb.seed, "the host's seed on both (" + std::to_string(ma.seed) + " / " + std::to_string(mb.seed) + ")");
+        check(ma.onlineSlots.size() == mb.onlineSlots.size() && !ma.onlineSlots.empty(), "the host's slots on both (" + std::to_string(mb.onlineSlots.size()) + ")");
+        // The load gate, as the Application drives it: matchLoaded() once the world is in. The host loads first and waits
+        // (its loading screen stays up) until the member has loaded too; then both enter the match.
+        a.matchLoaded();
+        pump(1.0, nullptr);
+        check(a.level() == L::Match && a.loading().active, "load gate: the host waits on its loading screen for the member");
+        b.matchLoaded();
+        check(pump(5.0, [&] { return !a.loading().active && !b.loading().active && b.level() == L::Match; }),
+              "load gate: both released into the match once both have loaded");
+    }
+    b.call("Game.QuitToMainMenu", {});
+    b.popupButton('A');
+    const bool left = pump(10.0, [&] { return b.sessionRole() == Role::Offline && a.onlineMembers().empty(); });
+    check(left, "member quits: offline again, the host lists nobody else");
+    LOG_INFO("ONLINEFLOWTEST SUMMARY: %d failure(s)", fails);
+}
