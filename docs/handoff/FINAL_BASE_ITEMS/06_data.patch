.023,"int":[{"time":0.0,"text":"You'll pay for that, you VERMIN!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004655":{"duration":2.965,"int":[{"time":0.0,"text":"NOTHING can stop me. NOTHING!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004656":{"duration":5.467,"int":[{"time":0.0,"text":"You cannot escape from me! Now DIE!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004658":{"duration":5.0,"int":[{"time":0.0,"text":"ARRRRHHHHH! I'll CRUSH you! I'll crush you ALL!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004660":{"duration":1.062,"int":[{"time":0.0,"text":"Die!","show":true}],"fra":[{"time":0.0,"text":"ROAAR\u00a0!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004662":{"duration":6.339,"int":[{"time":0.0,"text":"You are fools. I cannot be defeated! WITNESS MY TRUE POWER!","show":true}],"fra":[{"time":0.0,"text":"Pauvres idiots\u00a0! Je suis invincible\u00a0! ADMIREZ MA VRAIE PUISSANCE\u00a0!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004668":{"duration":3.085,"int":[{"time":0.0,"text":"You haven't defeated me Autobots!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004735":{"duration":4.286,"int":[{"time":0.0,"text":"Abandon hope, vermin! Your death approaches!","show":true}],"fra":[{"time":0.0,"text":"Abandonnez, minables\u00a0! Votre destruction est proche\u00a0!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK004993":{"duration":3.096,"int":[{"time":0.0,"text":"I'll grind you all to DUST!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK009317":{"duration":4.845,"int":[{"time":0.0,"text":"You are wasting my time! Lie down and DIE!","show":true}]},"WL_DX_TRPTCN.DX_TRPTCN_LK010008":{"duration":1.461,"int":[{"time":0.0,"text":"Laugh","show":false}],"fra":[{"time":0.0,"text":"[Rires]","show":false}]},"WL_DX_TRPTCN.DX_TRPTCN_LK010009":{"duration":6.526,"int":[{"time":0.0,"text":"You will SUFFER for this, Autobots!","show":true}]}}}
