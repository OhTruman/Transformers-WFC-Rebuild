ration":2.154,"int":[{"time":0.0,"text":"Reinforcements inbound! Take cover!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK000889":{"duration":2.896,"int":[{"time":0.0,"text":"You've got the schematics, Ratchet. Lead the way.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK000896":{"duration":1.78,"int":[{"time":0.0,"text":"That's affirmative, Bumblebee.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK000899":{"duration":1.9,"int":[{"time":0.0,"text":"Autobots! Stay close!","show":true}],"fra":[{"time":0.0,"text":"Autobots\u00a0! Restez group\u00e9s\u00a0!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK000901":{"duration":6.247,"int":[{"time":0.0,"text":"You have committed crimes against Iacon, Starscream! It's time to pay for them!","show":true}],"fra":[{"time":0.0,"text":"Tu as trop longtemps trahi Iacon, Starscream\u00a0! L'heure est venue de payer pour tes crimes\u00a0!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK001980":{"duration":1.43,"int":[{"time":0.0,"text":"Shoot its legs out!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002273":{"duration":8.48,"int":[{"time":0.0,"text":"I...cannot believe Zeta Prime is gone. I always knew Megatron was dangerous...but this--?","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002278":{"duration":7.745,"int":[{"time":0.0,"text":"Good job.  The grid is back online.  Let's get to the broadcast room up top so we can re-connect Iacon's defenses.","show":true}],"fra":[{"time":0.0,"text":"Beau travail\u00a0! La grille est op\u00e9rationnelle. Maintenant, on peut r\u00e9activer les d\u00e9fenses de Iacon depuis la salle des transmissions.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002281":{"duration":5.436,"int":[{"time":0.0,"text":"Let's do it...then we can strike back at the Decepticons in full force.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002296":{"duration":0.885,"int":[{"time":0.0,"text":"Roger that.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002303":{"duration":2.405,"int":[{"time":0.0,"text":"Heads up, Autobots! Snipers!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002306":{"duration":3.925,"int":[{"time":0.0,"text":"Take out as many as you can. I need a pathway cleared!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002311":{"duration":4.967,"int":[{"time":0.0,"text":"That's the spirit, Bumblebee.  Autobots -- to the Decagon!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002315":{"duration":2.167,"int":[{"time":0.0,"text":"Ironhide -- what's your status?","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002320":{"duration":3.616,"int":[{"time":0.0,"text":"Get clear, Jetfire. You've done more than enough already.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002321":{"duration":6.874,"int":[{"time":0.0,"text":"Autobots -- exercise caution. Starscream is as dangerous as he is treacherous.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002539":{"duration":7.887,"int":[{"time":0.0,"text":"Not destroyed, Ratchet. Simply taken. He knows we are at our weakest with Zeta Prime gone.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002542":{"duration":2.651,"int":[{"time":0.0,"text":"Focus on the task at hand, Autobots.","show":true}],"fra":[{"time":0.0,"text":"Concentrez-vous sur notre mission, Autobots.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002543":{"duration":1.994,"int":[{"time":0.0,"text":"Zeta Prime is dead.","show":true}],"fra":[{"time":0.0,"text":"Jetfire... Zeta Prime a \u00e9t\u00e9 d\u00e9truit.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002545":{"duration":8.907,"int":[{"time":0.0,"text":"I have assumed temporary command, Jetfire. Let the rest of your flight squadrons know. And don't worry--we'll get those guns on-line.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002548":{"duration":4.103,"int":[{"time":0.0,"text":"Don't let up, Autobots! Keep going--for Zeta Prime!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002550":{"duration":6.821,"int":[{"time":0.0,"text":"The High Council of Elders will choose the next Prime. ...I'm merely a stand-in until that choice is made.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002554":{"duration":5.02,"int":[{"time":0.0,"text":"There -- the controls for the planetary guns! Activate them now!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002556":{"duration":6.552,"int":[{"time":0.0,"text":"This is far from over, Bumblebee.  The skies might be clear, but our ground forces are in disarray.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002560":{"duration":3.919,"int":[{"time":0.0,"text":"I'll do my best. Autobots Roll out.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002570":{"duration":2.982,"int":[{"time":0.0,"text":"Just doing what needs to be done, Ironhide.","show":true}],"fra":[{"time":0.0,"text":"Je fais simplement ce que j'ai \u00e0 faire, Ironhide.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002572":{"duration":2.112,"int":[{"time":0.0,"text":"Old--and cranky..","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002978":{"duration":5.838,"int":[{"time":0.0,"text":"The communication grid is in the Decagon.  If we get there in time--we've got a chance.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002980":{"duration":2.817,"int":[{"time":0.0,"text":"Every second counts.  Let's move!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002988":{"duration":2.329,"int":[{"time":0.0,"text":"There was nothing we could do, Bumblebee.","show":true}],"fra":[{"time":0.0,"text":"Nous ne pouvions rien pour eux, Bumblebee.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK002989":{"duration":3.76,"int":[{"time":0.0,"text":"Not now, Ratchet--Jetfire needs those guns online.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK003904":{"duration":1.248,"int":[{"time":0.0,"text":"Move!\u00a0 Quickly!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK004141":{"duration":3.272,"int":[{"time":0.0,"text":"You have my thanks, old friend. Good hunting!","show":true}],"fra":[{"time":0.0,"text":"Encore merci, mon vieil ami. Et bonne chance\u00a0!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK004147":{"duration":2.88,"int":[{"time":0.0,"text":"Get used to disappointment, Starscream!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK008055":{"duration":1.543,"int":[{"time":0.0,"text":"Thanks, Ironhide!","show":true}],"fra":[{"time":0.0,"text":"Merci, Ironhide\u00a0!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK009720":{"duration":2.426,"int":[{"time":0.0,"text":"A Decepticon war machine!","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK009721":{"duration":5.041,"int":[{"time":0.0,"text":"I've seen these in the archives.  They're used to dispense Dark Energon.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK009723":{"duration":7.252,"int":[{"time":0.0,"text":"Dark Energon is the source of these crystals.  I've read the stories--but to see it for real.","show":true}]},"WL_DX_OPRIME.DX_OPRIME_LK009724":{"duration":4.688,"int":[{"time":0.0,"text":"Megatron has somehow found a way to weaponize Dark Energon.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000306":{"duration":6.492,"int":[{"time":0.0,"text":"It's causing a subatomic displacement on a scale I've never seen before -- it's corrupting Energon at an alarming rate!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000334":{"duration":3.048,"int":[{"time":0.0,"text":"We're going to have ride the turbines to reach the other side!","show":true}],"fra":[{"time":0.0,"text":"Nous allons devoir grimper sur les turbines pour atteindre l'autre c\u00f4t\u00e9\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000338":{"duration":1.635,"int":[{"time":0.0,"text":"Fight to the top of the stairs!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000340":{"duration":5.929,"int":[{"time":0.0,"text":"Optimus, the Communication Grid is located at the top of the Decagon. We need to find a lift up.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000341":{"duration":2.473,"int":[{"time":0.0,"text":"The elevator's wrecked! We'll need to find another way up.","show":true}],"fra":[{"time":0.0,"text":"Hors service\u00a0! Il va falloir qu'on trouve une autre solution.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000344":{"duration":9.417,"int":[{"time":0.0,"text":"There -- that's the main terminal for the communication grid. We can reactivate it by aligning the data streams. ...I think, in theory anyway.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000708":{"duration":1.775,"int":[{"time":0.0,"text":"Death RX 1","show":false}]},"WL_DX_RTCHET.DX_RTCHET_LK000803":{"duration":1.786,"int":[{"time":0.0,"text":"Hostiles incoming! Take cover!","show":true}],"fra":[{"time":0.0,"text":"Ennemis en approche\u00a0! \u00c0 couvert\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000814":{"duration":1.501,"int":[{"time":0.0,"text":"Autobots! Onto the lift!","show":true}],"fra":[{"time":0.0,"text":"Autobots\u00a0! L'ascenseur\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000839":{"duration":1.853,"int":[{"time":0.0,"text":"We have to get out of these tubes NOW!","show":true}],"fra":[{"time":0.0,"text":"Il faut qu'on sorte de l\u00e0 TOUT DE SUITE\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000842":{"duration":1.726,"int":[{"time":0.0,"text":"We've got to get back to the speedway!","show":true}],"fra":[{"time":0.0,"text":"Il faut qu'on retourne sur la voie rapide\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000851":{"duration":2.13,"int":[{"time":0.0,"text":"Aim for the chest! AIM FOR THE CHEST!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000858":{"duration":5.593,"int":[{"time":0.0,"text":"It's working! Taking out the source makes the roots retract! Now Iacon can start repairing itself!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000878":{"duration":6.401,"int":[{"time":0.0,"text":"That they are. All Autobot communications funnel through the Decagon hub.  It's the lifeline for the entire city.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000893":{"duration":2.112,"int":[{"time":0.0,"text":"The service lift is over there! MOVE!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK000894":{"duration":4.035,"int":[{"time":0.0,"text":"According to the schematics, the broadcast control room will be at the top of the lift.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002276":{"duration":1.494,"int":[{"time":0.0,"text":"The Decagon Plaza!","show":true}],"fra":[{"time":0.0,"text":"La grande place du Decagon\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002280":{"duration":5.839,"int":[{"time":0.0,"text":"Hmmm.  We could ride the energon shell capacitors instead.  Might take a little longer--but it should work!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002287":{"duration":4.049,"int":[{"time":0.0,"text":"The automated repair systems are still functional, at least. That's a good sign.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002289":{"duration":5.924,"int":[{"time":0.0,"text":"That's odd...Optimus, I'm picking up a concentration of electro-tetronic anomalies close by.","show":true}],"fra":[{"time":0.0,"text":"\u00c9trange... Optimus, je d\u00e9tecte une forte concentration d'anomalies \u00e9lectro-t\u00e9troniques \u00e0 proximit\u00e9.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002301":{"duration":1.9,"int":[{"time":0.0,"text":"Damage report! Is anyone hurt?","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002538":{"duration":4.354,"int":[{"time":0.0,"text":"Megatron is determined, I'll give him that. He means to see Iacon destroyed!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002541":{"duration":2.509,"int":[{"time":0.0,"text":"We'd prefer no further loss of life, Bumblebee.","show":true}],"fra":[{"time":0.0,"text":"Cette guerre a d\u00e9j\u00e0 fait assez de victimes, Bumblebee...","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002546":{"duration":1.431,"int":[{"time":0.0,"text":"Temporary command?","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002549":{"duration":5.97,"int":[{"time":0.0,"text":"Not bad for a  temporary command,  Optimus. You're better at this than you give yourself credit for.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002568":{"duration":3.365,"int":[{"time":0.0,"text":"Bumblebee...it wouldn't KILL you to exercise caution.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002571":{"duration":1.239,"int":[{"time":0.0,"text":"Old friend of yours?","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002977":{"duration":4.773,"int":[{"time":0.0,"text":"Optimus, if we can get the communication grid back online, we'll be able to coordinate our defenses.","show":true}],"fra":[{"time":0.0,"text":"Optimus, nous devons r\u00e9tablir les communications... C'est le seul moyen de coordonner nos d\u00e9fenses.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002987":{"duration":1.627,"int":[{"time":0.0,"text":"I'm reading a massive surge of--","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002990":{"duration":3.102,"int":[{"time":0.0,"text":"We'll need to activate the planetary guns--here.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK002999":{"duration":3.399,"int":[{"time":0.0,"text":"This will be the fate of all Autobots if we don't hurry.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK003000":{"duration":2.139,"int":[{"time":0.0,"text":"Look out.  That's a Decepticon Warship!","show":true}],"fra":[{"time":0.0,"text":"Attention\u00a0! Un vaisseau de guerre Decepticon\u00a0!","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK004143":{"duration":3.698,"int":[{"time":0.0,"text":"That's not it. The data streams have to align with the sockets.","show":true}]},"WL_DX_RTCHET.DX_RTCHET_LK009725":{"duration":3.059,"int":[{"time":0.0,"text":"Dark Energon?  I thought that was the stuff of legend!","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK002298":{"duration":3.371,"int":[{"time":0.0,"text":"Autobot signatures detected in the eastern access highway.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK002300":{"duration":4.693,"int":[{"time":0.0,"text":"Activate thermal detonation probes. Target: Iacon Highway","show":true}],"fra":[{"time":0.0,"text":"Activation des charges thermiques. Cible\u00a0: voies rapides de Iacon.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK004121":{"duration":3.499,"int":[{"time":0.0,"text":"Alert! Autobots detected! Destroy them!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000900":{"duration":5.363,"int":[{"time":0.0,"text":"Trying to restore your precious Grid, Autobots...? How pathetic.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000902":{"duration":4.871,"int":[{"time":0.0,"text":"Oh, I think not...'Optimus,' is it?  Prepare to die!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004144":{"duration":4.098,"int":[{"time":0.0,"text":"You're no match for the speed and power of STARSCREAM!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004145":{"duration":2.603,"int":[{"time":0.0,"text":"Bwahahahahahaha!","show":true}],"fra":[{"time":0.0,"text":"Mouah ah ah ah\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004146":{"duration":3.626,"int":[{"time":0.0,"text":"A lucky shot!  Now you've made me angry!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004150":{"duration":5.111,"int":[{"time":0.0,"text":"ARRRGH! You'll see me again, Autobots! That's a PROMISE!","show":true}]}}}
