BRTD01_LK004842":{"duration":1.836,"int":[{"time":0.0,"text":"HEY! KNOCK IT OFF!","show":false}],"fra":[{"time":0.0,"text":"H\u00c9\u00a0! \u00c7A SUFFIT, MAINTENANT\u00a0!","show":false}]},"WL_DX_CARA01.DX_CARA01_LK001685":{"duration":1.275,"int":[{"time":0.0,"text":"Pull back! Pull back!","show":false}],"fra":[{"time":0.0,"text":"Repli g\u00e9n\u00e9ral\u00a0! En arri\u00e8re\u00a0!","show":false}]},"WL_DX_CARA01.DX_CARA01_LK008927":{"duration":0.781,"int":[{"time":0.0,"text":"Watch out!","show":true}]},"WL_DX_CARA01.DX_CARA01_LK009901":{"duration":1.557,"int":[{"time":0.0,"text":"Death RX 8","show":false}]},"WL_DX_CARA01.DX_CARA01_LK009902":{"duration":1.547,"int":[{"time":0.0,"text":"Death RX 9","show":false}]},"WL_DX_CARA01.DX_CARA01_LK009911":{"duration":1.468,"int":[{"time":0.0,"text":"Death RX 18","show":false}]},"WL_DX_CARD01.DX_CARD01_LK001771":{"duration":1.274,"int":[{"time":0.0,"text":"What a waste of metal!","show":false}],"fra":[{"time":0.0,"text":"Quel gaspillage d'\u00e9nergon\u00a0!","show":false}]},"WL_DX_CARD01.DX_CARD01_LK001921":{"duration":0.543,"int":[{"time":0.0,"text":"Hit RX 1","show":false}]},"WL_DX_CARD01.DX_CARD01_LK001922":{"duration":0.732,"int":[{"time":0.0,"text":"Hit RX 2","show":false}]},"WL_DX_CARD01.DX_CARD01_LK001924":{"duration":0.323,"int":[{"time":0.0,"text":"Hit RX 4","show":false}]},"WL_DX_CARD01.DX_CARD01_LK003179":{"duration":4.16,"int":[{"time":0.0,"text":"Lord Megatron! The ship's reactor core is failing -- explosion imminent!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK003180":{"duration":1.418,"int":[{"time":0.0,"text":"The core's about to detonate!","show":true}],"fra":[{"time":0.0,"text":"Attention, le r\u00e9acteur va exploser\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008922":{"duration":1.225,"int":[{"time":0.0,"text":"Its falling apart!","show":true}],"fra":[{"time":0.0,"text":"\u00c9loignez-vous, vite\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008924":{"duration":1.125,"int":[{"time":0.0,"text":" Megatron!  This way!","show":true}],"fra":[{"time":0.0,"text":"Megatron\u00a0! Par ici\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008925":{"duration":0.689,"int":[{"time":0.0,"text":"Over here!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008930":{"duration":1.228,"int":[{"time":0.0,"text":"Its Lord Megatron!","show":true}],"fra":[{"time":0.0,"text":"C'est le seigneur Megatron\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008931":{"duration":2.47,"int":[{"time":0.0,"text":"Take out those sentry guns!  They're tearing us apart!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008932":{"duration":1.533,"int":[{"time":0.0,"text":"I HATE those sentry guns!","show":true}],"fra":[{"time":0.0,"text":"Je D\u00c9TESTE ces tourelles\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008947":{"duration":1.789,"int":[{"time":0.0,"text":"Hail, Lord Megatron!","show":true}],"fra":[{"time":0.0,"text":"Gloire \u00e0 Megatron\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008949":{"duration":1.616,"int":[{"time":0.0,"text":"Area is secured, Megatron!","show":true}],"fra":[{"time":0.0,"text":"Le p\u00e9rim\u00e8tre est s\u00e9curis\u00e9, Megatron\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008950":{"duration":2.064,"int":[{"time":0.0,"text":"It's an honor to serve you, Lord Megatron!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK008956":{"duration":1.536,"int":[{"time":0.0,"text":"They're putting up a good fight, alright.","show":true}],"fra":[{"time":0.0,"text":"Ils se d\u00e9fendent bien, pas de doute l\u00e0-dessus.","show":true}]},"WL_DX_CARD01.DX_CARD01_LK009865":{"duration":2.596,"int":[{"time":0.0,"text":"Uggggh--I think I'm going offline!","show":true}],"fra":[{"time":0.0,"text":"Argh... Je crois que je vais d\u00e9connecter\u00a0!","show":true}]},"WL_DX_JETFIR.DX_JETFIR_LK004233":{"duration":3.047,"int":[{"time":0.0,"text":"My name is Jetfire. I'm not here to fight.","show":true}]},"WL_DX_JETFIR.DX_JETFIR_LK004235":{"duration":10.119,"int":[{"time":0.0,"text":"I've seen the horrors of what Dark Energon can do, Megatron -- it is not be trifled with! Its power is too unstable...to use it would mean disaster!","show":true}]},"WL_DX_JETFIR.DX_JETFIR_LK004237":{"duration":4.278,"int":[{"time":0.0,"text":"Then you are a short-sighted fool. You'll kill us all!","show":true}]},"WL_DX_JTSD01.DX_JTSD01_LK000671":{"duration":1.237,"int":[{"time":0.0,"text":"Death RX 4","show":false}]},"WL_DX_JTSD01.DX_JTSD01_LK003205":{"duration":2.683,"int":[{"time":0.0,"text":"The intruders are here! Call in reinforcements!","show":true}]},"WL_DX_JTSD02.DX_JTSD02_LK003207":{"duration":5.176,"int":[{"time":0.0,"text":"There they are! Move ahead and cut them off in Storage Area Beta! Move! Move!","show":true}]},"WL_DX_JTSD02.DX_JTSD02_LK003208":{"duration":3.791,"int":[{"time":0.0,"text":"Starscream!  The ambush is set. They won't make it past us.","show":true}]},"WL_DX_JTSD02.DX_JTSD02_LK003209":{"duration":0.693,"int":[{"time":0.0,"text":"Yes, sir!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003149":{"duration":3.547,"int":[{"time":0.0,"text":"The strong survive. The weak perish.","show":true}],"fra":[{"time":0.0,"text":"Les forts survivent. Les faibles p\u00e9rissent.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003150":{"duration":2.202,"int":[{"time":0.0,"text":"MOVE, Decepticons! Double-time!","show":true}],"fra":[{"time":0.0,"text":"D\u00e9ployez-vous, Decepticons\u00a0! Ex\u00e9cution\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003153":{"duration":1.51,"int":[{"time":0.0,"text":"Go! Go! GO!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003155":{"duration":10.972,"int":[{"time":0.0,"text":"I am Megatron, leader of the Decepticons! This space station is Decepticon property! Surrender immediately!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003157":{"duration":4.513,"int":[{"time":0.0,"text":"Those fools mean to catch us in an ambush at the next door!","show":true}],"fra":[{"time":0.0,"text":"Ces imb\u00e9ciles veulent nous prendre par surprise derri\u00e8re la porte suivante.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003159":{"duration":6.449,"int":[{"time":0.0,"text":"Transmit your coordinates, Soundwave -- and I want everything ready upon my arrival.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003160":{"duration":0.911,"int":[{"time":0.0,"text":"Crush them!","show":true}],"fra":[{"time":0.0,"text":"\u00c9crasez-les\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003161":{"duration":7.376,"int":[{"time":0.0,"text":"I shall not be denied, Starscream. Surrender your Dark Energon program to me immediately!!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003162":{"duration":2.411,"int":[{"time":0.0,"text":"I am COUNTING on it.","show":true}],"fra":[{"time":0.0,"text":"Exactement ce dont j'ai besoin\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003163":{"duration":7.565,"int":[{"time":0.0,"text":"Patience, Brawl. Starscream knows this station inside and out. He may \nyet be of use to us.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003164":{"duration":3.235,"int":[{"time":0.0,"text":"I expect it done when I arrive, Soundwave!","show":true}],"fra":[{"time":0.0,"text":"Fais en sorte qu'il soit pr\u00eat quand j'arrive, Soundwave\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003166":{"duration":4.519,"int":[{"time":0.0,"text":"Decepticons, mount those turrets!  We'll cut them down with their own weaponry!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003167":{"duration":1.555,"int":[{"time":0.0,"text":"Soundwave, report!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003168":{"duration":5.668,"int":[{"time":0.0,"text":"Quiet. There must be another access point.... We have to reach the station's next pod!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003169":{"duration":2.107,"int":[{"time":0.0,"text":"Then we have no time to waste.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003172":{"duration":11.701,"int":[{"time":0.0,"text":"This entire station was created over 10,000 years ago. Much of its technology is antiquated--and inefficient. I look forward to updating it.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003173":{"duration":22.175,"int":[{"time":0.0,"text":"Starscream...this acrimony is needless. I know who you once were, Sky Commander, and that you were betrayed. With Dark Energon, I shall return Cybertron to its former glory -- and you to yours -- IF you agree to serve me.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003174":{"duration":5.41,"int":[{"time":0.0,"text":"Excellent! Decepticons! Lock this room down and await our return!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003175":{"duration":8.89,"int":[{"time":0.0,"text":"Transport devices for Dark Energon. The ancients constructed special pods they could launch to any part of Cybertron.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003176":{"duration":4.155,"int":[{"time":0.0,"text":"Aren't YOU concerned that I might tire of your pointless chatter?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003177":{"duration":5.874,"int":[{"time":0.0,"text":"Soundwave! We've located the holomap -- I'm sending the data to you now.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003282":{"duration":0.897,"int":[{"time":0.0,"text":"Melee Attack RX 1","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK004208":{"duration":2.827,"int":[{"time":0.0,"text":"Jump you fool! There is nowhere to go but down!","show":true}],"fra":[{"time":0.0,"text":"Saute, idiot\u00a0! On doit descendre, il n'y a pas d'autre solution\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004211":{"duration":7.227,"int":[{"time":0.0,"text":"Soundwave reactivated it upon my orders. I have VERY special plans for this facility.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004214":{"duration":10.052,"int":[{"time":0.0,"text":"Once I have enough Dark Energon online, I will use these canisters to transport it to Cybertron! The Autobots' surprise will be TOTAL.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004221":{"duration":1.552,"int":[{"time":0.0,"text":"Cybertron...","show":true}],"fra":[{"time":0.0,"text":"Cybertron...","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004223":{"duration":6.411,"int":[{"time":0.0,"text":"Yes...this is unexpected. The entire area lies in shambles.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004226":{"duration":3.694,"int":[{"time":0.0,"text":"I don't care what did it -- find a way across!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004230":{"duration":11.48,"int":[{"time":0.0,"text":"Fascinating! According to this, a quantity of Dark Energon became unstable...and the resulting explosion destroyed this part of the station.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004232":{"duration":6.015,"int":[{"time":0.0,"text":"Those fools had no idea how to control it! I'll not make the same mistake!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004234":{"duration":4.331,"int":[{"time":0.0,"text":"That makes ONE of us. Speak your piece--quickly.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004236":{"duration":5.995,"int":[{"time":0.0,"text":"You cannot frighten me, Jetfire. I will use Dark Energon as I please.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004238":{"duration":2.775,"int":[{"time":0.0,"text":"You say that as if it were a bad thing.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004240":{"duration":5.959,"int":[{"time":0.0,"text":"Only the strong are worthy of such a weapon, Barricade. I am the strongest.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004244":{"duration":6.217,"int":[{"time":0.0,"text":"You shall soon learn, Starscream...*I* decide what is possible and what isn't!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004247":{"duration":5.109,"int":[{"time":0.0,"text":"We cannot let Starscream succeed! Do you hear me? I WON'T ALLOW IT!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004249":{"duration":1.83,"int":[{"time":0.0,"text":"Quick!  Blast the containment field!","show":true}],"fra":[{"time":0.0,"text":"Vite\u00a0! D\u00e9truisez le champ de r\u00e9tention\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004253":{"duration":8.149,"int":[{"time":0.0,"text":"Hahahaha  I...am the dominator. I...am the destroyer!","show":true}],"fra":[{"time":0.0,"text":"Je suis ... le dominateur. Je suis... le destructeur\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004254":{"duration":4.957,"int":[{"time":0.0,"text":"Decepticons, receive your birthright!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004801":{"duration":0.472,"int":[{"time":0.0,"text":"What?!?","show":true}],"fra":[{"time":0.0,"text":"Comment\u00a0!?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK004982":{"duration":3.809,"int":[{"time":0.0,"text":"We show them NO mercy!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK005188":{"duration":3.044,"int":[{"time":0.0,"text":"Your rage befits a Decepticon warrior.","show":false}],"fra":[{"time":0.0,"text":"Ta fureur fait honneur aux Decepticons\u00a0!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK005200":{"duration":2.069,"int":[{"time":0.0,"text":"Yes -- obliterate them!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK005383":{"duration":4.503,"int":[{"time":0.0,"text":"Now--I shall deal with Starscream!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK006003":{"duration":1.946,"int":[{"time":0.0,"text":"Leave nothing but scrap metal!","show":false}],"fra":[{"time":0.0,"text":"Il n'en reste qu'un tas de ferraille\u00a0!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK006004":{"duration":2.505,"int":[{"time":0.0,"text":"Perfect! Take them all to pieces!","show":false}],"fra":[{"time":0.0,"text":"Excellent\u00a0! Mets-les tous en pi\u00e8ces\u00a0!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK006007":{"duration":2.269,"int":[{"time":0.0,"text":"Do not let that fury subside!","show":false}],"fra":[{"time":0.0,"text":"Ne laisse pas retomber ta col\u00e8re\u00a0!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK006008":{"duration":4.299,"int":[{"time":0.0,"text":"Smash them. Crush them. DESTROY THEM.","show":false}],"fra":[{"time":0.0,"text":"Frappe-les\u00a0! \u00c9crase-les\u00a0! D\u00c9TRUIS-LES\u00a0!","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK008091":{"duration":1.684,"int":[{"time":0.0,"text":"War Cry 2","show":false}],"fra":[{"time":0.0,"text":"[Cri de guerre 2]","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK008933":{"duration":2.103,"int":[{"time":0.0,"text":"Find the controls to that service arm!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008936":{"duration":4.9,"int":[{"time":0.0,"text":"Are your audio receptors damaged?  I said find the controls to that arm!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008944":{"duration":1.718,"int":[{"time":0.0,"text":"Onward!  Through that door!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008945":{"duration":2.067,"int":[{"time":0.0,"text":"The fools gave us our exit!","show":true}],"fra":[{"time":0.0,"text":"Ces idiots nous ont offert une sortie\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008958":{"duration":4.334,"int":[{"time":0.0,"text":"Those fans will split you in two! I can't use you if you're dead!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008959":{"duration":2.595,"int":[{"time":0.0,"text":"Stay clear of the fans, you fool!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009461":{"duration":3.209,"int":[{"time":0.0,"text":"I am MEGATRON!","show":true}],"fra":[{"time":0.0,"text":"Je suis MEGATRON\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009861":{"duration":2.435,"int":[{"time":0.0,"text":"The honor is all yours.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009863":{"duration":0.928,"int":[{"time":0.0,"text":"Excellent.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009864":{"duration":1.946,"int":[{"time":0.0,"text":"Do not speak unless spoken to.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009867":{"duration":1.719,"int":[{"time":0.0,"text":"Then put up a BETTER fight!","show":true}],"fra":[{"time":0.0,"text":"Vous n'\u00eates que des incapables\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009874":{"duration":3.561,"int":[{"time":0.0,"text":"Unacceptable.  They should be victorious, or dead.","show":true}],"fra":[{"time":0.0,"text":"Inadmissible. Ils devraient \u00eatre victorieux, ou d\u00e9sactiv\u00e9s\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009876":{"duration":1.609,"int":[{"time":0.0,"text":"Quickly--jump to the other side!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009879":{"duration":1.933,"int":[{"time":0.0,"text":"And do not question me again!","show":true}],"fra":[{"time":0.0,"text":"Et ne discute plus mes ordres\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009882":{"duration":2.976,"int":[{"time":0.0,"text":"I tire of these futile attempts to resist me.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009883":{"duration":2.862,"int":[{"time":0.0,"text":"Dark Energon will be MINE.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003184":{"duration":4.949,"int":[{"time":0.0,"text":"Megatron -- Soundwave here. Establishing a forward base.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003185":{"duration":2.496,"int":[{"time":0.0,"text":"Alert-- hostiles inbound!","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003186":{"duration":2.944,"int":[{"time":0.0,"text":"Megatron. We await your arrival.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003187":{"duration":4.736,"int":[{"time":0.0,"text":"Megatron. Your command post is 83.4% complete.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003188":{"duration":6.251,"int":[{"time":0.0,"text":"Megatron -- I have unlocked the lift controls. Your command center awaits at the top.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003189":{"duration":14.059,"int":[{"time":0.0,"text":"We have taken control of this portion of the station and established your base of operations. Scans indicate that Starscream has locked down all logical routes to the Dark Energon reactor.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003190":{"duration":13.184,"int":[{"time":0.0,"text":"Megatron -- I have located a nearby Data Matrix Center to reveal any alternate means of entry to the next pod. Advanced teams have already been sent to clear your path.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003191":{"duration":16.277,"int":[{"time":0.0,"text":"Megatron -- be aware that you face overwhelming odds against Starscream's soldiers. It is statistically unlikely that your advance teams can defeat all of them. I shall await your word that you have reached the Data Matrix Center.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003193":{"duration":8.661,"int":[{"time":0.0,"text":"Megatron -- there is a route through the manufacturing plant nearby that Starscream has not yet blocked. Transmitting coordinates.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003194":{"duration":6.208,"int":[{"time":0.0,"text":"Megatron--according to my scans the manufacturing plant is directly below your floor.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK004209":{"duration":6.549,"int":[{"time":0.0,"text":"Megatron. Starscream is alerted to your presence in the production facility. Expect resistance.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK004224":{"duration":3.392,"int":[{"time":0.0,"text":"The holomap indicates no damage to this area.","show":true}],"fra":[{"time":0.0,"text":"L'holocarte ne signale aucun d\u00e9g\u00e2t dans cette zone.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK004229":{"duration":4.629,"int":[{"time":0.0,"text":"Megatron, I have downloaded the station's log. Transmitting history.","show":true}],"fra":[{"time":0.0,"text":"Megatron. J'ai t\u00e9l\u00e9charg\u00e9 le journal de la station. Je te transmets les donn\u00e9es.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003195":{"duration":5.574,"int":[{"time":0.0,"text":"Whoever you are, you've traveled a long way just to meet your doom!","show":true}],"fra":[{"time":0.0,"text":"Je ne sais pas qui tu es, mais tu as commis une grosse erreur en venant ici\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003196":{"duration":2.11,"int":[{"time":0.0,"text":"I am Starscream,","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003198":{"duration":2.441,"int":[{"time":0.0,"text":"I shall hold you to that, soldier.","show":true}],"fra":[{"time":0.0,"text":"Il vaudrait mieux pour toi, soldat...","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003199":{"duration":7.998,"int":[{"time":0.0,"text":"Megatron! I thought you'd be scrap metal by now. Your survival...intrigues me.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003200":{"duration":6.795,"int":[{"time":0.0,"text":"Dark Energon...? Are you MAD? Dark Energon brings only death and chaos!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK003202":{"duration":6.839,"int":[{"time":0.0,"text":"Megatron! You may have gotten this far...but you'll never get your hands on the Dark Energon!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004243":{"duration":4.072,"int":[{"time":0.0,"text":"Impossible! No one has ever survived to reach this place!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004245":{"duration":4.635,"int":[{"time":0.0,"text":"Guards! Hold him off while I destroy the last of the Dark Energon remnants!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004246":{"duration":4.265,"int":[{"time":0.0,"text":"STOP HIM! I need more time to initiate the sequence!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004248":{"duration":4.684,"int":[{"time":0.0,"text":"You're too late! I have initiated the destruction sequence!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004250":{"duration":5.088,"int":[{"time":0.0,"text":"You arrogant FOOL! No one has ever survived direct contact!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004251":{"duration":2.277,"int":[{"time":0.0,"text":"What? This isn't possible!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK004252":{"duration":6.604,"int":[{"time":0.0,"text":"No! No one can control Dark Energon! It dominates and destroys everything it touches!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK005381":{"duration":3.828,"int":[{"time":0.0,"text":"You're a fool!  No one can control Dark Energon!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK010756":{"duration":4.314,"int":[{"time":0.0,"text":"and I have protected my station for over a thousand years!","show":true}]}}}
