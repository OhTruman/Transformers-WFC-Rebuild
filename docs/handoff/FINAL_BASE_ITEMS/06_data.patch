ration":15.164,"int":[{"time":0.0,"text":"YOUR orbital station, Starscream?  Surely you mean MINE.  I see you have finally succeeded in the simple task I gave you.   Perhaps you're not as worthless as I thought.  Report back to base--at once!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK002331":{"duration":1.487,"int":[{"time":0.0,"text":"Starscream, report!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK002333":{"duration":3.944,"int":[{"time":0.0,"text":"I will not suffer excuses. Do not fail me!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK000422":{"duration":5.475,"int":[{"time":0.0,"text":"Incoming!  Take cover!  Wait?!  That's not Autobot weaponry?!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK000434":{"duration":1.689,"int":[{"time":0.0,"text":"The battery casing is opening.","show":true}],"fra":[{"time":0.0,"text":"L'enveloppe blind\u00e9e est en train de s'ouvrir\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK000448":{"duration":1.716,"int":[{"time":0.0,"text":"Whoa...what's happening?!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK000457":{"duration":1.481,"int":[{"time":0.0,"text":"The machine is out of control!","show":true}],"fra":[{"time":0.0,"text":"La machine est incontr\u00f4lable\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK000788":{"duration":2.718,"int":[{"time":0.0,"text":"We've done it!  The Energon Bridge is activating!","show":true}],"fra":[{"time":0.0,"text":"On a r\u00e9ussi\u00a0! Le pont d'\u00e9nergon est op\u00e9rationnel\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002334":{"duration":2.11,"int":[{"time":0.0,"text":"You really told him, Starscream.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002674":{"duration":0.829,"int":[{"time":0.0,"text":"What is THAT?","show":true}],"fra":[{"time":0.0,"text":"C'est quoi, \u00e7a\u00a0?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002679":{"duration":3.616,"int":[{"time":0.0,"text":"You are as boring as ever, Thundercracker.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002683":{"duration":1.049,"int":[{"time":0.0,"text":"So it's a trap!","show":true}],"fra":[{"time":0.0,"text":"Un pi\u00e8ge, quoi\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002691":{"duration":0.689,"int":[{"time":0.0,"text":"Rockets!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002695":{"duration":1.305,"int":[{"time":0.0,"text":"Where are we?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002698":{"duration":3.799,"int":[{"time":0.0,"text":"Tighten your logic circuits, would you, Thundercracker?  It can't be THAT bad.","show":true}],"fra":[{"time":0.0,"text":"Mets tes circuits logiques en veille, Thundercracker. Je suis s\u00fbr qu'on ne risque rien\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002707":{"duration":1.916,"int":[{"time":0.0,"text":"Whatever you say, Starscream!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK002711":{"duration":1.315,"int":[{"time":0.0,"text":"What contamination?","show":true}],"fra":[{"time":0.0,"text":"Quelle contamination\u00a0?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008811":{"duration":0.995,"int":[{"time":0.0,"text":"That was easy!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008813":{"duration":4.547,"int":[{"time":0.0,"text":"My neural circuitry is stinging.  Getting past this thing is impossible!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008818":{"duration":3.982,"int":[{"time":0.0,"text":"You're the brainy one, Thundercracker! YOU figure it out.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008820":{"duration":2.4,"int":[{"time":0.0,"text":"You got the answer? What, what, what is it?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008830":{"duration":1.998,"int":[{"time":0.0,"text":"This thing is as crazy as I am!","show":true}],"fra":[{"time":0.0,"text":"Cet engin est aussi fou que moi\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008833":{"duration":1.962,"int":[{"time":0.0,"text":"I'll show them some REAL flying!","show":true}],"fra":[{"time":0.0,"text":"Je vais leur donner une le\u00e7on de vol\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008836":{"duration":1.804,"int":[{"time":0.0,"text":"Watch out for those rocket snipers!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008840":{"duration":0.813,"int":[{"time":0.0,"text":"Trap us?","show":true}],"fra":[{"time":0.0,"text":"Nous pi\u00e9ger\u00a0?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008847":{"duration":1.097,"int":[{"time":0.0,"text":"They sealed it off!","show":true}],"fra":[{"time":0.0,"text":"Ils l'ont scell\u00e9 aussi\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008849":{"duration":3.776,"int":[{"time":0.0,"text":"Dumber than Skywarp?  I'll show YOU dumb, Starscream!","show":true}],"fra":[{"time":0.0,"text":"Plus b\u00eates que Skywarp\u00a0? Tu regretteras cette insulte, Starscream\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008871":{"duration":1.54,"int":[{"time":0.0,"text":"Those punks locked us out!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008877":{"duration":1.12,"int":[{"time":0.0,"text":"I think I saw something.","show":true}],"fra":[{"time":0.0,"text":"Je crois que j'ai vu quelque chose.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008881":{"duration":1.826,"int":[{"time":0.0,"text":"This place gives me the creeps.","show":true}],"fra":[{"time":0.0,"text":"Ces tunnels sont vraiment lugubres.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008886":{"duration":1.82,"int":[{"time":0.0,"text":"I thought this place was deserted!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008888":{"duration":3.067,"int":[{"time":0.0,"text":"More cloakers?  These guys creep me out!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008890":{"duration":1.654,"int":[{"time":0.0,"text":"At least I'm not ugly.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008895":{"duration":2.783,"int":[{"time":0.0,"text":"Looks like a lot of Autobots don't want that to happen.","show":true}],"fra":[{"time":0.0,"text":"On dirait que les Autobots n'aiment pas beaucoup cette id\u00e9e...","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008906":{"duration":1.643,"int":[{"time":0.0,"text":"Are we even hurting this thing?","show":true}],"fra":[{"time":0.0,"text":"On lui fait des d\u00e9g\u00e2ts, au moins\u00a0?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008908":{"duration":2.017,"int":[{"time":0.0,"text":"Ha!  He's not so tough!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008910":{"duration":1.148,"int":[{"time":0.0,"text":"Move! Move! Move!","show":true}],"fra":[{"time":0.0,"text":"Allez\u00a0! Bougez\u00a0! Vite\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008911":{"duration":1.377,"int":[{"time":0.0,"text":"What is it doing NOW?","show":true}],"fra":[{"time":0.0,"text":"Qu'est-ce qu'il fait, maintenant\u00a0?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK008914":{"duration":2.049,"int":[{"time":0.0,"text":"Wait! Something's happening!","show":true}],"fra":[{"time":0.0,"text":"Attendez\u00a0! Il se passe quelque chose\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009307":{"duration":1.594,"int":[{"time":0.0,"text":"I do enjoy sniping!","show":true}],"fra":[{"time":0.0,"text":"J'adore le tir de pr\u00e9cision\u00a0!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009312":{"duration":1.559,"int":[{"time":0.0,"text":"That doesn't look too good...","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009831":{"duration":1.139,"int":[{"time":0.0,"text":"What happened now!","show":true}],"fra":[{"time":0.0,"text":"Qu'est-ce qu'il y a, encore\u00a0!?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009833":{"duration":6.171,"int":[{"time":0.0,"text":"Wait--are you calling US fools, or the Autobots fools?  Because--I'm not getting the sense that you respect me.","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009835":{"duration":2.083,"int":[{"time":0.0,"text":"That's EXACTLY what I'm talking about!","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009844":{"duration":1.011,"int":[{"time":0.0,"text":"Did you see that?","show":true}]},"WL_DX_SKYWRP.DX_SKYWRP_LK009846":{"duration":0.716,"int":[{"time":0.0,"text":"Yah.","show":true}],"fra":[{"time":0.0,"text":"Ouais.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000391":{"duration":8.721,"int":[{"time":0.0,"text":"Megatron, Thundercracker has detected several  Autobots up ahead.  Jetfire must have warned Zeta Prime and moved to intercept us already!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000393":{"duration":7.996,"int":[{"time":0.0,"text":"That imbecile thinks I'm expendable.  ME!?  He'll soon learn  never to underestimate Starscream!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000402":{"duration":2.599,"int":[{"time":0.0,"text":"I can see that for myself, Thundercracker.","show":true}],"fra":[{"time":0.0,"text":"Mes capteurs optiques fonctionnent tr\u00e8s bien, merci.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000412":{"duration":4.515,"int":[{"time":0.0,"text":"Hahaha! Feel the power of my wrath!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000413":{"duration":3.869,"int":[{"time":0.0,"text":"Get moving, Decepticons. We must be getting close.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000415":{"duration":1.781,"int":[{"time":0.0,"text":"Bring down those shields!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000416":{"duration":4.522,"int":[{"time":0.0,"text":"I don't care!  Focus all firepower on their pathetic door!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000417":{"duration":5.045,"int":[{"time":0.0,"text":"Move, Decepticons. Into the tunnels! We have a Bridge to activate!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000425":{"duration":3.265,"int":[{"time":0.0,"text":"Look out for those sentries, you bumbling idiots!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000427":{"duration":3.728,"int":[{"time":0.0,"text":"More fools rush to their death.  Destroy them!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000432":{"duration":5.008,"int":[{"time":0.0,"text":"Another shield generator?!  These Autobots are getting on my nerves.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000438":{"duration":3.822,"int":[{"time":0.0,"text":"Then we are close - the Energon Bridge must be nearby","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000447":{"duration":5.152,"int":[{"time":0.0,"text":"I've had enough of your readings!  Use Dark Energon and corrupt the machine!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000450":{"duration":2.476,"int":[{"time":0.0,"text":"Quit blabbing and destroy this nuisance!","show":true}],"fra":[{"time":0.0,"text":"Assez bavard\u00e9\u00a0! D\u00e9truisez cette machine ridicule\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000451":{"duration":3.527,"int":[{"time":0.0,"text":"The machine is vulnerable!  Focus your fire on the core!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000456":{"duration":2.308,"int":[{"time":0.0,"text":"To the surface, Decepticons!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000458":{"duration":2.867,"int":[{"time":0.0,"text":"It must be a side effect of the Dark Energon!","show":true}],"fra":[{"time":0.0,"text":"S\u00fbrement un effet secondaire de l'\u00e9nergon noir\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000465":{"duration":7.128,"int":[{"time":0.0,"text":"Quiet!  You're ruining my moment of Glory!  Soon, my Orbital Station will be at full power!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000776":{"duration":2.619,"int":[{"time":0.0,"text":"Just a slight delay...","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002332":{"duration":5.281,"int":[{"time":0.0,"text":"Megatron!  We are encountering significant Autobot resistance but.....","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002335":{"duration":6.844,"int":[{"time":0.0,"text":"Silence! Soon the Decepticons will be mine to control and Megatron will serve me!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002676":{"duration":4.746,"int":[{"time":0.0,"text":"Like that puny probe could stop me.  Blast them and get on with it!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002681":{"duration":3.647,"int":[{"time":0.0,"text":"What is this?  Some kind of Autobot trap?","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002685":{"duration":5.654,"int":[{"time":0.0,"text":"Stupid Autobots.  To think their measly tricks could ever fool Starscream.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002687":{"duration":1.511,"int":[{"time":0.0,"text":"Quiet, Thundercracker!","show":true}],"fra":[{"time":0.0,"text":"Silence, Thundercracker\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002689":{"duration":4.438,"int":[{"time":0.0,"text":"The penalty for testing my patience is death.  Destroy them!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002692":{"duration":1.449,"int":[{"time":0.0,"text":"Quickly, get to cover!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002696":{"duration":3.875,"int":[{"time":0.0,"text":"We're NOT where we NEED to be, Skywarp--so keep moving!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK002712":{"duration":1.903,"int":[{"time":0.0,"text":"He means US, you idiot!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008808":{"duration":2.38,"int":[{"time":0.0,"text":"Couldn't have said it better myself!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008809":{"duration":4.21,"int":[{"time":0.0,"text":"How boring! I've read more entertaining maintenance reports.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008814":{"duration":3.326,"int":[{"time":0.0,"text":"Keep looking you fool.  That answer is here somewhere!","show":true}],"fra":[{"time":0.0,"text":"Continue de chercher, idiot\u00a0! La r\u00e9ponse est forc\u00e9ment quelque part ici\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008816":{"duration":3.138,"int":[{"time":0.0,"text":"Idiots! Take it offline! NOW!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008817":{"duration":3.897,"int":[{"time":0.0,"text":"I would prefer a solution sometime TODAY.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008822":{"duration":4.345,"int":[{"time":0.0,"text":"I see it as well! Plain as day...right in front of us!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008828":{"duration":2.271,"int":[{"time":0.0,"text":"Enough babbling--destroy it!","show":true}],"fra":[{"time":0.0,"text":"Assez discut\u00e9\u00a0! D\u00e9truisez-la\u00a0!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008831":{"duration":3.277,"int":[{"time":0.0,"text":"Just blast it!  It breaks, like everything else!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008832":{"duration":3.127,"int":[{"time":0.0,"text":"Excellent! Now, target the Aerialbots!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008837":{"duration":7.368,"int":[{"time":0.0,"text":"Enough of this nonsense! We'll bring this annoyance down from the INSIDE. Fly in and target its power core!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008838":{"duration":2.506,"int":[{"time":0.0,"text":"The blast doors are open!  Quickly!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008842":{"duration":7.424,"int":[{"time":0.0,"text":"Hahahaha! Those idiots locked us in here with their power core! Plant a detpack on it!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008844":{"duration":4.17,"int":[{"time":0.0,"text":"Unbelievable! These Autobots are dumber than Skywarp!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008846":{"duration":2.061,"int":[{"time":0.0,"text":"Try the upper deck!  Hurry!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008848":{"duration":2.595,"int":[{"time":0.0,"text":"Now's our chance!  Fly through the hole!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008850":{"duration":1.548,"int":[{"time":0.0,"text":"You always do.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008872":{"duration":2.866,"int":[{"time":0.0,"text":"Stop whining and find another way in!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008874":{"duration":2.942,"int":[{"time":0.0,"text":"Perfect!  There may be a cave below!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008879":{"duration":5.04,"int":[{"time":0.0,"text":"SILENCE!  It could be an Autobot cloaker--keep your optics sharp!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008880":{"duration":1.293,"int":[{"time":0.0,"text":"There!  Destroy it!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008882":{"duration":6.577,"int":[{"time":0.0,"text":"These tunnels were decommissioned long ago.  We'll have to activate the power terminals to get the station back online.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008884":{"duration":3.463,"int":[{"time":0.0,"text":"Who cares--if they get in my way, BLAST THEM!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008885":{"duration":6.399,"int":[{"time":0.0,"text":"There, just as I told you!  The Energon Bridge Terminal.  Find a way inside and activate it!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008887":{"duration":4.266,"int":[{"time":0.0,"text":"We must've tripped the station's automated defenses. Open fire!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008894":{"duration":5.006,"int":[{"time":0.0,"text":"Finally! From here we should be able to restore full power to the Energon Bridge!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008896":{"duration":2.154,"int":[{"time":0.0,"text":"Bah!  DESTROY THEM!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008897":{"duration":3.219,"int":[{"time":0.0,"text":"Nothing will stop me! Blast those locks!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008898":{"duration":4.766,"int":[{"time":0.0,"text":"All right...this station seems to funnel power directly to the Energon Bridge.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008904":{"duration":6.117,"int":[{"time":0.0,"text":"I did it! Look at all that power flowing! Onward, Decepticons!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008907":{"duration":4.313,"int":[{"time":0.0,"text":"Not with your pathetic aim! Focus fire on those guns!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008912":{"duration":2.839,"int":[{"time":0.0,"text":"Who cares?  Just be ready for it!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008915":{"duration":6.139,"int":[{"time":0.0,"text":"YES! It's crumbling before the MIGHT of STARSCREAM!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009308":{"duration":2.759,"int":[{"time":0.0,"text":"Afraid to take them head on, Skywarp?","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009310":{"duration":1.98,"int":[{"time":0.0,"text":"Pathetic machinery.","show":true}],"fra":[{"time":0.0,"text":"Quelle machine pitoyable...","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009315":{"duration":4.502,"int":[{"time":0.0,"text":"We're getting close!  The next entrance is just on the far side of this canyon!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009316":{"duration":2.914,"int":[{"time":0.0,"text":"Now, get the power back online so we can move on!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009830":{"duration":2.21,"int":[{"time":0.0,"text":"Quickly--destroy the locks!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009832":{"duration":3.606,"int":[{"time":0.0,"text":"The Autobots have booby trapped this room.  Fools!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009834":{"duration":2.131,"int":[{"time":0.0,"text":"Silence! Fool!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009836":{"duration":4.28,"int":[{"time":0.0,"text":"This is almost too easy.  Quickly, find the other power terminals.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009837":{"duration":4.431,"int":[{"time":0.0,"text":"Excellent, now keep looking--there should be just one more.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009839":{"duration":3.788,"int":[{"time":0.0,"text":"Perfect!  Now--get these power cells into position!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009841":{"duration":7.694,"int":[{"time":0.0,"text":"Hahahaha!  We are but one click away from activating the full power of the Energon bridge!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009842":{"duration":6.331,"int":[{"time":0.0,"text":"The device must be inside that machine.  Plant a Dark Energon Det-Pack on its power cable to activate it.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK009848":{"duration":2.677,"int":[{"time":0.0,"text":"I should've left you two on the station.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000401":{"duration":3.705,"int":[{"time":0.0,"text":"That Autobot ship is generating an energy shield over the entrance!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000405":{"duration":4.141,"int":[{"time":0.0,"text":"The shield batteries are exposed. If we destroy them, we can lower the shield.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000414":{"duration":3.029,"int":[{"time":0.0,"text":"There it is.  The entrance to the underground.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000426":{"duration":2.148,"int":[{"time":0.0,"text":"Detecting Autobot energy signatures!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000437":{"duration":3.946,"int":[{"time":0.0,"text":"I am detecting an unknown energy signature nearby. Off the scale...","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000446":{"duration":1.675,"int":[{"time":0.0,"text":"My scans indicate that--","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000449":{"duration":4.886,"int":[{"time":0.0,"text":"Precisely what I was afraid of. Cybertron is trying to purge itself of contamination.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000454":{"duration":3.667,"int":[{"time":0.0,"text":"Incredible.  The Energon Bridge is active once more.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK000769":{"duration":3.875,"int":[{"time":0.0,"text":"Wait. Scans show high-density ubarium shielding on that door.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002675":{"duration":3.457,"int":[{"time":0.0,"text":"An Autobot probe.  We should avoid it to prevent detection.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002678":{"duration":4.176,"int":[{"time":0.0,"text":"I have never traveled this deeply into Cybertron's interior before.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002682":{"duration":1.871,"int":[{"time":0.0,"text":"It's an enemy detection barrier.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002684":{"duration":3.915,"int":[{"time":0.0,"text":"The power conduits along the floor should direct us to its power source.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002686":{"duration":2.687,"int":[{"time":0.0,"text":"I SAID we should be careful.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002690":{"duration":2.844,"int":[{"time":0.0,"text":"The power core has to be somewhere in this room.","show":true}],"fra":[{"time":0.0,"text":"Le noyau \u00e9nerg\u00e9tique doit \u00eatre quelque part dans cette salle.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002693":{"duration":3.795,"int":[{"time":0.0,"text":"My scans indicate that door should lead us to the next canyon.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK002697":{"duration":7.015,"int":[{"time":0.0,"text":"Crude energon is highly volatile, and flying this close to it is very dangerous. We should proceed with caution.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008812":{"duration":4.386,"int":[{"time":0.0,"text":"The others will likely be tougher.  I suggest we proceed with caution.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008819":{"duration":1.693,"int":[{"time":0.0,"text":"Ah! Of COURSE!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008821":{"duration":1.433,"int":[{"time":0.0,"text":"I'm not telling you.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008823":{"duration":3.009,"int":[{"time":0.0,"text":"You don't really see it, do you, Starscream?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008829":{"duration":1.422,"int":[{"time":0.0,"text":"Target the mortars first!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008834":{"duration":1.404,"int":[{"time":0.0,"text":"Here comes another wave!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008835":{"duration":1.395,"int":[{"time":0.0,"text":"More reinforcements?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008841":{"duration":1.373,"int":[{"time":0.0,"text":"Orders, Starscream?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008845":{"duration":4.024,"int":[{"time":0.0,"text":"Perhaps, Starscream, but have you considered an escape route for US?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008873":{"duration":2.893,"int":[{"time":0.0,"text":"My scans show an energon deposit beneath us.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008878":{"duration":1.151,"int":[{"time":0.0,"text":"You think you saw what?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008883":{"duration":3.114,"int":[{"time":0.0,"text":"Interesting.  I've never seen these life forms before.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008889":{"duration":2.76,"int":[{"time":0.0,"text":"What's the matter, Skywarp--afraid?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008891":{"duration":2.464,"int":[{"time":0.0,"text":" Ugly?  You and I look the SAME!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008892":{"duration":5.607,"int":[{"time":0.0,"text":"The station is only showing power levels at 50%.  There must be another terminal deeper underground.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008893":{"duration":3.607,"int":[{"time":0.0,"text":"That has to be it! The master power routing facility!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008899":{"duration":3.158,"int":[{"time":0.0,"text":"Those are the Energon Bridge's power control panels.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008909":{"duration":1.355,"int":[{"time":0.0,"text":"Evade those beams!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK008913":{"duration":1.259,"int":[{"time":0.0,"text":"Evasive maneuvers!","show":true}],"fra":[{"time":0.0,"text":"Manoeuvres d'\u00e9vitement\u00a0!","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009306":{"duration":2.467,"int":[{"time":0.0,"text":"I'm reading Autobot energy signatures up ahead.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009829":{"duration":3.165,"int":[{"time":0.0,"text":"Looks like the Autobots have locked these power cells down.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009838":{"duration":2.7,"int":[{"time":0.0,"text":"Energy barriers are 100% offline.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009840":{"duration":2.996,"int":[{"time":0.0,"text":"The side terminals are showing power levels at maximum.","show":true}],"fra":[{"time":0.0,"text":"Les terminaux lat\u00e9raux affichent des niveaux d'\u00e9nergie optimaux.","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009845":{"duration":2.733,"int":[{"time":0.0,"text":"You mean that creepy looking thing that just jumped over the side?","show":true}]},"WL_DX_THUNDR.DX_THUNDR_LK009847":{"duration":1.664,"int":[{"time":0.0,"text":"Nope.  I didn't see anything.","show":true}]},"WL_DX_ZPRIME.DX_ZPRIME_LK008807":{"duration":22.671,"int":[{"time":0.0,"text":"Autobots, this is Zeta Prime.  Be on high alert!  The Decepticons are planning to re-activate the Energon Bridge. This would grant them access to an unstable energy source powerful enough to jeopardize the entire planet.  Any Decepticon activity must be reported immediately, and all Decepticons are to be shot on sight! Zeta Prime out!","show":true}]},"WL_DX_ZPRIME.DX_ZPRIME_LK010990":{"duration":1.986,"int":[{"time":0.0,"text":"Focus your fire on that Decepticon","show":true}],"fra":[{"time":0.0,"text":"Concentrez le tir sur ce Decepticon.","show":true}]}}}
