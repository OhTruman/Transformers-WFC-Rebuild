D.DX_AIRAID_LK004343":{"duration":2.12,"int":[{"time":0.0,"text":"What the--? What just happened?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004345":{"duration":2.475,"int":[{"time":0.0,"text":"Well GREAT. What do we do NOW?","show":true}],"fra":[{"time":0.0,"text":"G\u00c9NIAL\u00a0! On fait quoi, maintenant\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004347":{"duration":1.515,"int":[{"time":0.0,"text":"Now you're talking, Silverbolt!","show":true}],"fra":[{"time":0.0,"text":"On aurait d\u00fb commencer par l\u00e0\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004351":{"duration":2.914,"int":[{"time":0.0,"text":"Was that -- did that thing just talk?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004358":{"duration":2.934,"int":[{"time":0.0,"text":"And HOW, exactly, are we supposed to disable this thing?","show":true}],"fra":[{"time":0.0,"text":"C'est bien joli, mais comment tu comptes t'y prendre, au juste\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004361":{"duration":3.052,"int":[{"time":0.0,"text":"That sounded like laughter. Was that laughter??","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004381":{"duration":1.171,"int":[{"time":0.0,"text":"Destroy the turrets!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004388":{"duration":2.851,"int":[{"time":0.0,"text":"What's he changing into? ...Are those TEETH?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004389":{"duration":2.019,"int":[{"time":0.0,"text":"Wooohoo!","show":true}],"fra":[{"time":0.0,"text":"Wooohooo\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004398":{"duration":1.112,"int":[{"time":0.0,"text":"Watch those missiles!","show":true}],"fra":[{"time":0.0,"text":"\u00c9vitez ces missiles\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004740":{"duration":2.609,"int":[{"time":0.0,"text":"Terrific -- here comes the welcoming committee.","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004743":{"duration":1.213,"int":[{"time":0.0,"text":"Yaaahhh!","show":true}],"fra":[{"time":0.0,"text":"Yaaaah\u00a0!!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004747":{"duration":1.591,"int":[{"time":0.0,"text":"So how do we do that?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004751":{"duration":5.591,"int":[{"time":0.0,"text":"Silverbolt, I gotta say I wasn't thrilled when Optimus named you leader of the squad instead of me.","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004753":{"duration":9.005,"int":[{"time":0.0,"text":"No, no--  hear me out!  What I MEAN to say is--you don't entirely suck at the job.  You know, for a guy who's afraid of heights and all.","show":true}],"fra":[{"time":0.0,"text":"Non, non... laisse-moi finir\u00a0! Ce que je veux dire, c'est que tu t'en sors plut\u00f4t bien, finalement\u00a0! Enfin, je veux dire, pour un type qui a peur du vide, en tout cas.","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004755":{"duration":1.169,"int":[{"time":0.0,"text":"It's a compliment!","show":true}],"fra":[{"time":0.0,"text":"C'\u00e9tait un compliment\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004763":{"duration":1.933,"int":[{"time":0.0,"text":"What--? It's a dead end!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004766":{"duration":3.577,"int":[{"time":0.0,"text":"Yeah! How you like THAT, Decepti-Creeps!","show":true}],"fra":[{"time":0.0,"text":"Ouais\u00a0! Qu'est-ce que vous dites de \u00e7a, Decepticons\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004769":{"duration":1.494,"int":[{"time":0.0,"text":"I never do!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004770":{"duration":1.939,"int":[{"time":0.0,"text":"Now THAT'S what I'm talking about!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004772":{"duration":4.05,"int":[{"time":0.0,"text":"No need to rush on my account -- I like blasting Decepticons!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004787":{"duration":2.91,"int":[{"time":0.0,"text":"Wait a second! Trypticon's a Cybertronian right?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004789":{"duration":7.303,"int":[{"time":0.0,"text":"Then he must have a conversion cog.  If we destroy it, he won't be able to stay online as a gun.  He'll revert to his original form.","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK004792":{"duration":2.989,"int":[{"time":0.0,"text":"They're gonna kill Prime!  Move!  Move!  Move!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK008062":{"duration":1.929,"int":[{"time":0.0,"text":"That's good right?  This is good?","show":true}],"fra":[{"time":0.0,"text":"\u00c7a veut dire qu'on a r\u00e9ussi, c'est \u00e7a\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK008790":{"duration":2.734,"int":[{"time":0.0,"text":"So what exactly are the odds of us making it out of this?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK008793":{"duration":1.008,"int":[{"time":0.0,"text":"What the--?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK008801":{"duration":1.774,"int":[{"time":0.0,"text":"Fine, how do we get past it?","show":true}],"fra":[{"time":0.0,"text":"Parfait. Et comment on la franchit\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK008803":{"duration":1.393,"int":[{"time":0.0,"text":"That seemed pretty easy","show":true}],"fra":[{"time":0.0,"text":"C'est facile, pour une fois...","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK009278":{"duration":1.333,"int":[{"time":0.0,"text":"What is that thing?","show":true}],"fra":[{"time":0.0,"text":"C'est quoi, ce truc\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK009286":{"duration":1.606,"int":[{"time":0.0,"text":"What's it gonna take with this guy?","show":true}],"fra":[{"time":0.0,"text":"Ce monstre est invincible, ou quoi\u00a0?","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK009292":{"duration":1.467,"int":[{"time":0.0,"text":"There!  That will do it!","show":true}],"fra":[{"time":0.0,"text":"Voil\u00e0\u00a0! On a r\u00e9ussi\u00a0!","show":true}]},"WL_DX_AIRAID.DX_AIRAID_LK009295":{"duration":1.669,"int":[{"time":0.0,"text":"Heads up!  Decepticons!","show":true}],"fra":[{"time":0.0,"text":"Attention\u00a0! Des Decepticons\u00a0!","show":true}]},"WL_DX_CARA01.DX_CARA01_LK003400":{"duration":1.354,"int":[{"time":0.0,