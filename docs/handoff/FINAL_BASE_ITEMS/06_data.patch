alse}]},"WL_DX_CARA01.DX_CARA01_LK009368":{"duration":2.973,"int":[{"time":0.0,"text":"Target the Seekers! Get those Decepticons out of the sky!","show":false}]},"WL_DX_CARA01.DX_CARA01_LK009905":{"duration":1.451,"int":[{"time":0.0,"text":"Death RX 12","show":false}]},"WL_DX_CARA02.DX_CARA02_LK009361":{"duration":2.215,"int":[{"time":0.0,"text":"Scan this entire sector!  Find them!","show":false}]},"WL_DX_CARA02.DX_CARA02_LK009363":{"duration":3.029,"int":[{"time":0.0,"text":"Someone's breaking in!  Assume defensive positions!","show":false}]},"WL_DX_CARA02.DX_CARA02_LK009369":{"duration":4.767,"int":[{"time":0.0,"text":"We can't let the Decepticons take control of these turrets!  Stop them, Autobots!","show":false}]},"WL_DX_CARD01.DX_CARD01_LK000659":{"duration":0.976,"int":[{"time":0.0,"text":"Death RX 2","show":false}]},"WL_DX_CARD01.DX_CARD01_LK009358":{"duration":3.856,"int":[{"time":0.0,"text":"Megatron -- you're still functional! Thank Primus we found you!","show":true}],"fra":[{"time":0.0,"text":"Megatron\u00a0! Tu es toujours op\u00e9rationnel\u00a0! On commen\u00e7ait \u00e0 d\u00e9sesp\u00e9rer\u00a0!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK009359":{"duration":1.371,"int":[{"time":0.0,"text":"AAAAAAAA!!!","show":true}],"fra":[{"time":0.0,"text":"AAAAAHH\u00a0!!!","show":true}]},"WL_DX_CARD01.DX_CARD01_LK009373":{"duration":2.509,"int":[{"time":0.0,"text":"FALL BACK! Fall back and take cover!","show":false}],"fra":[{"time":0.0,"text":"Repliez-vous et mettez-vous \u00e0 couvert\u00a0!","show":false}]},"WL_DX_CARD01.DX_CARD01_LK009375":{"duration":3.572,"int":[{"time":0.0,"text":"Megatron! Help us -- MEGATRONNNNN...!","show":false}]},"WL_DX_CARD02.DX_CARD02_LK009374":{"duration":2.869,"int":[{"time":0.0,"text":"He's got me!  I can't break free!","show":false}]},"WL_DX_JTSA01.DX_JTSA01_LK002591":{"duration":0.751,"int":[{"time":0.0,"text":"Let's get them!","show":false}],"fra":[{"time":0.0,"text":"\u00c0 l'attaque\u00a0!!!","show":false}]},"WL_DX_JTSD01.DX_JTSD01_LK000669":{"duration":1.778,"int":[{"time":0.0,"text":"Death RX 2","show":false}]},"WL_DX_MGTRON.DX_MGTRON_LK000101":{"duration":2.412,"int":[{"time":0.0,"text":"Fall back.  Inside.  Quickly!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000102":{"duration":4.779,"int":[{"time":0.0,"text":"Stop wasting ammunition. We will find another way to deal with Omega Supreme.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000107":{"duration":11.428,"int":[{"time":0.0,"text":"Starscream, you halfwit! I still function...a fact you shall regret, when I choke the life out of you! Now -- I order you to deploy ships for immediate evacuation!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000109":{"duration":5.68,"int":[{"time":0.0,"text":"Grrr! Let's head for that lift, before that idiot Starscream causes irreparable harm.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000110":{"duration":2.583,"int":[{"time":0.0,"text":"Starscream -- come in. This is Megatron.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000112":{"duration":4.081,"int":[{"time":0.0,"text":"Can this feeble Autobot mechanism not move any faster?!?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000113":{"duration":6.447,"int":[{"time":0.0,"text":"It appears we've lost that dull-witted brute, Omega Supreme.  Not that he stood a chance against my intellect.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000115":{"duration":1.592,"int":[{"time":0.0,"text":"What? WHAT?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000119":{"duration":1.866,"int":[{"time":0.0,"text":"Starscream, do you read me?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000121":{"duration":5.684,"int":[{"time":0.0,"text":"Spare me your theatrics!  I need immediate air support! Attack Omega Supreme!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000131":{"duration":4.399,"int":[{"time":0.0,"text":"Would you rather face his wrath, or mine?  Now jump!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000134":{"duration":1.42,"int":[{"time":0.0,"text":"Faster, Decepticons!","show":true}],"fra":[{"time":0.0,"text":"Plus vite, Decepticons\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000137":{"duration":3.607,"int":[{"time":0.0,"text":"You WILL reach the other side, or I'll have your head!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000138":{"duration":1.781,"int":[{"time":0.0,"text":"Starscream! Status report!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000140":{"duration":10.221,"int":[{"time":0.0,"text":"BELAY THAT ORDER! Decepticons, this is MEGATRON! Anyone caught fleeing this battle will be marked kill on sight! Press your attack IMMEDIATELY!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000142":{"duration":6.161,"int":[{"time":0.0,"text":"Especially you, Starscream! I order you to continue the assault! Megatron out!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000543":{"duration":2.581,"int":[{"time":0.0,"text":"An excellent idea, Soundwave.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000545":{"duration":3.399,"int":[{"time":0.0,"text":"Autobots! Decepticons -- open fire!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000554":{"duration":4.601,"int":[{"time":0.0,"text":"Soundwave! You led us to this place. What is your explanation?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000556":{"duration":2.003,"int":[{"time":0.0,"text":"You heard him! Blast the wall!","show":true}],"fra":[{"time":0.0,"text":"Il fallait le dire\u00a0! Explosez ce mur\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000559":{"duration":4.774,"int":[{"time":0.0,"text":"And yet still preferable to your incessant chatter. Now get to those controls!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000561":{"duration":5.241,"int":[{"time":0.0,"text":"Finally. Decepticons -- move quickly. We must reach those guns!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000562":{"duration":1.779,"int":[{"time":0.0,"text":"I can see that, you fool!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK000564":{"duration":5.403,"int":[{"time":0.0,"text":"Yes, Breakdown, your constant whining saw us through.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001038":{"duration":4.384,"int":[{"time":0.0,"text":"Omega Supreme's main weapon batteries are charging! Prepare for evasive action!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001041":{"duration":5.086,"int":[{"time":0.0,"text":"Keep firing, Decepticons!  The turrets are wearing down Omega Supreme's defenses!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001044":{"duration":5.371,"int":[{"time":0.0,"text":"Decepticons! Omega Supreme has deployed Aerialbots! Shoot them down!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001049":{"duration":3.609,"int":[{"time":0.0,"text":"A simple solution, then.  Break the locks!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001051":{"duration":8.289,"int":[{"time":0.0,"text":"You think you can destroy me, Omega Supreme? You think you can destroy MEGATRON? ...Do your worst.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001055":{"duration":3.034,"int":[{"time":0.0,"text":"Open fire on the emergency locks! Destroy them!","show":true}],"fra":[{"time":0.0,"text":"Tirez sur les verrous de s\u00e9curit\u00e9\u00a0! D\u00e9truisez-les\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001057":{"duration":4.666,"int":[{"time":0.0,"text":"A futile gesture. Decepticons! Destroy the sentries!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001062":{"duration":4.87,"int":[{"time":0.0,"text":"Do not test me, Breakdown. My patience is at a critical low.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK001521":{"duration":2.706,"int":[{"time":0.0,"text":"Stop whining and start shooting, Breakdown!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK002339":{"duration":3.788,"int":[{"time":0.0,"text":"Excellent work, Soundwave. Now unlock the exit door.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK002342":{"duration":3.275,"int":[{"time":0.0,"text":"Then I suggest you move quickly! Now go!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003715":{"duration":1.012,"int":[{"time":0.0,"text":"Smash through them!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003724":{"duration":1.954,"int":[{"time":0.0,"text":"Get moving, Breakdown!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003726":{"duration":1.084,"int":[{"time":0.0,"text":"Activate the bridge!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK003727":{"duration":7.798,"int":[{"time":0.0,"text":"Precisely as I had planned. Decepticons! Man the turrets, and blast that obsolete hulk out of the sky!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008698":{"duration":4.29,"int":[{"time":0.0,"text":"Maintain this heading!  The device shows the Omega Key is directly ahead!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008703":{"duration":1.614,"int":[{"time":0.0,"text":"Stay your course!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008705":{"duration":2.709,"int":[{"time":0.0,"text":"Turn around and--where did it go?","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008707":{"duration":3.722,"int":[{"time":0.0,"text":"No, Breakdown. He IS the Omega Key!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008712":{"duration":8.749,"int":[{"time":0.0,"text":"Silence! This merely modifies my plan. If Omega Supreme IS the key...then I shall FORCE him to open the planet's core.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008717":{"duration":3.428,"int":[{"time":0.0,"text":"Starscream!  I am 7 clicks north of your position!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008719":{"duration":1.927,"int":[{"time":0.0,"text":"Enough!  Meet us at the bridge!","show":true}],"fra":[{"time":0.0,"text":"Assez\u00a0! Retrouve-nous sur le pont\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008722":{"duration":2.089,"int":[{"time":0.0,"text":"Starscream, you COWARD!","show":true}],"fra":[{"time":0.0,"text":"Starscream\u00a0! Sale L\u00c2CHE\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008726":{"duration":3.683,"int":[{"time":0.0,"text":"Stand your ground, Decepticons! Destroy the bridge supports!","show":true}],"fra":[{"time":0.0,"text":"Tenez vos positions, Decepticons\u00a0! D\u00e9truisez les supports du pont\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008728":{"duration":2.698,"int":[{"time":0.0,"text":"We can salvage the wreckage for what we need.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008730":{"duration":1.221,"int":[{"time":0.0,"text":"Lock the door!  Quickly!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008737":{"duration":6.559,"int":[{"time":0.0,"text":"I see...  We will lure Omega Supreme up there, and use the Autobot guns against him!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008738":{"duration":2.908,"int":[{"time":0.0,"text":"Autobot weaklings.  Onward, to the lift!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008740":{"duration":3.44,"int":[{"time":0.0,"text":"Keep moving, Decepticons!  We need to reach that lift!","show":true}],"fra":[{"time":0.0,"text":"Avancez, Decepticons\u00a0! Nous devons atteindre ce monte-charge\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008744":{"duration":4.419,"int":[{"time":0.0,"text":"Move back inside!  Perhaps we can avoid Omega's tracking systems.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008747":{"duration":9.823,"int":[{"time":0.0,"text":"They must be coordinating with Omega Supreme, trying to locate us.  Well, we'll give them what they want... along with a painful death!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008753":{"duration":4.028,"int":[{"time":0.0,"text":"There, Omega Supreme is distracted!  Attack the Autobots!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008754":{"duration":2.709,"int":[{"time":0.0,"text":"Move quickly!  The bridge terminal is just ahead!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008757":{"duration":4.445,"int":[{"time":0.0,"text":"Let's get off this road and out of the open.  We will find another way!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008764":{"duration":6.262,"int":[{"time":0.0,"text":"Perfect. We shall ascend, and Omega Supreme will follow...to his destruction.","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008765":{"duration":4.278,"int":[{"time":0.0,"text":"More cloaked Autobots!  Destroy them!  Shoot anything that moves!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008766":{"duration":5.787,"int":[{"time":0.0,"text":"We've reached the ion turrets.  Now--let Omega Supreme come!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008768":{"duration":2.519,"int":[{"time":0.0,"text":"Blast the Autobots and take those guns!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008769":{"duration":1.935,"int":[{"time":0.0,"text":"Homing rockets!  Take cover!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008774":{"duration":6.158,"int":[{"time":0.0,"text":"Attack, Decepticons!  We defeat Omega Supreme here or we die trying!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008777":{"duration":5.337,"int":[{"time":0.0,"text":"Your power is failing, Omega.  Soon you shall bend to my will!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008851":{"duration":2.786,"int":[{"time":0.0,"text":"I gave you an order!  Fall back NOW!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008857":{"duration":1.947,"int":[{"time":0.0,"text":"Move faster, Decepticons!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008861":{"duration":1.64,"int":[{"time":0.0,"text":"Out of the energy tube!  Now!","show":true}],"fra":[{"time":0.0,"text":"Sortez de la conduite\u00a0! Vite\u00a0!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK008865":{"duration":5.056,"int":[{"time":0.0,"text":"Omega flees like a coward!  Now--let's finish the job!","show":true}]},"WL_DX_MGTRON.DX_MGTRON_LK009364":{"duration":3.897,"int":[{"time":0.0,"text":"Target the repair sentries, or we'll never destroy these Autobots!","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK000116":{"duration":3.584,"int":[{"time":0.0,"text":"Target: re-acquired.  Weapons: engaging.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK000158":{"duration":7.66,"int":[{"time":0.0,"text":"Targets: re-acquired.  Attack: commencing.  Decepticons: prepare for destruction.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK000540":{"duration":4.821,"int":[{"time":0.0,"text":"Identification: Decepticons.  Action: Terminate.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK001033":{"duration":5.093,"int":[{"time":0.0,"text":"Detecting: small arms fire.  Analysis: minor annoyance.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK001037":{"duration":3.018,"int":[{"time":0.0,"text":"Primary weapon: charging.","show":true}],"fra":[{"time":0.0,"text":"Arme principale\u00a0: initialisation.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK001050":{"duration":7.928,"int":[{"time":0.0,"text":"Target identification: Megatron, Decepticon leader.  Recommendation: complete termination.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK008708":{"duration":5.422,"int":[{"time":0.0,"text":"Identity: Omega Supreme. Enemy status: TERMINATED.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK008720":{"duration":3.927,"int":[{"time":0.0,"text":"Target: Acquired.  Mission: Destroy.","show":true}],"fra":[{"time":0.0,"text":"Cible\u00a0: confirm\u00e9e. Mission\u00a0: \u00e9limination.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK008752":{"duration":4.538,"int":[{"time":0.0,"text":"New targets: Acquired.  Initiating:  Pursuit.","show":true}],"fra":[{"time":0.0,"text":"Nouvelles cibles\u00a0: confirm\u00e9es. Action en cours\u00a0: poursuite.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK008761":{"duration":2.219,"int":[{"time":0.0,"text":"Decepticons:  Located.","show":true}],"fra":[{"time":0.0,"text":"Decepticons\u00a0: localis\u00e9s.","show":true}]},"WL_DX_OMEGAS.DX_OMEGAS_LK008770":{"duration":1.847,"int":[{"time":0.0,"text":"Rockets: Activated.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000103":{"duration":3.755,"int":[{"time":0.0,"text":"Omega Supreme's armor is too thick for our weapons.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000105":{"duration":3.755,"int":[{"time":0.0,"text":"Megatron. I am receiving a Decepticon transmission.","show":true}],"fra":[{"time":0.0,"text":"Megatron. R\u00e9ception d'une transmission Decepticon.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000108":{"duration":6.144,"int":[{"time":0.0,"text":"Starscream cannot hear you, Megatron. All communication to the surface has been jammed.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000111":{"duration":4.203,"int":[{"time":0.0,"text":"There is too much interference. We must move higher to relay your signal.","show":true}],"fra":[{"time":0.0,"text":"Il y a trop d'interf\u00e9rences. Attends encore un peu avant de transmettre ton signal.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000125":{"duration":8.107,"int":[{"time":0.0,"text":"Megatron -- analysis indicates the firepower of those turrets is sufficient to damage Omega Supreme.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000148":{"duration":9.472,"int":[{"time":0.0,"text":"Megatron -- I detect numerous Decepticon and Autobot signals a few dozen meters above us. We are nearing the surface battle.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000542":{"duration":3.648,"int":[{"time":0.0,"text":"Suggestion: Use Dark Energon to open the door.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000555":{"duration":5.675,"int":[{"time":0.0,"text":"Scans reveal poor structural integrity surrounding this maintenance access door.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000557":{"duration":7.232,"int":[{"time":0.0,"text":"The bridge is just ahead. It may be necessary to extend the tube by accessing the bridge controls.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000560":{"duration":4.373,"int":[{"time":0.0,"text":"The bridge is extended. We now have access to the other side.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK000619":{"duration":8.192,"int":[{"time":0.0,"text":"Megatron -- scanners indicate a bridge nearby. Crossing there will give us access to a second elevator.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK001039":{"duration":6.763,"int":[{"time":0.0,"text":"Warning! Sensors indicate Omega Supreme is powering up his primary beam weapon!","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK001042":{"duration":4.48,"int":[{"time":0.0,"text":"Megatron -- Omega Supreme's armor has been breached.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK001045":{"duration":4.373,"int":[{"time":0.0,"text":"Megatron -- sensors indicate Autobot fliers incoming.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK001048":{"duration":1.579,"int":[{"time":0.0,"text":"The elevator is locked down.","show":true}],"fra":[{"time":0.0,"text":"Le monte-charge est verrouill\u00e9.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK001056":{"duration":6.08,"int":[{"time":0.0,"text":"Megatron, the Autobot security systems are countering the effects of Dark Energon.","show":true}],"fra":[{"time":0.0,"text":"Megatron, les syst\u00e8mes de s\u00e9curit\u00e9 Autobots tentent de contrer les effets de l'\u00e9nergon noir.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK002336":{"duration":3.797,"int":[{"time":0.0,"text":"This lift will provide passage to the surface when activated.","show":true}],"fra":[{"time":0.0,"text":"Une fois activ\u00e9, ce monte-charge nous emm\u00e8nera jusqu'\u00e0 la surface.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK002338":{"duration":9.28,"int":[{"time":0.0,"text":"Fortified Autobot position located straight ahead. Jamming Autobot scanners now. Our approach should be undetected.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003712":{"duration":1.941,"int":[{"time":0.0,"text":"Omega Supreme approaches!","show":true}],"fra":[{"time":0.0,"text":"Omega Supreme en approche\u00a0!","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK003722":{"duration":6.805,"int":[{"time":0.0,"text":"Megatron -- these are Iacon power maintenance tunnels. Moving through them will lead to the bridge terminal.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008700":{"duration":1.621,"int":[{"time":0.0,"text":"We are being intercepted!","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008715":{"duration":7.765,"int":[{"time":0.0,"text":"Megatron -- there is a Decepticon dropship across the bridge. They appear to be scanning for survivors.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008723":{"duration":1.899,"int":[{"time":0.0,"text":"Our weapons are ineffective.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008736":{"duration":6.784,"int":[{"time":0.0,"text":"During our approach to this sector, my scanners detected ion cannons near the top of the chasm wall.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008756":{"duration":2.283,"int":[{"time":0.0,"text":"Mapping alternate route now.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008763":{"duration":7.573,"int":[{"time":0.0,"text":"Megatron -- the second cargo elevator is nearby. It will take us directly to the heavy ion turrets.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008771":{"duration":5.525,"int":[{"time":0.0,"text":"Caution:  We are being tracked by multiple explosive projectiles.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008775":{"duration":7.509,"int":[{"time":0.0,"text":"According to my calculations, our chances of defeating Omega Supreme are... very low.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008778":{"duration":5.099,"int":[{"time":0.0,"text":"Scanners indicate Omega Supreme's power levels are dropping.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008852":{"duration":2.581,"int":[{"time":0.0,"text":"The bridge is rapidly disintegrating.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008858":{"duration":3.285,"int":[{"time":0.0,"text":"Omega Supreme is closing on us, Megatron.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008860":{"duration":6.72,"int":[{"time":0.0,"text":"Caution: any contact with the energy beams will cause severe systems damage.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK008862":{"duration":2.261,"int":[{"time":0.0,"text":"Tube temperature will soon be fatal.","show":true}],"fra":[{"time":0.0,"text":"La temp\u00e9rature ambiante sera bient\u00f4t fatale.","show":true}]},"WL_DX_SNDWAV.DX_SNDWAV_LK009365":{"duration":3.819,"int":[{"time":0.0,"text":"The automated repair systems are healing the enemy units.","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000106":{"duration":13.359,"int":[{"time":0.0,"text":"To all Decepticons who fight for the glory of Cybertron! Megatron has fallen!  I, Starscream, have taken my rightful place as your leader!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000120":{"duration":2.604,"int":[{"time":0.0,"text":"Megatron?  You're alive?","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000139":{"duration":4.553,"int":[{"time":0.0,"text":"The Autobots are counter-attacking!  Retreat!  Decepticons, retreat!","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000620":{"duration":2.479,"int":[{"time":0.0,"text":"Attack?  But Megatron -","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK000738":{"duration":1.234,"int":[{"time":0.0,"text":"Death RX 1","show":false}]},"WL_DX_STSCRM.DX_STSCRM_LK008716":{"duration":3.102,"int":[{"time":0.0,"text":"Come in, Megatron!  This is Starscream, do you read me?","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008718":{"duration":3.424,"int":[{"time":0.0,"text":"Megatron! I watched you crash and burn...","show":true}]},"WL_DX_STSCRM.DX_STSCRM_LK008721":{"duration":3.172,"int":[{"time":0.0,"text":"I, uh, I'll go get help, Megatron!","show":true}]}}}
