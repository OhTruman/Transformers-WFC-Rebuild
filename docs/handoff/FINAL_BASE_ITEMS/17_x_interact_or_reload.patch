+    if (!en || FAILED(en->EnumAudioEndpoints(eCapture, DEVICE_STATE_ACTIVE, &col))) return out;
+    UINT n = 0;
+    col->GetCount(&n);
+    for (UINT i = 0; i < n; ++i) {
+        IMMDevice* d = nullptr;
+        if (FAILED(col->Item(i, &d))) continue;
+        IPropertyStore* ps = nullptr;
+        std::string name;
+        if (SUCCEEDED(d->OpenPropertyStore(STGM_READ, &ps))) {
+            PROPVARIANT v;
