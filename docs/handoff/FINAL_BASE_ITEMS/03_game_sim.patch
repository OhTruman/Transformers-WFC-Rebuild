+Character* World::svMutablePawn(int p) {
+    if (p == localPlayer_) return localDead_ ? nullptr : &player_.pawn();
+    if ((size_t)p < oppByPlayer_.size()) { MatchOpponent* o = oppByPlayer_[(size_t)p]; return o && o->spawned() ? &o->pawn() : nullptr; }
+    return nullptr;
+}
