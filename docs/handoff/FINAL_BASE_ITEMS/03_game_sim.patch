+int World::cpTestFireFactory(int k) {
+    if (k < 0 || (size_t)k >= cp_.factories.size() || cp_.factories[(size_t)k].op < 0) return -1;
+    cp_.vm.impulse(cp_.factories[(size_t)k].op, 0);
+    return (int)cp_.factories[(size_t)k].pool.size();
+}
