+            b.reaction = r["reaction"].asFloat(b.reaction); b.turnRateDeg = r["turnRateDeg"].asFloat(b.turnRateDeg);
+            b.aimErrorDeg = r["aimErrorDeg"].asFloat(b.aimErrorDeg); b.fovDeg = r["fovDeg"].asFloat(b.fovDeg);
