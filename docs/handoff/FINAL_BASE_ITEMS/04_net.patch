@@ -0,0 +1,54 @@
+// [Systems] Voice codec - see VoiceCodec.h.
+#include "net/VoiceCodec.h"
+
+#ifdef WFC_OPUS
+#include <opus.h>
+#endif
+
+namespace net {
+
+#ifdef WFC_OPUS
+bool voiceCodecAvailable() { return true; }
+
+VoiceEncoder::VoiceEncoder() {
+    int err = 0;
+    OpusEncoder* e = opus_encoder_create(kVoiceRate, 1, OPUS_APPLICATION_VOIP, &err);
+    if (err != OPUS_OK || !e) return;
+    opus_encoder_ctl(e, OPUS_SET_BITRATE(16000));
+    opus_encoder_ctl(e, OPUS_SET_VBR(0));                 // constant size: a predictable voice lane
+    opus_encoder_ctl(e, OPUS_SET_INBAND_FEC(1));          // some resilience to a lost frame
+    opus_encoder_ctl(e, OPUS_SET_PACKET_LOSS_PERC(5));
+    enc_ = e;
+}
+VoiceEncoder::~VoiceEncoder() { if (enc_) opus_encoder_destroy((OpusEncoder*)enc_); }
+bool VoiceEncoder::encode(const VoiceFrame& pcm, std::vector<uint8_t>& out) {
+    if (!enc_) return false;
+    out.resize(256);
+    const opus_int32 n = opus_encode((OpusEncoder*)enc_, pcm.data(), kVoiceFrameSamples, out.data(), (opus_int32)out.size());
+    if (n < 0) { out.clear(); return false; }
+    out.resize((size_t)n);
+    return true;
+}
+
+VoiceDecoder::VoiceDecoder() {
+    int err = 0;
+    OpusDecoder* d = opus_decoder_create(kVoiceRate, 1, &err);
+    if (err == OPUS_OK) dec_ = d;
+}
+VoiceDecoder::~VoiceDecoder() { if (dec_) opus_decoder_destroy((OpusDecoder*)dec_); }
+bool VoiceDecoder::decode(const uint8_t* data, size_t n, VoiceFrame& pcm) {
+    if (!dec_) return false;
+    const int got = opus_decode((OpusDecoder*)dec_, data, data ? (opus_int32)n : 0, pcm.data(), kVoiceFrameSamples, 0);
+    return got == kVoiceFrameSamples;
+}
+#else
+bool voiceCodecAvailable() { return false; }
+VoiceEncoder::VoiceEncoder() {}
+VoiceEncoder::~VoiceEncoder() {}
+bool VoiceEncoder::encode(const VoiceFrame&, std::vector<uint8_t>& out) { out.clear(); return false; }
+VoiceDecoder::VoiceDecoder() {}
+VoiceDecoder::~VoiceDecoder() {}
+bool VoiceDecoder::decode(const uint8_t*, size_t, VoiceFrame&) { return false; }
+#endif
+
+}  // namespace net
diff --git a/src/net/VoiceCodec.h b/src/net/VoiceCodec.h
new file mode 100644
index 00000000..8eca8900
--- /dev/null
+++ b/src/net/VoiceCodec.h
@@ -0,0 +1,37 @@
+#pragma once
+// [Systems] Voice codec (ONLINE_MP_ARCHITECTURE.md section 7): Opus, mono 16 kHz, 20 ms frames, VOIP application, a fixed 16 kbit/s
+// (~40 bytes a frame). One VoiceEncoder per local talker, one VoiceDecoder per remote talker (Opus decoders keep state: packet-loss
+// concealment fills a lost frame). Built only with WFC_OPUS (tools/net/fetch_opus.py); without it available() is false and the session
+// reports "voice unavailable".
+#include "net/VoiceFrames.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace net {
+
+bool voiceCodecAvailable();
+
+class VoiceEncoder {
+public:
+    VoiceEncoder();
+    ~VoiceEncoder();
+    VoiceEncoder(const VoiceEncoder&) = delete;
+    VoiceEncoder& operator=(const VoiceEncoder&) = delete;
+    bool encode(const VoiceFrame& pcm, std::vector<uint8_t>& out);   // false = unavailable / error
+private:
+    void* enc_ = nullptr;
+};
+
+class VoiceDecoder {
+public:
+    VoiceDecoder();
+    ~VoiceDecoder();
+    VoiceDecoder(const VoiceDecoder&) = delete;
+    VoiceDecoder& operator=(const VoiceDecoder&) = delete;
+    bool decode(const uint8_t* data, size_t n, VoiceFrame& pcm);   // data == nullptr: conceal one lost frame
+private:
+    void* dec_ = nullptr;
+};
+
+}  // namespace net
diff --git a/src/net/VoiceFrames.cpp b/src/net/VoiceFrames.cpp
new file mode 100644
index 00000000..dd5b864d
--- /dev/null
+++ b/src/net/VoiceFrames.cpp
@@ -0,0 +1,73 @@
+// [Systems] Voice capture framing - see VoiceFrames.h.
+#include "net/VoiceFrames.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace net {
+
+void VoiceFramer::configure(int inputRate, int channels) {
+    std::lock_guard<std::mutex> lk(m_);
+    rate_ = std::max(8000, inputRate);
+    channels_ = std::max(1, channels);
+    step_ = (double)rate_ / (double)kVoiceRate;
+    acc_ = 0.0; need_ = step_; sum_ = 0.0; curN_ = 0; frameSq_ = 0.0;
+    out_.clear();
+}
+
+void VoiceFramer::push(const float* in, size_t frames) {
+    for (size_t f = 0; f < frames; ++f) {
+        float mono = 0.0f;
+        for (int c = 0; c < channels_; ++c) mono += in[f * (size_t)channels_ + (size_t)c];
+        mono /= (float)channels_;
+        // Box filter: each output sample is the mean of the `step_` input samples it covers (an input sample can be split between two
+        // outputs, or - below 16 kHz input - feed several).
+        double remaining = 1.0;
+        while (remaining > 1e-9) {
+            const double take = std::min(remaining, need_ - acc_);
+            sum_ += mono * take; acc_ += take; remaining -= take;
+            if (acc_ >= need_ - 1e-9) {
+                const float c = std::max(-1.0f, std::min(1.0f, (float)(sum_ / step_)));
+                cur_[(size_t)curN_++] = (int16_t)std::lround(c * 32767.0f);
+                frameSq_ += (double)c * c;
+                if (curN_ == kVoiceFrameSamples) {
+                    level_.store((float)std::sqrt(frameSq_ / kVoiceFrameSamples));
+                    std::lock_guard<std::mutex> lk(m_);
+                    out_.push_back(cur_);
+                    while (out_.size() > 50) out_.pop_front();   // 1 s backlog at most (a stalled consumer drops the oldest)
+                    curN_ = 0; frameSq_ = 0.0;
+                }
+                sum_ = 0.0; acc_ = 0.0;
+            }
+        }
+    }
+}
+
+bool VoiceFramer::pop(VoiceFrame& out) {
+    std::lock_guard<std::mutex> lk(m_);
+    if (out_.empty()) return false;
+    out = out_.front();
+    out_.pop_front();
+    return true;
+}
+
+size_t VoiceFramer::queued() const {
+    std::lock_guard<std::mutex> lk(m_);
+    return out_.size();
+}
+
+#ifndef _WIN32
+namespace {
+class NullVoiceCapture final : public IVoiceCapture {
+public:
+    bool start() override { return false; }
+    void stop() override {}
+    bool running() const override { return false; }
+    bool pop(VoiceFrame&) override { return false; }
+    float level() const override { return 0.0f; }
+};
+}  // namespace
+std::unique_ptr<IVoiceCapture> createVoiceCapture() { return std::make_unique<NullVoiceCapture>(); }
+#endif
+
+}  // namespace net
diff --git a/src/net/VoiceFrames.h b/src/net/VoiceFrames.h
new file mode 100644
index 00000000..8413d68e
--- /dev/null
+++ b/src/net/VoiceFrames.h
@@ -0,0 +1,53 @@
+#pragma once
+// [Systems] Voice capture framing (ONLINE_MP_ARCHITECTURE.md section 7): the capture device's samples (float, any rate / channel count)
+// -> mono 16 kHz, 20 ms frames of 320 int16 samples - the codec's input. Box-filtered resampling (each output sample = the mean of the
+// input samples it covers; enough for voice at 16 kHz), a per-frame RMS level (0..1, the Settings > Audio mic-test meter and the
+// voice-activity gate). Platform neutral; the device side is IVoiceCapture (Win32VoiceCapture.cpp: WASAPI shared-mode capture).
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+
+namespace net {
+
+constexpr int kVoiceRate = 16000;
+constexpr int kVoiceFrameSamples = 320;   // 20 ms at 16 kHz
+using VoiceFrame = std::array<int16_t, kVoiceFrameSamples>;
+
+class VoiceFramer {
+public:
+    void configure(int inputRate, int channels);
+    void push(const float* interleaved, size_t frames);   // device frames (channels samples each)
+    bool pop(VoiceFrame& out);                            // the next complete 20 ms frame
+    float level() const { return level_.load(); }         // RMS of the last completed frame, 0..1 (pre-gate)
+    size_t queued() const;
+
+private:
+    int rate_ = 48000, channels_ = 1;
+    double step_ = 3.0;          // input samples per output sample
+    double acc_ = 0.0, need_ = 3.0;
+    double sum_ = 0.0;
+    VoiceFrame cur_{};
+    int curN_ = 0;
+    double frameSq_ = 0.0;
+    std::atomic<float> level_{0.0f};
+    mutable std::mutex m_;
+    std::deque<VoiceFrame> out_;
+};
+
+// The device side (WASAPI on Windows; null elsewhere). start() opens the default capture endpoint; frames are pulled with pop().
+class IVoiceCapture {
+public:
+    virtual ~IVoiceCapture() = default;
+    virtual bool start() = 0;
+    virtual void stop() = 0;
+    virtual bool running() const = 0;
+    virtual bool pop(VoiceFrame& out) = 0;
+    virtual float level() const = 0;
+};
+std::unique_ptr<IVoiceCapture> createVoiceCapture();
+
+}  // namespace net
diff --git a/src/net/VoiceSession.cpp b/src/net/VoiceSession.cpp
new file mode 100644
index 00000000..2ff6148e
--- /dev/null
+++ b/src/net/VoiceSession.cpp
@@ -0,0 +1,214 @@
+// [Systems] The voice lane - see VoiceSession.h.
+#include "net/VoiceSession.h"
+
+#include "audio/Audio.h"
+#include "core/Log.h"
+#include "net/Lockstep.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+
+namespace net {
+namespace {
+
+double nowMs() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+constexpr uint8_t kVoicePacket = 7, kFlagRadio = 1, kFlagProximity = 2;
+constexpr double kFrameMs = 20.0;
+// The original's dialog cue (BL_HUD_INTERFACE.DX_SLIDER_VOLUME, DX_DRY): DistanceMin 400 UU, DistanceMax 6400 UU, the FMOD inverse
+// (log) rolloff: full within 4 m, -6 dB per doubling, silent beyond 64 m.
+constexpr float kProxMin = 4.0f, kProxMax = 64.0f;
+int16_t seqDiff(uint16_t a, uint16_t b) { return (int16_t)(uint16_t)(a - b); }
+
+}  // namespace
+
+VoiceSession::VoiceSession(Lockstep& ls, audio::IAudio* audio, const Config& c)
+    : VoiceSession(Link{[&ls] { return ls.self(); }, [&ls](const uint8_t* p, size_t n) { ls.sendVoice(p, n); },
+                        [&ls](std::function<void(int, const uint8_t*, size_t)> f) { ls.setVoiceSink(std::move(f)); }},
+                   audio, c) {}
+
+VoiceSession::VoiceSession(const Link& link, audio::IAudio* audio, const Config& c) : link_(link), audio_(audio), cfg_(c) {
+    link_.setSink([this](int seat, const uint8_t* p, size_t n) { receive(seat, p, n); });
+    if (!voiceCodecAvailable()) LOG_WARN("voice: Opus not in this build - voice unavailable");
+}
+
+VoiceSession::~VoiceSession() {
+    link_.setSink(nullptr);
+    if (mic_) mic_->stop();
+    for (auto& kv : talkers_) {
+        if (audio_ && kv.second.stream >= 0) audio_->closeStream(kv.second.stream);
+        if (audio_ && kv.second.pstream >= 0) audio_->closePositionalStream(kv.second.pstream);
+    }
+    LOG_INFO("voice: sent %ld frames, received %ld (late %ld), played %ld, concealed %ld, underruns %ld; heard as radio %ld, proximity %ld "
+             "(occluded %ld), not for this listener %ld", stats_.sent, stats_.received, stats_.late, stats_.played, stats_.concealed,
+             stats_.underruns, stats_.radio, stats_.proximity, stats_.occluded, stats_.unheard);
+}
+
+void VoiceSession::setSource(std::unique_ptr<IVoiceCapture> mic) { mic_ = std::move(mic); }
+void VoiceSession::setConfig(const Config& c) { const int j = cfg_.jitterFrames; cfg_ = c; cfg_.jitterFrames = j; }
+
+int VoiceSession::headsetState(int seat) const {
+    auto it = heard_.find(seat);
+    if (it == heard_.end()) return 0;
+    const double age = nowMs() - it->second.lastMs;
+    return age < 250.0 ? 2 : age < 10000.0 ? 1 : 0;
+}
+uint8_t VoiceSession::lastVia(int seat) const { auto it = heard_.find(seat); return it == heard_.end() ? 0 : it->second.via; }
+void VoiceSession::setSyntheticTone(float hz) { toneHz_ = hz; }
+
+float VoiceSession::micLevel() const { return mic_ ? mic_->level() : 0.0f; }
+
+void VoiceSession::update(bool talking, const SeatPos& seatPos, const SameTeam& sameTeam, const Occluded& occluded, const Room& room,
+                          const core::Vec3& listener, const core::Vec3& listenerRight) {
+    const double now = nowMs();
+    // ---- send: this seat's 20 ms frames while talking ----
+    if (voiceCodecAvailable() && (cfg_.radio || cfg_.proximity)) {
+        std::vector<VoiceFrame> frames;
+        if (toneHz_ > 0.0f) {   // TEST ONLY: a synthetic talker at real time (50 frames / s) while talking
+            if (!talking) toneStartMs_ = -1.0;
+            else {
+                if (toneStartMs_ < 0.0) { toneStartMs_ = now; toneSent_ = 0.0; }
+                while ((toneSent_ + 1.0) * kFrameMs <= now - toneStartMs_) {
+                    VoiceFrame f;
+                    for (int i = 0; i < kVoiceFrameSamples; ++i) {
+                        f[(size_t)i] = (int16_t)std::lround(0.3 * 32767.0 * std::sin(tonePhase_));
+                        tonePhase_ += 6.283185307 * toneHz_ / kVoiceRate;
+                    }
+                    frames.push_back(f);
+                    toneSent_ += 1.0;
+                }
+            }
+        } else if (mic_) {
+            if (talking && !mic_->running()) mic_->start();
+            if (!talking && mic_->running()) mic_->stop();
+            VoiceFrame f;
+            while (mic_->pop(f)) {
+                if (!talking) continue;
+                if (cfg_.openMic) {   // the voice gate: a frame above gateDb opens it for hangMs
+                    double e = 0.0;
+                    for (int16_t v : f) e += (double)v * (double)v;
+                    const double rms = std::sqrt(e / (double)kVoiceFrameSamples) / 32768.0;
+                    const double db = rms > 1e-9 ? 20.0 * std::log10(rms) : -120.0;
+                    if (db >= cfg_.gateDb) gateOpenUntil_ = now + cfg_.hangMs;
+                    if (now >= gateOpenUntil_) { ++stats_.gated; continue; }
+                }
+                frames.push_back(f);
+            }
+        }
+        for (const VoiceFrame& f : frames) {
+            std::vector<uint8_t> opus;
+            if (!enc_.encode(f, opus)) continue;
+            std::vector<uint8_t> pkt = {kVoicePacket, (uint8_t)link_.self(), (uint8_t)seq_, (uint8_t)(seq_ >> 8),
+                                        (uint8_t)((cfg_.radio ? kFlagRadio : 0) | (cfg_.proximity ? kFlagProximity : 0))};
+            pkt.insert(pkt.end(), opus.begin(), opus.end());
+            link_.send(pkt.data(), pkt.size());   // to the host (a client) or fanned out (the host)
+            ++seq_; ++stats_.sent;
+            Heard& me = heard_[link_.self()]; me.lastMs = now; me.via = pkt[4];
+        }
+    }
+    // ---- play: every remote talker, one frame per 20 ms of wall time ----
+    if (lastPlayMs_ <= 0.0) lastPlayMs_ = now;
+    int ticks = 0;
+    while (now - lastPlayMs_ >= kFrameMs && ticks < 10) { lastPlayMs_ += kFrameMs; ++ticks;
+        for (auto& kv : talkers_) playTalker(kv.first, kv.second, seatPos, sameTeam, occluded, room, listener, listenerRight);
+    }
+    if (ticks == 10) lastPlayMs_ = now;   // a long stall: do not burst-play the backlog
+}
+
+void VoiceSession::receive(int seat, const uint8_t* p, size_t n) {
+    if (n < 6 || p[0] != kVoicePacket) return;
+    Talker& t = talkers_[seat];
+    if (!t.dec) t.dec = std::make_unique<VoiceDecoder>();
+    const uint16_t seq = (uint16_t)(p[2] | (p[3] << 8));
+    ++stats_.received;
+    { Heard& h = heard_[seat]; h.lastMs = nowMs(); h.via = p[4]; }   // the indicator shows a muted talker too (as the original)
+    if (muted_ && muted_(seat)) { ++stats_.muted; t.buf.clear(); t.playing = false; return; }
+    if (t.playing && seqDiff(seq, t.next) < 0) { ++stats_.late; return; }   // its play-out slot has passed
+    if (t.buf.size() < 50) t.buf[seq] = {p[4], std::vector<uint8_t>(p + 5, p + n)};
+}
+
+void VoiceSession::playTalker(int seat, Talker& t, const SeatPos& seatPos, const SameTeam& sameTeam, const Occluded& occluded,
+                              const Room& room, const core::Vec3& listener, const core::Vec3& right) {
+    if (!t.playing) {
+        if ((int)t.buf.size() < cfg_.jitterFrames) return;   // fill the jitter buffer first
+        t.playing = true; t.missesInRow = 0;
+        t.next = t.buf.begin()->first;
+        for (const auto& kv : t.buf) if (seqDiff(kv.first, t.next) < 0) t.next = kv.first;   // the oldest (wrap-safe)
+    }
+    VoiceFrame pcm{};
+    bool have = false;
+    auto it = t.buf.find(t.next);
+    const bool concealedFrame = it == t.buf.end();   // (before the erase below)
+    if (it != t.buf.end()) {
+        t.lastFlags = it->second.first;
+        have = t.dec->decode(it->second.second.data(), it->second.second.size(), pcm);
+        t.buf.erase(it);
+        t.missesInRow = 0;
+        if (have) ++stats_.played;
+    } else if (t.missesInRow < 3) {   // a lost / late frame: Opus concealment
+        have = t.dec->decode(nullptr, 0, pcm);
+        ++t.missesInRow;
+        if (have) ++stats_.concealed;
+    } else {   // the talker stopped (or a long gap): back to buffering
+        t.playing = false; ++stats_.underruns;
+        return;
+    }
+    ++t.next;
+    if (!have) return;
+    if (tap_) tap_(seat, pcm, concealedFrame);
+    (void)right;   // the mixer pans positional streams itself
+    // Who hears it: radio = the talker's team, 2D at the voice volume; proximity (opt-in: the audience row) = anyone in earshot, as a
+    // 3D voice in the cue mix (falloff, pan, the listener's room reverb, occlusion); radio wins for teammates. An open channel (FFA,
+    // after EndGame: setOpenChannel) = everyone, 2D.
+    const bool radio = open_ || ((t.lastFlags & kFlagRadio) && sameTeam && sameTeam(seat));
+    if (!radio) {
+        core::Vec3 at;
+        if (!(t.lastFlags & kFlagProximity) || !seatPos || !seatPos(seat, at)) { ++stats_.unheard; return; }   // not for this listener
+        const double now = nowMs();
+        const float dist = core::length(at - listener);
+        // TEST ONLY: WFC_VOICE_MAXDIST widens the earshot cut-off so a harness can reach the proximity path when the talkers spawn far
+        // apart (the falloff below stays the original's curve).
+        static const float maxD = std::getenv("WFC_VOICE_MAXDIST") ? (float)std::atof(std::getenv("WFC_VOICE_MAXDIST")) : kProxMax;
+        static const bool vlog0 = std::getenv("WFC_VOICELOG") != nullptr;
+        if (dist >= maxD) {
+            ++stats_.unheard;
+            if (vlog0 && now - t.lastLogMs >= 2000.0) { t.lastLogMs = now; LOG_INFO("VOICE seat %d proximity: %.1f m - out of earshot (%.0f m)", seat, dist, maxD); }
+            return;
+        }
+        if (occluded && now - t.lastOccMs >= 250.0) { t.lastOccMs = now; t.occluded = occluded(listener, at); }   // OcclusionCheckInterval
+        const float target = t.occluded ? 0.5f : 1.0f;   // -6 dB
+        const float stepG = 0.5f * (float)(kFrameMs / 500.0);   // the full 1 -> 0.5 swing over 0.5 s
+        t.occGain = t.occGain < target ? std::min(target, t.occGain + stepG) : std::max(target, t.occGain - stepG);
+        ++stats_.proximity; if (t.occluded) ++stats_.occluded;
+        static const bool vlog = std::getenv("WFC_VOICELOG") != nullptr;
+        if (vlog && now - t.lastLogMs >= 2000.0) {
+            t.lastLogMs = now;
+            LOG_INFO("VOICE seat %d proximity: %.1f m, %s (gain %.2f), listener room %s", seat, dist, t.occluded ? "occluded" : "clear",
+                     t.occGain, room ? room().c_str() : "?");
+        }
+        if (!audio_) return;
+        if (t.pstream < 0) t.pstream = audio_->openPositionalStream(kVoiceRate);
+        if (t.pstream < 0) return;
+        audio_->setPositionalStream(t.pstream, at, cfg_.volume * t.occGain, kProxMin, maxD, true);
+        float mono[kVoiceFrameSamples];
+        for (int i = 0; i < kVoiceFrameSamples; ++i) mono[i] = (float)pcm[(size_t)i] / 32768.0f;
+        audio_->pushPositionalStream(t.pstream, mono, kVoiceFrameSamples);
+        return;
+    }
+    ++stats_.radio;
+    if (!audio_) return;
+    const float gainL = cfg_.volume, gainR = cfg_.volume;
+    if (t.stream < 0) t.stream = audio_->openStream(kVoiceRate);
+    if (t.stream < 0) return;
+    float lr[kVoiceFrameSamples * 2];
+    for (int i = 0; i < kVoiceFrameSamples; ++i) {
+        const float v = (float)pcm[(size_t)i] / 32768.0f;
+        lr[2 * i] = v * gainL; lr[2 * i + 1] = v * gainR;
+    }
+    audio_->pushStream(t.stream, lr, kVoiceFrameSamples);
+}
+
+}  // namespace net
