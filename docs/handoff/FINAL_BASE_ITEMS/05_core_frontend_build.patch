+        bool sameTeams = ma.onlineSlots.size() == mb.onlineSlots.size();
+        std::string teams;
+        for (size_t i = 0; sameTeams && i < ma.onlineSlots.size(); ++i) {
+            sameTeams = ma.onlineSlots[i].team == mb.onlineSlots[i].team && ma.onlineSlots[i].member == mb.onlineSlots[i].member;
+            teams += std::to_string(ma.onlineSlots[i].team) + "/" + std::to_string(mb.onlineSlots[i].team) + " ";
+        }
+        int hostSlotTeam = -1, memberSlotTeam = -1;
+        for (const frontend::SessionSlot& sl : ma.onlineSlots) {
+            if (sl.kind != frontend::SessionSlot::Kind::Human) continue;
+            if (sl.member == ma.self) hostSlotTeam = sl.team; else if (sl.member == mb.self) memberSlotTeam = sl.team;
+        }
+        check(!ma.self.fingerprint.empty() && ma.self == a.currentMatch().self, "the host knows its own member id (" + ma.self.fingerprint + ")");
+        check(sameTeams, "the same teams in every slot on both (host/member: " + teams + ")");
+        check(ma.teamIndex == hostSlotTeam && mb.teamIndex == memberSlotTeam,
+              "each side's own team = its slot's (host " + std::to_string(ma.teamIndex) + " / " + std::to_string(hostSlotTeam) + ", member " +
+              std::to_string(mb.teamIndex) + " / " + std::to_string(memberSlotTeam) + ")");
+        // The load gate, as the Application drives it: matchLoaded() once the world is in. The host loads first and waits
+        // (its loading screen stays up) until the member has loaded too; then both enter the match.
+        a.matchLoaded();
+        pump(1.0, nullptr);
+        check(a.level() == L::Match && a.loading().active, "load gate: the host waits on its loading screen for the member");
+        b.matchLoaded();
+        check(pump(5.0, [&] { return !a.loading().active && !b.loading().active && b.level() == L::Match; }),
+              "load gate: both released into the match once both have loaded");
+    }
+    b.call("Game.QuitToMainMenu", {});
+    b.popupButton('A');
+    const bool left = pump(10.0, [&] { return b.sessionRole() == Role::Offline && a.onlineMembers().empty(); });
+    check(left, "member quits: offline again, the host lists nobody else");
+    LOG_INFO("ONLINEFLOWTEST SUMMARY: %d failure(s)", fails);
+}
+
+// WFC_SOLOLAUNCHTEST [Systems] (headless, no session): the frontend's launch of a private match hosted alone (one human slot, this
+// player's) through fillOnlineLaunch - no seat order and no lockstep driver (the local loop runs it) - then the same launch twice
+// with the same seed, 1400 steps of the local loop each (PlayerBot input): the two simStateHash streams must be equal. A launch with a
+// second human must keep the seat order (the driver path). One SUMMARY line; exit 0 = PASS.
+void core::Application::runSoloLaunchTest() {
+    int fails = 0;
+    auto check = [&fails](bool ok, const char* what) { LOG_INFO("SOLOLAUNCHTEST %s: %s", ok ? "PASS" : "FAIL", what); if (!ok) ++fails; };
+    const std::string url = "MP_IAC_Streets?GameModeTag=TDM?BotsFriendly=2?BotsEnemy=2?PointsToWin=1000";
+    frontend::MatchLaunch m;
+    m.seed = 0x5eed0042u; m.teamIndex = 0;
+    m.self.fingerprint = "WFC-SOLO-HOST";
+    frontend::SessionSlot me; me.kind = frontend::SessionSlot::Kind::Human; me.member = m.self; me.team = 0;
+    frontend::SessionSlot bot; bot.kind = frontend::SessionSlot::Kind::Bot; bot.team = 1;
+    m.onlineSlots = {me, bot};
+    auto build = [&](const frontend::MatchLaunch& ml) {
+        game::MatchLaunch gl;
+        game::MatchLaunch::fromURL(url, gl);
+        gl.map = world_.mapName();
+        gl.localTeam = ml.teamIndex;
+        fillOnlineLaunch(gl, ml);
+        return gl;
+    };
+    const game::MatchLaunch solo = build(m);
+    check(solo.humans.empty() && solo.localSeat < 0, "alone: no seat order (the pre-phase-2 local path)");
+    check(!(solo.online && !solo.humans.empty()), "alone: the launch starts no lockstep driver");
+    frontend::MatchLaunch two = m;
+    frontend::SessionSlot other; other.kind = frontend::SessionSlot::Kind::Human; other.member.fingerprint = "WFC-SOLO-PEER"; other.team = 1;
+    two.onlineSlots.push_back(other);
+    const game::MatchLaunch duo = build(two);
+    check(duo.online && duo.humans.size() == 2 && duo.localSeat == 0, "with a second human: the seat order (the driver path)");
+    const float step = clock_.stepSeconds();
+    // mode 0: the synchronous step (World::tick). 1 / 2: the frame loop's async step - tickPrefix, GameMode, then launchStep (the
+    // remainder on the sim thread) overlapping the main thread's "draw", joined at the next frame top; 2 adds a varying 0-6 ms
+    // draw gap with presentation reads (render-only timing must not reach the sim: x33, Rendering 2026-10-23).
+    auto run = [&](std::vector<uint64_t>& hashes, int mode = 0) {
+        if (!world_.launchMatch(solo)) return false;
+        world_.match().requireCharacterSelection(world_.localMatchPlayer());
+        game::CharacterSelection cs; cs.type = 0; cs.specialty = game::Specialty::Soldier; cs.weapons = {"AssaultRifle", "HomingRocket", "FlakGrenades"};
+        world_.match().selectCharacter(world_.localMatchPlayer(), cs);
+        uint32_t lcg = 12345u;
+        for (int i = 0; i < 1400; ++i) {
+            if (mode > 0) world_.joinStep();   // the frame top
+            platform::InputFrame input;
+            world_.playerBotInput(input, step);
+            world_.handleInput(input, step);
+            if (mode == 0) world_.tick(step);
+            else world_.tickPrefix(step);
+            gameMode_.tick(world_, step);
+            if (mode > 0) {
+                world_.launchStep();   // after the draw: overlaps endFrame / present / HUD
+                if (mode == 2) {
+                    lcg = lcg * 1664525u + 1013904223u;
+                    const auto until = std::chrono::steady_clock::now() + std::chrono::microseconds((lcg >> 8) % 6000);
+                    float acc = 0.0f;
+                    while (std::chrono::steady_clock::now() < until)   // presentation reads, as the HUD / renderer do
+                        for (size_t p = 0; p < world_.match().players().size(); ++p)
+                            if (const game::Character* c = world_.participantPawn((int)p)) acc += c->position().x;
+                    (void)acc;
+                }
+                world_.joinStep();   // the hash reads a whole step
+            }
+            if ((i + 1) % 100 == 0) hashes.push_back(world_.simStateHash());
+        }
+        world_.joinStep();
+        return true;
+    };
+    std::vector<uint64_t> h1, h2;
+    const bool ok1 = run(h1), ok2 = run(h2);
+    check(ok1 && ok2, "both launches accepted");
+    size_t firstDiff = h1.size();
+    for (size_t i = 0; i < h1.size() && i < h2.size(); ++i) if (h1[i] != h2[i]) { firstDiff = i; break; }
+    check(!h1.empty() && h1.size() == h2.size() && firstDiff == h1.size(), "same seed twice: equal simStateHash every 100 steps to 1400");
+    if (!h1.empty()) LOG_INFO("SOLOLAUNCHTEST hash at 1400: %016llx / %016llx", (unsigned long long)h1.back(), (unsigned long long)(h2.empty() ? 0 : h2.back()));
+    std::vector<uint64_t> h3, h4;
+    const bool ok3 = run(h3, 1), ok4 = run(h4, 2);
+    check(ok3 && ok4 && h3 == h1, "the async step (remainder on the sim thread) = the synchronous step, every 100 steps");
+    check(ok4 && h4 == h1, "the async step with a varying 0-6 ms draw gap + presentation reads = the synchronous step");
+    if (!h3.empty() && !h4.empty()) LOG_INFO("SOLOLAUNCHTEST async hash at 1400: %016llx / %016llx", (unsigned long long)h3.back(), (unsigned long long)h4.back());
+    LOG_INFO("SOLOLAUNCHTEST SUMMARY: %s (%d failed)", fails ? "FAIL" : "PASS", fails);
+    exitCode_ = fails ? 1 : 0;
+}
