+    }
+    LOG_INFO("NET all %d seats here after %.2f s", seats, secsSince(t0));
+
+    uint32_t nextLocal = 1;
+    const bool pace = std::getenv("WFC_NET_PACE") != nullptr;
+    long steps = 0;
+    bool started = false;
+    auto tRun = std::chrono::steady_clock::now();
