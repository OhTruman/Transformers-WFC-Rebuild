+void FrontendRuntime::setCinematicMode(bool on, bool hideHud) {
+    if (!flow_.campaign()) return;
+    if (on) {
+        cinematicShowPending_ = false;
+        if (hideHud && !cinematicHudHidden_) {
+            cinematicHudHidden_ = true;
+            flow_.onUIEvent(12);              // ShowHudFalse
+            hud_.setPromptsSuppressed(true);
+        }
+    } else if (cinematicHudHidden_) {
+        cinematicShowPending_ = true;       // UI event 13 once no full-screen movie plays (updateCinematicHud)
+    }
+    FlowTrace::emit("campaign.cinematicMode", {{"on", FlowTrace::boolean(on)}, {"hideHud", FlowTrace::boolean(hideHud)},
+                                               {"hudHidden", FlowTrace::boolean(cinematicHudHidden_)}});
+}
+
+void FrontendRuntime::updateOnlineVoice() {
+    if (flow_.pttCaptureActive()) {
+        const uint16_t vk = keyProbe ? keyProbe() : platform::firstKeyDown();
+        if (!pttCaptureArmed_) pttCaptureArmed_ = vk == 0;
+        else if (vk == 0x1B) flow_.endPttCapture("");   // Esc
+        else if (vk) {
+            const std::string name = platform::nameForVirtualKey(vk);
+            if (!name.empty()) flow_.endPttCapture(name);
+        }
+    } else pttCaptureArmed_ = false;
+    {   // I2: the invite code to the clipboard (the flow stays platform-free)
+        const std::string clip = flow_.takeClipboardRequest();
+        if (!clip.empty() && !std::getenv("WFC_NOCLIPBOARD"))   // TEST ONLY switch: the test binary leaves the desktop clipboard alone
+            FlowTrace::emit("online.inviteClipboard", {{"ok", FlowTrace::boolean(platform::setClipboardText(clip))}});
+    }
+    const bool online = flow_.online() && flow_.sessionRole() != GameFlow::SessionRole::Offline;
+    if (online != voiceUiOverride_) {   // the player row's A: "Mute / Block" (the PC player card) while in an online session
+        voiceUiOverride_ = online;
+        catalog_.setKeyOverride("$UIText.PlayerList.Gamercard",
+                                online ? catalog_.localizeKey("$WfcPC.Online.PlayerCardMute") + " / " + catalog_.localizeKey("$WfcPC.Online.PlayerCardBlock")
+                                       : std::string());
+    }
+    if (online) flow_.setPushToTalkHeld(platform::isKeyHeld(platform::virtualKeyForName(flow_.profile().voice.pttKey)));
+}
+
+void FrontendRuntime::updateCinematicHud() {
+    if (!cinematicShowPending_ || fullScreenMovie_) return;
+    cinematicShowPending_ = false;
+    cinematicHudHidden_ = false;
+    flow_.onUIEvent(13);                    // ShowHudTrue
+    hud_.setPromptsSuppressed(false);
+    FlowTrace::emit("campaign.cinematicMode", {{"on", "false"}, {"hudShown", "true"}});
+}
+
+bool FrontendRuntime::showTutorialMessage(const std::string& type) {
+    if (!flow_.campaign()) return false;
+    LocalProfile& p = flow_.profile();
+    if (std::find(p.tutorialsShown.begin(), p.tutorialsShown.end(), type) != p.tutorialsShown.end()) {
+        FlowTrace::emit("campaign.tutorial", {{"type", type}, {"shown", "false"}, {"why", "already shown for this profile"}});
+        return false;
+    }
+    const std::string raw = catalog_.localize("TransGame", "TutorialMessages", type);
+    if (raw.empty()) {
+        FlowTrace::emit("campaign.tutorial", {{"type", type}, {"shown", "false"}, {"why", "no TutorialMessages text"}});
+        return false;
+    }
+    const std::string text = prompts_.translate(raw, device_.pad());   // TranslateCommandsInString
+    hud_.tutorialMessage(text);
+    if (audio_) audio_->playUiSound("WHSH_TUTORIAL_BOX");   // BL_LVL_HUD_INTERFACE.WHSH_TUTORIAL_BOX (script side)
+    p.tutorialsShown.push_back(type);                       // MarkTutorialMessageAsShown
+    p.save();
+    FlowTrace::emit("campaign.tutorial", {{"type", type}, {"shown", "true"}, {"text", text}});
+    return true;
+}
