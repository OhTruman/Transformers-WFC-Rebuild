+    // human i on every peer (Gameplay GAMEPLAY_SEAT_ORDER): wire seat index == match player.
+    game::MatchLaunch L;
+    if (!game::MatchLaunch::fromURL(url, L)) { LOG_ERROR("NET: bad WFC_MATCH_URL"); exitCode_ = 7; return; }
