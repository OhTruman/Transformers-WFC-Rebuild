+void World::spawnMuzzleLight(const std::string& weaponClass, const core::Mat4& socketWorld, int owner) {
+    const MuzzleLightDef* d = muzzleLightFor(weaponClass);
+    if (!d) return;
+    LiveMuzzleLight l;
+    l.pos = {socketWorld.m[12], socketWorld.m[13], socketWorld.m[14]};
+    l.color = {d->color[0], d->color[1], d->color[2]};
+    l.radius = d->radius; l.falloff = d->falloff; l.left = d->duration; l.owner = owner;
+    static const bool log = std::getenv("WFC_MUZZLELOG") != nullptr;
+    static int logged = 0;
+    if (log && logged < 40) {
+        ++logged;
+        LOG_INFO("MUZZLE LIGHT %s owner %d at %.2f,%.2f,%.2f r %.2f m colour %.2f,%.2f,%.2f falloff %.0f for %.2f s", weaponClass.c_str(),
+                 owner, l.pos.x, l.pos.y, l.pos.z, l.radius, l.color.x, l.color.y, l.color.z, l.falloff, l.left);
+    }
+    for (LiveMuzzleLight& o : muzzleLights_)
+        if (o.owner == owner) { o = l; return; }   // one MuzzleFlashLight component per weapon: a new shot restarts it
+    muzzleLights_.push_back(l);
+}
+
+void World::tickMuzzleLights(float dt) {
+    for (size_t i = 0; i < muzzleLights_.size();) {
+        if ((muzzleLights_[i].left -= dt) <= 0.0f) { muzzleLights_[i] = muzzleLights_.back(); muzzleLights_.pop_back(); }
+        else ++i;
+    }
+}
