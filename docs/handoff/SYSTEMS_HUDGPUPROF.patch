+// [Systems, M1 diagnostics] WFC_HUDGPUPROF=<N>: HUD GPU time by work category. Every N-th HUD frame a GL_TIMESTAMP goes in
+// at each change of category (not per draw); the stamps are read back at the next sampled frame (N >= 4 frames later, so
+// never a stall). Logged every 200 sampled frames: mean ms per sampled frame per category, stamps per frame, and the text
+// shadows (count, box area, share unchanged since the previous frame - the redraw-on-change lever). Off: nothing runs.
+namespace hudprof {
+enum Cat { BackCopy, Target, FillDirect, FillStencil, Glyph, Stroke, Bitmap, Mask, ShCover, ShBlur, ShComp, Resolve, Composite, Video, ShDraw, NCat };
+const char* const kName[NCat] = {"backcopy", "clear+backdrop", "fill-direct", "fill-stencil", "glyph", "stroke", "bitmap", "mask",
+                                 "shadow-switch+clear", "shadow-blur", "shadow-comp", "resolve", "composite", "video", "shadow-glyphs"};
+constexpr int kMax = 8192;
+struct Pool { unsigned q[kMax]; signed char cat[kMax]; int n = 0; bool pending = false; bool made = false; };
+struct State {
+    int every = -1;
+    bool sampling = false;
+    int cur = -2, pi = 0;
+    Pool pools[2];
+    double sum[NCat] = {};
+    double stamps = 0;
+    long frames = 0, overflow = 0;
+    long shadows = 0, shUnchanged = 0;
+    double shArea = 0;
+    std::unordered_map<const void*, uint64_t> lastKey;
+};
+State& st() { static State s; return s; }
+int every() {
+    State& S = st();
+    if (S.every < 0) S.every = std::getenv("WFC_HUDGPUPROF") ? std::max(1, std::atoi(std::getenv("WFC_HUDGPUPROF"))) : 0;
+    return S.every;
+}
+void stamp(int cat) {   // a new region of category cat starts (cat -1: the frame ends)
+    State& S = st();
+    Pool& P = S.pools[S.pi];
+    if (P.n >= kMax) { ++S.overflow; return; }
+    glx::QueryCounter(P.q[P.n], 0x8E28 /*GL_TIMESTAMP*/);
+    P.cat[P.n++] = (signed char)cat;
+    S.cur = cat;
+}
+void mark(int cat) {
+    State& S = st();
+    if (!S.sampling || S.cur == cat) return;
+    stamp(cat);
+}
+void resolve(Pool& P) {
+    State& S = st();
+    if (!P.pending) return;
+    P.pending = false;
+    if (P.n < 2) return;
+    unsigned long long prev = 0;
+    glx::GetQueryObjectui64v(P.q[0], 0x8866 /*GL_QUERY_RESULT*/, &prev);
+    for (int i = 1; i < P.n; ++i) {
+        unsigned long long t = 0;
+        glx::GetQueryObjectui64v(P.q[i], 0x8866, &t);
+        const int c = P.cat[i - 1];
+        if (c >= 0 && c < NCat && t >= prev) S.sum[c] += (double)(t - prev) * 1e-6;
+        prev = t;
+    }
+    S.stamps += P.n;
+    if (++S.frames % 200 == 0) {
+        const double f = (double)S.frames;
+        double tot = 0; for (double v : S.sum) tot += v;
+        char line[1024]; int o = std::snprintf(line, sizeof line, "HUDGPU per sampled frame (%ld): total %.4f ms |", S.frames, tot / f);
+        for (int c = 0; c < NCat && o < (int)sizeof line - 40; ++c)
+            if (S.sum[c] > 0) o += std::snprintf(line + o, sizeof line - (size_t)o, " %s %.4f", kName[c], S.sum[c] / f);
+        LOG_INFO("%s | stamps %.0f, overflow %ld", line, S.stamps / f, S.overflow);
+        LOG_INFO("HUDGPU text shadows: %.2f per frame, box %.3f Mpx per frame, unchanged since the previous frame %.1f %%",
+                 (double)S.shadows / f, S.shArea / f * 1e-6, S.shadows ? 100.0 * (double)S.shUnchanged / (double)S.shadows : 0.0);
+    }
+}
+void beginFrame(unsigned frame) {
+    State& S = st();
+    S.sampling = false;
+    if (every() == 0 || !glx::QueryCounter || !glx::GetQueryObjectui64v || !glx::GenQueries) return;
+    if (frame % (unsigned)S.every != 0) return;
+    for (Pool& P : S.pools) if (!P.made) { glx::GenQueries(kMax, P.q); P.made = true; }
+    S.pi ^= 1;
+    resolve(S.pools[S.pi]);   // the pool written two sampled frames ago
+    S.pools[S.pi].n = 0;
+    S.sampling = true;
+    S.cur = -2;
+}
+void endFrame() {
+    State& S = st();
+    if (!S.sampling) return;
+    stamp(-1);
+    S.pools[S.pi].pending = true;
+    S.sampling = false;
+}
+void shadow(const void* owner, uint64_t key, int w, int h) {   // every frame (the unchanged share needs the previous frame)
+    State& S = st();
+    if (every() == 0) return;
+    if (!S.sampling) { S.lastKey[owner] = key; return; }
+    ++S.shadows; S.shArea += (double)w * h;
+    auto it = S.lastKey.find(owner);
+    if (it != S.lastKey.end() && it->second == key) ++S.shUnchanged;
+    S.lastKey[owner] = key;
+}
+}  // namespace hudprof
