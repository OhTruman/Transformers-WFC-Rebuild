diff -ruN a/src/game/CampaignSubtitles.cpp b/src/game/CampaignSubtitles.cpp
--- a/src/game/CampaignSubtitles.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/game/CampaignSubtitles.cpp	2026-10-23 03:09:56.061577000 -0500
@@ -0,0 +1,67 @@
+// [Systems] Campaign dialog subtitles - see CampaignSubtitles.h.
+#include "game/CampaignSubtitles.h"
+
+namespace game {
+namespace {
+
+void collectWaves(const assets::Json& n, std::vector<std::string>& out) {
+    if (n["class"].asString() == "SoundNodeWaveEx" && !n["loc"].asString().empty()) out.push_back(n["node"].asString());
+    const assets::Json& ch = n["children"];
+    for (size_t i = 0; i < ch.size(); ++i) collectWaves(ch[i], out);
+}
+
+}  // namespace
+
+int CampaignSubtitles::load(const assets::Json& doc) {
+    clear();
+    const assets::Json& subs = doc["subtitles"];
+    for (const auto& kv : subs.obj) {
+        Wave w;
+        w.duration = kv.second["duration"].asFloat(0.0f);
+        for (const auto& lang : kv.second.obj) {
+            if (lang.first == "duration") continue;
+            std::vector<Line>& lines = w.byLang[lang.first];
+            for (size_t i = 0; i < lang.second.size(); ++i) {
+                const assets::Json& l = lang.second[i];
+                lines.push_back({l["time"].asFloat(0.0f), l["text"].asString(), l["show"].asBool(true)});
+            }
+        }
+        byWave_[kv.first] = std::move(w);
+    }
+    int n = 0;
+    for (const auto& kv : doc["cues"].obj) {
+        std::vector<std::string> waves;
+        collectWaves(kv.second["tree"], waves);
+        bool any = false;
+        for (const std::string& w : waves) any = any || byWave_.count(w) != 0;
+        if (!waves.empty()) cueWaves_[kv.first] = std::move(waves);
+        n += any ? 1 : 0;
+    }
+    return n;
+}
+
+const CampaignSubtitles::Wave* CampaignSubtitles::waveFor(const std::string& cue, const std::string& lang) const {
+    auto it = cueWaves_.find(cue);
+    if (it == cueWaves_.end()) return nullptr;
+    for (const std::string& name : {lang, std::string("int")})
+        for (const std::string& w : it->second) {
+            auto wi = byWave_.find(w);
+            if (wi != byWave_.end() && wi->second.byLang.count(name)) return &wi->second;
+        }
+    return nullptr;
+}
+
+const std::vector<CampaignSubtitles::Line>* CampaignSubtitles::lines(const std::string& cue, const std::string& lang) const {
+    const Wave* w = waveFor(cue, lang);
+    if (!w) return nullptr;
+    auto l = w->byLang.find(lang);
+    if (l == w->byLang.end()) l = w->byLang.find("int");
+    return l == w->byLang.end() ? nullptr : &l->second;
+}
+
+float CampaignSubtitles::duration(const std::string& cue) const {
+    const Wave* w = waveFor(cue, "int");
+    return w ? w->duration : 0.0f;
+}
+
+}  // namespace game
diff -ruN a/src/game/CampaignSubtitles.h b/src/game/CampaignSubtitles.h
--- a/src/game/CampaignSubtitles.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/game/CampaignSubtitles.h	2026-10-23 03:09:56.048030500 -0500
@@ -0,0 +1,31 @@
+#pragma once
+// [Systems] Campaign dialog subtitles (CAMPAIGN_AUDIO_DIALOG.md section 3). The chapter audio JSON (tools/systems/gen_level_audio.py
+// --campaign) carries "subtitles": {wave: {duration, int: [{time, text, show}], fra: [...]}} from the chapter's _LOC packages
+// (SoundNodeWaveEx Subtitles / Duration), and the cue trees that name each cue's localized waves. This table answers "a dialog cue
+// started: which lines, when": the first localized wave of the cue that has lines in the language (else the English "int" text).
+// show = the original's UseSubtitles (false: authored not to display - the HUD skips the line). Display is the HUD's (the original's
+// subtitle movie clip; the profile's Subtitles option, default off).
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include "assets/Json.h"
+
+namespace game {
+
+class CampaignSubtitles {
+public:
+    struct Line { float time = 0.0f; std::string text; bool show = true; };
+    // Loads a chapter audio document (its "cues" and "subtitles"); returns the number of cues with subtitles.
+    int load(const assets::Json& doc);
+    void clear() { byWave_.clear(); cueWaves_.clear(); }
+    // The lines for a dialog cue in a language ("int", "fra"; another / missing language falls back to "int"); null = none.
+    const std::vector<Line>* lines(const std::string& cue, const std::string& lang = "int") const;
+    float duration(const std::string& cue) const;   // the wave's authored Duration (s), 0 = unknown
+private:
+    struct Wave { float duration = 0.0f; std::unordered_map<std::string, std::vector<Line>> byLang; };
+    std::unordered_map<std::string, Wave> byWave_;
+    std::unordered_map<std::string, std::vector<std::string>> cueWaves_;   // cue -> its localized waves, tree order
+    const Wave* waveFor(const std::string& cue, const std::string& lang) const;
+};
+
+}  // namespace game
