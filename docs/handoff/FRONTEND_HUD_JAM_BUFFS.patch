+// Gameplay (agents/gameplay, with the camera patch): the HUD state's buffs - struct HudBuff { std::string id; float remain; };
+// std::vector<HudBuff> buffs; - the local pawn's jam / disrupt buffs while active. Into HudFrame::jamBuffs, which the HUD
+// diffs into Hud_GFX's ApplyBuff / UnapplyBuff (the jammed slots, transform disrupted). Detected.
+template <class O, class = void> struct HasHudBuffs : std::false_type {};
+template <class O> struct HasHudBuffs<O, std::void_t<decltype(std::declval<const O&>().buffs.front().id),
+                                                     decltype(std::declval<const O&>().buffs.front().remain)>> : std::true_type {};
+template <class O> void fillJamBuffs(frontend::HudFrame& hf, const O& o) {
+    if constexpr (HasHudBuffs<O>::value) {
+        std::vector<frontend::HudFrame::Buff> v;
+        for (const auto& b : o.buffs) v.push_back({b.id, (double)b.remain});
+        hf.jamBuffs = std::move(v);
+    }
+    (void)hf; (void)o;
+}
