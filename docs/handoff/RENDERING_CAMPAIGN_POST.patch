diff -ruN a/src/render/gl/WfcCampaignPost.cpp b/src/render/gl/WfcCampaignPost.cpp
--- a/src/render/gl/WfcCampaignPost.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/render/gl/WfcCampaignPost.cpp	2026-10-23 07:50:05.352179400 -0500
