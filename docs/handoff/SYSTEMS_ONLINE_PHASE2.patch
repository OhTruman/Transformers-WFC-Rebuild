+namespace net {
+namespace {
+
+#ifdef _WIN32
+using Sock = SOCKET;
+const Sock kNo = INVALID_SOCKET;
+void closeS(Sock s) { closesocket(s); }
+#else
+using Sock = int;
+const Sock kNo = -1;
+void closeS(Sock s) { close(s); }
+#endif
+
+bool wsa() {
+#ifdef _WIN32
+    static bool ok = [] { WSADATA w; return WSAStartup(MAKEWORD(2, 2), &w) == 0; }();
+    return ok;
+#else
+    return true;
+#endif
+}
+
+bool waitReadable(Sock s, int ms) {
+    fd_set f; FD_ZERO(&f); FD_SET(s, &f);
+    timeval tv{ms / 1000, (ms % 1000) * 1000};
+    return select((int)s + 1, &f, nullptr, nullptr, &tv) > 0;
+}
+
+std::string lower(std::string s) { for (char& c : s) c = (char)std::tolower((unsigned char)c); return s; }
+
+// "http://192.168.1.1:5000/rootDesc.xml" -> host, port, path
+bool splitUrl(const std::string& url, std::string& host, int& port, std::string& path) {
+    const size_t a = url.find("://");
+    const size_t h = a == std::string::npos ? 0 : a + 3;
+    const size_t p = url.find('/', h);
+    std::string hp = url.substr(h, p == std::string::npos ? std::string::npos : p - h);
+    path = p == std::string::npos ? "/" : url.substr(p);
+    const size_t c = hp.find(':');
+    host = hp.substr(0, c);
+    port = c == std::string::npos ? 80 : std::atoi(hp.c_str() + c + 1);
+    return !host.empty() && port > 0;
+}
+
+// One HTTP/1.0 request over TCP with a 1.5 s budget; returns the body ("" on failure). localIp: this side of the connection.
+std::string http(const std::string& host, int port, const std::string& request, std::string* localIp = nullptr) {
+    Sock s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == kNo) return "";
+    sockaddr_in a{};
+    a.sin_family = AF_INET; a.sin_port = htons((uint16_t)port);
+    if (inet_pton(AF_INET, host.c_str(), &a.sin_addr) != 1) { closeS(s); return ""; }
+#ifdef _WIN32
+    DWORD to = 1500; setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char*)&to, sizeof to); setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const char*)&to, sizeof to);
+#else
+    timeval to{1, 500000}; setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &to, sizeof to); setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &to, sizeof to);
+#endif
+    if (connect(s, (const sockaddr*)&a, sizeof a) != 0) { closeS(s); return ""; }
+    if (localIp) {
+        sockaddr_in me{}; socklen_t ml = sizeof me;
+        if (getsockname(s, (sockaddr*)&me, &ml) == 0) { char b[INET_ADDRSTRLEN] = {0}; inet_ntop(AF_INET, &me.sin_addr, b, sizeof b); *localIp = b; }
+    }
+    send(s, request.data(), (int)request.size(), 0);
+    std::string resp;
+    char buf[4096];
+    for (;;) {
+        const int n = (int)recv(s, buf, sizeof buf, 0);
+        if (n <= 0) break;
+        resp.append(buf, (size_t)n);
+        if (resp.size() > (1 << 20)) break;
+    }
+    closeS(s);
+    const size_t body = resp.find("\r\n\r\n");
+    if (resp.compare(0, 12, "HTTP/1.1 200") != 0 && resp.compare(0, 12, "HTTP/1.0 200") != 0) return "";
+    return body == std::string::npos ? "" : resp.substr(body + 4);
+}
+
+std::string tag(const std::string& xml, const std::string& name, size_t from = 0, size_t* at = nullptr) {
+    const std::string lx = lower(xml), ln = lower(name);
+    size_t a = lx.find("<" + ln + ">", from);
+    if (a == std::string::npos) {   // with a namespace prefix: <u:NewExternalIPAddress>
+        a = lx.find(":" + ln + ">", from);
+        if (a == std::string::npos) return "";
+        a = lx.find('>', a);
+    } else {
+        a = lx.find('>', a);
+    }
+    const size_t e = lx.find("</", a);
+    if (e == std::string::npos) return "";
+    if (at) *at = e;
+    return xml.substr(a + 1, e - a - 1);
+}
+
+std::string soap(const PortMapResult& m, const std::string& host, int port, const std::string& action, const std::string& args) {
+    const std::string body = "<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" "
+                             "s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:" + action + " xmlns:u=\"" +
+                             m.serviceType + "\">" + args + "</u:" + action + "></s:Body></s:Envelope>";
+    const std::string req = "POST " + m.controlUrl + " HTTP/1.0\r\nHost: " + host + ":" + std::to_string(port) +
+                            "\r\nContent-Type: text/xml; charset=\"utf-8\"\r\nSOAPAction: \"" + m.serviceType + "#" + action +
+                            "\"\r\nContent-Length: " + std::to_string(body.size()) + "\r\nConnection: close\r\n\r\n" + body;
+    return http(host, port, req);
+}
+
+// Router location from SSDP (1.2 s).
+std::string ssdpLocation() {
+    Sock s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNo) return "";
+    sockaddr_in to{};
+    to.sin_family = AF_INET; to.sin_port = htons(1900);
+    inet_pton(AF_INET, "239.255.255.250", &to.sin_addr);
+    for (const char* st : {"urn:schemas-upnp-org:device:InternetGatewayDevice:1", "urn:schemas-upnp-org:service:WANIPConnection:1"}) {
+        const std::string q = std::string("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 1\r\nST: ") + st + "\r\n\r\n";
+        sendto(s, q.data(), (int)q.size(), 0, (const sockaddr*)&to, sizeof to);
+    }
+    std::string loc;
+    const auto t0 = std::chrono::steady_clock::now();
+    while (loc.empty() && std::chrono::steady_clock::now() - t0 < std::chrono::milliseconds(1200)) {
+        if (!waitReadable(s, 200)) continue;
+        char buf[2048];
+        const int n = (int)recvfrom(s, buf, sizeof buf - 1, 0, nullptr, nullptr);
+        if (n <= 0) continue;
+        buf[n] = 0;
+        const std::string r = buf, lr = lower(r);
+        const size_t a = lr.find("\nlocation:");
+        if (a == std::string::npos) continue;
+        size_t b = a + 10;
+        while (b < r.size() && r[b] == ' ') ++b;
+        const size_t e = r.find("\r", b);
+        loc = r.substr(b, e == std::string::npos ? std::string::npos : e - b);
+    }
+    closeS(s);
+    return loc;
+}
+
+}  // namespace
+
+PortMapResult upnpMapUdp(int port, int leaseSeconds, const std::string& description) {
+    PortMapResult m;
+    if (!wsa()) { m.error = "WSAStartup"; return m; }
+    const std::string loc = ssdpLocation();
+    if (loc.empty()) { m.error = "no UPnP router answered"; return m; }
+    std::string host, path;
+    int hport = 0;
+    if (!splitUrl(loc, host, hport, path)) { m.error = "bad location " + loc; return m; }
+    const std::string desc = http(host, hport, "GET " + path + " HTTP/1.0\r\nHost: " + host + ":" + std::to_string(hport) + "\r\nConnection: close\r\n\r\n", &m.localIp);
+    if (desc.empty()) { m.error = "no device description at " + loc; return m; }
+    // The first WANIPConnection (or WANPPPConnection) service and its control URL.
+    for (const char* svc : {"urn:schemas-upnp-org:service:WANIPConnection:", "urn:schemas-upnp-org:service:WANPPPConnection:"}) {
+        const size_t at = lower(desc).find(lower(svc));
+        if (at == std::string::npos) continue;
+        const size_t e = desc.find('<', at);
+        m.serviceType = desc.substr(at, e - at);
+        m.controlUrl = tag(desc, "controlURL", at);
+        break;
+    }
+    if (m.controlUrl.empty()) { m.error = "the router has no WAN connection service"; return m; }
+    if (m.controlUrl.find("://") != std::string::npos) { std::string h; int p = 0; splitUrl(m.controlUrl, h, p, m.controlUrl); }
+    if (m.controlUrl[0] != '/') m.controlUrl = "/" + m.controlUrl;
+    m.externalIp = tag(soap(m, host, hport, "GetExternalIPAddress", ""), "NewExternalIPAddress");
+    const std::string args = "<NewRemoteHost></NewRemoteHost><NewExternalPort>" + std::to_string(port) +
+                             "</NewExternalPort><NewProtocol>UDP</NewProtocol><NewInternalPort>" + std::to_string(port) +
+                             "</NewInternalPort><NewInternalClient>" + m.localIp + "</NewInternalClient><NewEnabled>1</NewEnabled>"
+                             "<NewPortMappingDescription>" + description + "</NewPortMappingDescription><NewLeaseDuration>" +
+                             std::to_string(leaseSeconds) + "</NewLeaseDuration>";
+    const std::string r = soap(m, host, hport, "AddPortMapping", args);
+    m.mapped = r.find("AddPortMappingResponse") != std::string::npos;
+    if (!m.mapped) m.error = "AddPortMapping refused";
+    m.controlUrl = host + ":" + std::to_string(hport) + m.controlUrl;   // keep the router address for the removal
+    LOG_INFO("upnp: router %s, external %s, UDP %d %s%s", loc.c_str(), m.externalIp.empty() ? "?" : m.externalIp.c_str(), port,
+             m.mapped ? "mapped" : "NOT mapped: ", m.mapped ? "" : m.error.c_str());
+    return m;
+}
+
+bool upnpUnmapUdp(const PortMapResult& m, int port) {
+    if (!m.mapped) return false;
+    const size_t slash = m.controlUrl.find('/');
+    const std::string hp = m.controlUrl.substr(0, slash);
+    PortMapResult c = m;
+    c.controlUrl = m.controlUrl.substr(slash);
+    const size_t colon = hp.find(':');
+    const std::string r = soap(c, hp.substr(0, colon), std::atoi(hp.c_str() + colon + 1), "DeletePortMapping",
+                               "<NewRemoteHost></NewRemoteHost><NewExternalPort>" + std::to_string(port) + "</NewExternalPort><NewProtocol>UDP</NewProtocol>");
+    return r.find("DeletePortMappingResponse") != std::string::npos;
+}
+
+std::string resolveIpv4(const std::string& hostPort) {
+    if (!wsa()) return "";
+    const size_t c = hostPort.rfind(':');
+    if (c == std::string::npos) return "";
+    addrinfo hints{};
+    hints.ai_family = AF_INET; hints.ai_socktype = SOCK_DGRAM;
+    addrinfo* res = nullptr;
+    if (getaddrinfo(hostPort.substr(0, c).c_str(), hostPort.c_str() + c + 1, &hints, &res) != 0 || !res) return "";
+    char b[INET_ADDRSTRLEN] = {0};
+    inet_ntop(AF_INET, &((const sockaddr_in*)res->ai_addr)->sin_addr, b, sizeof b);
+    freeaddrinfo(res);
+    return std::string(b) + hostPort.substr(c);
+}
+
+// ---- STUN (RFC 5389): 20-byte header (type, length, magic cookie 0x2112A442, transaction id), attributes TLV ----
+std::vector<uint8_t> stunRequest(uint8_t txid[12]) {
+    std::random_device rd;
+    for (int i = 0; i < 12; ++i) txid[i] = (uint8_t)rd();
+    std::vector<uint8_t> b = {0x00, 0x01, 0x00, 0x00, 0x21, 0x12, 0xA4, 0x42};
+    b.insert(b.end(), txid, txid + 12);
+    return b;
+}
+
+bool isStunPacket(const uint8_t* p, size_t n) {
+    return n >= 20 && (p[0] & 0xC0) == 0 && p[4] == 0x21 && p[5] == 0x12 && p[6] == 0xA4 && p[7] == 0x42;
+}
+
+bool stunParse(const uint8_t* p, size_t n, const uint8_t txid[12], std::string& mapped) {
+    if (!isStunPacket(p, n) || p[0] != 0x01 || p[1] != 0x01 || std::memcmp(p + 8, txid, 12) != 0) return false;   // Binding success
+    size_t i = 20;
+    while (i + 4 <= n) {
+        const int type = (p[i] << 8) | p[i + 1], len = (p[i + 2] << 8) | p[i + 3];
+        const uint8_t* v = p + i + 4;
+        if (i + 4 + (size_t)len > n) break;
+        if ((type == 0x0020 || type == 0x0001) && len >= 8 && v[1] == 0x01) {   // (XOR-)MAPPED-ADDRESS, IPv4
+            uint16_t port = (uint16_t)((v[2] << 8) | v[3]);
+            uint8_t ip[4] = {v[4], v[5], v[6], v[7]};
+            if (type == 0x0020) { port ^= 0x2112; ip[0] ^= 0x21; ip[1] ^= 0x12; ip[2] ^= 0xA4; ip[3] ^= 0x42; }
+            char b[32];
+            std::snprintf(b, sizeof b, "%u.%u.%u.%u:%u", ip[0], ip[1], ip[2], ip[3], (unsigned)port);
+            mapped = b;
+            if (type == 0x0020) return true;
+        }
+        i += 4 + (((size_t)len + 3) & ~(size_t)3);
+    }
+    return !mapped.empty();
+}
+
+}  // namespace net
diff -ruN a/src/net/NatPortMap.h b/src/net/NatPortMap.h
--- a/src/net/NatPortMap.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/NatPortMap.h	2026-10-23 00:52:47.664931900 -0500
@@ -0,0 +1,33 @@
+#pragma once
+// [Systems] Reaching a host across the internet without a server (user decision 2026-10-17: peer-to-peer only, a lobby service
+// later). Two ways to learn / open the host's public endpoint:
+// - UPnP IGD (most home routers): SSDP M-SEARCH on 239.255.255.250:1900 -> the router's description URL -> its WANIPConnection /
+//   WANPPPConnection control URL; SOAP GetExternalIPAddress + AddPortMapping (UDP, the session port, a 2 h lease, renewed by
+//   the host while it hosts) and DeletePortMapping when it stops.
+// - STUN (RFC 5389 Binding request) fallback: sent FROM the session's own socket by UdpSession (the reply carries the address the
+//   internet sees for that socket); here only the request / response coding.
+// Blocking calls with short timeouts (UPnP total <= ~3 s); the session runs them when the player hosts.
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace net {
+
+struct PortMapResult {
+    bool mapped = false;           // a UPnP mapping exists for the port
+    std::string externalIp;        // the router's WAN address ("" unknown)
+    std::string controlUrl, serviceType, localIp;   // for the renewal / removal
+    std::string error;             // why not (diagnostics)
+};
+// Find the router and map external UDP `port` -> this machine's `port` (lease seconds; 0 = permanent where allowed).
+PortMapResult upnpMapUdp(int port, int leaseSeconds, const std::string& description);
+bool upnpUnmapUdp(const PortMapResult& m, int port);
+
+// STUN: a Binding request (transaction id = 12 random bytes) and its parsed XOR-MAPPED-ADDRESS ("a.b.c.d:port").
+std::vector<uint8_t> stunRequest(uint8_t txid[12]);
+bool stunParse(const uint8_t* p, size_t n, const uint8_t txid[12], std::string& mapped);
+bool isStunPacket(const uint8_t* p, size_t n);   // a STUN message (magic cookie at bytes 4-7)
+// "name:port" -> "a.b.c.d:port" (IPv4, blocking DNS; "" on failure).
+std::string resolveIpv4(const std::string& hostPort);
+
+}  // namespace net
diff -ruN a/src/net/NetMatchDriver.cpp b/src/net/NetMatchDriver.cpp
--- a/src/net/NetMatchDriver.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/NetMatchDriver.cpp	2026-10-23 00:52:47.727145100 -0500
@@ -0,0 +1,200 @@
+// [Systems] NetMatchDriver - see NetMatchDriver.h. The headless runNetMatch loop (Application_Net.cpp) cut into per-frame calls.
+#include "net/NetMatchDriver.h"
+
+#include "core/Log.h"
+#include "game/CharacterRoster.h"
+#include "game/World.h"
+#include "net/Lockstep.h"
+#include "net/NetTransport.h"
+#include "net/VoiceSession.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace net {
+namespace {
+
+constexpr float kStep = 1.0f / 60.0f;
+constexpr int kMaxStepsPerFrame = 8;   // catch-up cap (a long hitch is not replayed at once)
+constexpr uint8_t kEventSelection = 1;
+
+void putStr(std::vector<uint8_t>& b, const std::string& s) {
+    const size_t n = std::min<size_t>(s.size(), 255);
+    b.push_back((uint8_t)n);
+    b.insert(b.end(), s.begin(), s.begin() + (long)n);
+}
+void putStrs(std::vector<uint8_t>& b, const std::vector<std::string>& v) {
+    b.push_back((uint8_t)std::min<size_t>(v.size(), 255));
+    for (size_t i = 0; i < v.size() && i < 255; ++i) putStr(b, v[i]);
+}
+void putColor(std::vector<uint8_t>& b, const game::CharacterColor& c) {
+    for (int v : {c.r, c.g, c.b, c.a, c.palette}) b.push_back((uint8_t)v);
+    for (float f : {c.x, c.y}) { const int16_t q = (int16_t)std::max(-32768.0f, std::min(32767.0f, f * 1000.0f)); b.push_back((uint8_t)q); b.push_back((uint8_t)((uint16_t)q >> 8)); }
+}
+struct Rd {
+    const std::vector<uint8_t>& d; size_t i = 0; bool ok = true;
+    explicit Rd(const std::vector<uint8_t>& v) : d(v) {}
+    int u8() { if (i >= d.size()) { ok = false; return 0; } return d[i++]; }
+    std::string str() { const size_t n = (size_t)u8(); if (i + n > d.size()) { ok = false; return ""; } std::string s((const char*)d.data() + i, n); i += n; return s; }
+    std::vector<std::string> strs() { std::vector<std::string> v((size_t)u8()); for (auto& s : v) s = str(); return v; }
+    game::CharacterColor color() {
+        game::CharacterColor c;
+        c.r = u8(); c.g = u8(); c.b = u8(); c.a = u8(); c.palette = u8();
+        for (float* f : {&c.x, &c.y}) { const int lo = u8(), hi = u8(); *f = (float)(int16_t)(uint16_t)(lo | (hi << 8)) / 1000.0f; }
+        return c;
+    }
+};
+
+}  // namespace
+
+// The selection on the wire (names, not indices: a data-order change cannot desync). Shared with the recording.
+std::vector<uint8_t> encodeSelection(const game::CharacterSelection& s) {
+    std::vector<uint8_t> b;
+    b.push_back((uint8_t)s.type); b.push_back((uint8_t)s.specialty);
+    putStr(b, s.chassisId); putStr(b, s.customSlot);
+    for (int f = 0; f < 2; ++f) putStr(b, s.chassisByFaction[f]);
+    for (int f = 0; f < 2; ++f) { putColor(b, s.primary[f]); putColor(b, s.secondary[f]); }
+    putStrs(b, s.weapons); putStrs(b, s.vehicleWeapons); putStrs(b, s.melee); putStrs(b, s.abilities); putStrs(b, s.skills);
+    return b;
+}
+bool decodeSelection(const std::vector<uint8_t>& b, game::CharacterSelection& s) {
+    Rd r(b);
+    s.type = r.u8(); s.specialty = (game::Specialty)r.u8();
+    s.chassisId = r.str(); s.customSlot = r.str();
+    for (int f = 0; f < 2; ++f) s.chassisByFaction[f] = r.str();
+    for (int f = 0; f < 2; ++f) { s.primary[f] = r.color(); s.secondary[f] = r.color(); }
+    s.weapons = r.strs(); s.vehicleWeapons = r.strs(); s.melee = r.strs(); s.abilities = r.strs(); s.skills = r.strs();
+    return r.ok;
+}
+
+struct NetMatchDriver::Impl {
+    game::World& world;
+    INetTransport& t;
+    Config cfg;
+    std::unique_ptr<Lockstep> ls;
+    std::unique_ptr<VoiceSession> voice;
+    uint32_t nextLocal = 1;
+    double accum = 0.0;
+    bool stalled = false, held = false, ended = false, talking = false;
+    uint32_t startTick = 1;
+    FILE* rec = nullptr;
+    Impl(game::World& w, INetTransport& tr, const Config& c) : world(w), t(tr), cfg(c) {}
+};
+
+NetMatchDriver::NetMatchDriver(game::World& world, INetTransport& transport, audio::IAudio* audio, const Config& cfg)
+    : impl_(std::make_unique<Impl>(world, transport, cfg)) {
+    Lockstep::Config lc;
+    lc.seats = cfg.seats; lc.self = cfg.self; lc.delay = cfg.delay; lc.hashEvery = cfg.hashEvery;
+    lc.peerTimeoutS = cfg.peerTimeoutS; lc.launchHash = cfg.launchHash;
+    impl_->ls = std::make_unique<Lockstep>(transport, lc);
+    if (!cfg.recordPath.empty()) {
+        impl_->rec = std::fopen(cfg.recordPath.c_str(), "wb");
+        if (impl_->rec) {   // the phase 1 WFC_NET_RECORD layout (WFC_NET_REPLAY reads it); events are not in it yet
+            const uint32_t ver = 1, ns = (uint32_t)cfg.seats;
+            std::fwrite("WFCR", 1, 4, impl_->rec); std::fwrite(&ver, 4, 1, impl_->rec);
+            std::fwrite(&cfg.launchHash, 8, 1, impl_->rec); std::fwrite(&ns, 4, 1, impl_->rec);
+        }
+    }
+    if (cfg.voice) {
+        impl_->voice = std::make_unique<VoiceSession>(*impl_->ls, audio, VoiceSession::Config{});
+        game::World* w = &world;
+        impl_->ls->setVoiceAudience([w](int talker, int listener, uint8_t flags) {   // as runNetMatch: match player = seat
+            const auto& ps = w->match().players();
+            if (talker < 0 || listener < 0 || (size_t)talker >= ps.size() || (size_t)listener >= ps.size()) return false;
+            if ((flags & 1) && ps[(size_t)talker].team == ps[(size_t)listener].team && ps[(size_t)talker].team != 255) return true;
+            if (!(flags & 2)) return false;
+            const game::Character* x = w->participantPawn(talker);
+            const game::Character* y = w->participantPawn(listener);
+            return x && y && core::length(x->position() - y->position()) < 64.0f + 4.0f;
+        });
+    }
+    LOG_INFO("NET driver: seat %d of %d, D %s, voice %s", cfg.self, cfg.seats, cfg.delay > 0 ? std::to_string(cfg.delay).c_str() : "auto",
+             cfg.voice ? "on" : "off");
+}
+
+NetMatchDriver::~NetMatchDriver() {
+    if (impl_->ls && !impl_->ended) impl_->ls->bye((uint32_t)impl_->world.simTick());
+    if (impl_->rec) std::fclose(impl_->rec);
+}
+
+int NetMatchDriver::frame(double dtSeconds) {
+    Impl& m = *impl_;
+    Lockstep& ls = *m.ls;
+    ls.pump();
+    // Events (every seat's, this one's too): applied by the World at their tick.
+    Lockstep::Event ev;
+    while (ls.pollEvent(ev)) {
+        if (ev.kind == kEventSelection) {
+            game::CharacterSelection sel;
+            if (decodeSelection(ev.payload, sel)) { if (m.cfg.onSelection) m.cfg.onSelection(ev.seat, sel, ev.atTick); }
+            else LOG_WARN("NET driver: a bad selection event from seat %d", ev.seat);
+        }
+    }
+    if (m.voice) {   // the listener = the local pawn (its right vector from the facing yaw)
+        game::World& w = m.world;
+        const game::Character* me = w.participantPawn(m.cfg.self);
+        const core::Vec3 lp = me ? me->position() + core::Vec3{0, 1.8f, 0} : core::Vec3{0, 0, 0};
+        const float yaw = me ? me->yaw() : 0.0f;
+        const core::Vec3 right = core::normalize(core::cross(core::forwardFromYawPitch(yaw, 0.0f), core::Vec3{0, 1, 0}));
+        const int self = m.cfg.self;
+        m.voice->update(m.talking,
+                        [&w](int seat, core::Vec3& out) { const game::Character* c = w.participantPawn(seat); if (!c) return false; out = c->position() + core::Vec3{0, 1.8f, 0}; return true; },
+                        [&w, self](int seat) { const auto& ps = w.match().players(); return (size_t)seat < ps.size() && (size_t)self < ps.size() && ps[(size_t)seat].team == ps[(size_t)self].team && ps[(size_t)seat].team != 255; },
+                        [&w](const core::Vec3& a, const core::Vec3& b) { return w.soundBlocked(a, b); },
+                        [&w]() { return w.currentReverbPreset(); }, lp, right);
+    }
+    if (ls.status() != Lockstep::Status::Running) { m.ended = true; return 0; }
+    if (m.held) { m.accum = 0.0; return 0; }
+    m.accum = std::min(m.accum + dtSeconds, (double)kStep * kMaxStepsPerFrame);
+    int steps = 0;
+    m.stalled = false;
+    while (m.accum >= kStep && steps < kMaxStepsPerFrame) {
+        const uint32_t n = (uint32_t)m.world.simTick() + 1;
+        if (ls.endTick() > 0 && n > ls.endTick()) { m.ended = true; break; }
+        while (m.nextLocal <= n + (uint32_t)ls.delay()) {   // this seat's commands up to N + D (the local controller's input now)
+            game::RemoteCommand c = m.world.encodeLocalCommand();
+            c.tick = m.nextLocal;
+            ls.submitLocal(m.nextLocal, c);
+            ++m.nextLocal;
+        }
+        if (!ls.haveAll(n)) { m.stalled = true; ls.stalled(dtSeconds * 1000.0); break; }
+        for (int s = 0; s < m.cfg.seats; ++s) {
+            game::RemoteCommand c;
+            ls.command(s, n, c);
+            m.world.applyRemoteCommand(s, c);
+        }
+        if (m.rec) {
+            std::fwrite(&n, 4, 1, m.rec);
+            for (int s = 0; s < m.cfg.seats; ++s) { WireCommand w{}; ls.wire(s, n, w); std::fwrite(w.data(), 1, w.size(), m.rec); }
+        }
+        if (m.cfg.step) m.cfg.step(kStep);
+        const uint64_t h = m.world.simStateHash();
+        ls.stepped(n, h);
+        ls.reportHash(n, h);
+        if (n > 64) ls.forget(n - 64);
+        m.accum -= kStep;
+        ++steps;
+    }
+    if (ls.status() != Lockstep::Status::Running) m.ended = true;
+    return steps;
+}
+
+bool NetMatchDriver::stalled() const { return impl_->stalled; }
+bool NetMatchDriver::held() const { return impl_->held; }
+void NetMatchDriver::setHeld(bool held, uint32_t startTick) { impl_->held = held; if (startTick) impl_->startTick = startTick; }
+bool NetMatchDriver::finished() const { return impl_->ended; }
+int NetMatchDriver::status() const { return (int)impl_->ls->status(); }
+int NetMatchDriver::droppedSeat() const { return -1; }   // [PARTIAL] the session reports drops (PeerDropped) for now
+int NetMatchDriver::localSeat() const { return impl_->cfg.self; }
+int NetMatchDriver::delay() const { return impl_->ls->delay(); }
+float NetMatchDriver::rttMs() const { return impl_->ls->rttMs(); }
+VoiceSession* NetMatchDriver::voice() { return impl_->voice.get(); }
+void NetMatchDriver::setTalking(bool talking) { impl_->talking = talking; }
+
+void NetMatchDriver::chooseCharacter(const game::CharacterSelection& sel) {
+    const uint32_t at = impl_->ls->submitEvent(kEventSelection, encodeSelection(sel));
+    LOG_INFO("NET driver: Choose Character -> event at tick %u", at);
+}
+
+}  // namespace net
diff -ruN a/src/net/NetMatchDriver.h b/src/net/NetMatchDriver.h
--- a/src/net/NetMatchDriver.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/net/NetMatchDriver.h	2026-10-23 00:52:47.792368800 -0500
@@ -0,0 +1,73 @@
+#pragma once
+// [Systems] The online match in the real window (ONLINE_PHASE2_SPLIT.md item 2a): the per-frame driver of the lockstep match,
+// called by the Application's normal frame loop instead of runNetMatch's headless loop (which stays for the harness).
+//
+// Contract with Gameplay (agreed 2026-10-17):
+// - The Application keeps its per-frame World::handleInput (camera / controller; online the pawn moves only through commands).
+// - frame(dt): pump the transport; submit this seat's commands up to tick N + D (World::encodeLocalCommand, re-stamped to its
+//   target tick); when tick N is complete for every seat, World::applyRemoteCommand(seat, cmd) for each seat, then the step
+//   callback once (World::tick + GameMode::tick); hashes / record / BYE as phase 1. While tick N is incomplete nothing steps
+//   (stalled(): the HUD may show it); handleInput / drawing keep running and presentation interpolates.
+// - Events: a second per-seat reliable ordered stream of tick-stamped events, applied on every peer before the step of their tick
+//   and recorded / replayed like commands. Kind 1 = Choose Character: chooseCharacter(sel) sends {seat, atTick = simTick + D + 1,
+//   sel (wire: names, not indices)}; every peer calls World::queueSeatSelection(seat, sel, atTick) on arrival.
+// - held(): from the session's reportLoaded until AllLoaded's start tick (the load gate): no step, no submit.
+// - The match seats are the launch record's humans (match player i = seat i on every peer); localSeat() = MatchLaunch::localSeat.
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace audio { class IAudio; }
+namespace game { class World; struct CharacterSelection; }
+
+namespace net {
+
+class INetTransport;
+class Lockstep;
+class VoiceSession;
+
+class NetMatchDriver {
+public:
+    struct Config {
+        int seats = 2;                 // humans in the launch record
+        int self = 0;                  // this machine's seat (MatchLaunch::localSeat)
+        uint64_t launchHash = 0;       // the launch record's hash (HELLO: a mismatch ends the match, JoinFailed{Version})
+        int hashEvery = 60;            // state hash exchange period in ticks (desync detection)
+        int delay = 0;                 // input delay in ticks; 0 = auto (RTT + the arrival-lead feedback)
+        double peerTimeoutS = 8.0;     // a peer silent this long is dropped (the frontend's ConnectionTimeout)
+        std::string recordPath;        // WFC_NET_RECORD-style recording ("" none)
+        bool voice = true;             // the voice lane (VoiceSession) on this match
+        std::function<void(float)> step;   // World::tick + GameMode::tick, once per complete tick (fixed dt)
+        // A seat's Choose Character (event kind 1), on every peer when it arrives: World::queueSeatSelection(seat, sel, atTick).
+        std::function<void(int seat, const game::CharacterSelection& sel, uint32_t atTick)> onSelection;
+    };
+    // `transport` is the session's match view (seats = match seats); the driver owns the Lockstep built over it.
+    NetMatchDriver(game::World& world, INetTransport& transport, audio::IAudio* audio, const Config& cfg);
+    ~NetMatchDriver();
+    NetMatchDriver(const NetMatchDriver&) = delete;
+    NetMatchDriver& operator=(const NetMatchDriver&) = delete;
+
+    // Once per rendered frame (dt = the frame's wall time). Returns the sim steps taken (0 when stalled / held, up to a catch-up
+    // cap when behind).
+    int frame(double dtSeconds);
+
+    bool stalled() const;              // tick N waits for a seat's commands
+    bool held() const;                 // the load gate (no step until the start tick)
+    void setHeld(bool held, uint32_t startTick = 0);
+    bool finished() const;             // the match ended normally (every seat's BYE / the match end) or failed (see status)
+    int status() const;                // phase 1 exit codes: 0 running / ended, 3 desync, 4 peer timeout, 5 host lost, 6 launch mismatch
+    int droppedSeat() const;           // the seat a timeout / leave is about (-1 none)
+    int localSeat() const;
+    int delay() const;                 // the current input delay D (ticks)
+    float rttMs() const;
+    void chooseCharacter(const game::CharacterSelection& sel);   // the local seat's in-match pick (Choose Character screen)
+    VoiceSession* voice();             // null without the voice lane
+    void setTalking(bool talking);     // push-to-talk / open mic state from the session's voice settings
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
