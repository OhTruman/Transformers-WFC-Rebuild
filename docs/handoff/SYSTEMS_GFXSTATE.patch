+bool glShadowOff() { static const bool off = std::getenv("WFC_NOGFXSTATESHADOW") != nullptr; return off; }
+// WFC_GFXSTATESHADOW_VERIFY=1: every skipped call is checked against glGet (the real context state); a mismatch would mean the
+// shadow is wrong (some write bypassed it) and the image could differ. Diagnostics only (the glGets stall the pipeline).
+bool glShadowVerify() { static const bool v = std::getenv("WFC_GFXSTATESHADOW_VERIFY") != nullptr; return v; }
+long gVerifySkips = 0, gVerifyBad = 0, gVerifyFrames = 0;
+void verifyFail(const char* what, long got, long want) {
+    if (++gVerifyBad <= 20) LOG_ERROR("GFXSTATESHADOW VERIFY mismatch: %s real %ld, shadow %ld", what, got, want);
+}
+GLint getI(GLenum e) { GLint v = 0; glGetIntegerv(e, &v); return v; }
+}
+static void gfxShadowVerifyFrame() {
+    if (glShadowVerify() && ++gVerifyFrames % 600 == 0)
+        LOG_INFO("GFXSTATESHADOW VERIFY %ld HUD frames: %ld skipped calls checked, %ld mismatches", gVerifyFrames, gVerifySkips, gVerifyBad);
+}
+#ifndef GL_STENCIL_BACK_FUNC
+#define GL_STENCIL_BACK_FUNC 0x8800
+#define GL_STENCIL_BACK_FAIL 0x8801
+#define GL_STENCIL_BACK_PASS_DEPTH_FAIL 0x8802
+#define GL_STENCIL_BACK_PASS_DEPTH_PASS 0x8803
+#define GL_STENCIL_BACK_REF 0x8CA3
+#define GL_STENCIL_BACK_VALUE_MASK 0x8CA4
+#define GL_STENCIL_BACK_WRITEMASK 0x8CA5
+#endif
+void GfxRendererGL::sColorMask(bool on) {
+    if (!glShadowOff() && gs_.colorMask == (on ? 1 : 0)) {
+        if (glShadowVerify()) {
+            ++gVerifySkips;
+            GLboolean cm[4] = {0, 0, 0, 0}; glGetBooleanv(GL_COLOR_WRITEMASK, cm);
+            for (int i = 0; i < 4; ++i) if ((cm[i] != 0) != on) { verifyFail("colorMask", cm[i], on); break; }
+        }
+        return;
+    }
+    const GLboolean v = on ? GL_TRUE : GL_FALSE;
+    glColorMask(v, v, v, v);
+    gs_.colorMask = on ? 1 : 0;
+}
+void GfxRendererGL::sStencilFunc(unsigned func, int ref, unsigned mask) {
+    if (!glShadowOff() && gs_.func == func && gs_.ref == (unsigned)ref && gs_.valueMask == mask) {
+        if (glShadowVerify()) {
+            ++gVerifySkips;
+            if ((unsigned)getI(GL_STENCIL_FUNC) != func || getI(GL_STENCIL_REF) != ref || (unsigned)getI(GL_STENCIL_VALUE_MASK) != mask ||
+                (unsigned)getI(GL_STENCIL_BACK_FUNC) != func || getI(GL_STENCIL_BACK_REF) != ref || (unsigned)getI(GL_STENCIL_BACK_VALUE_MASK) != mask)
+                verifyFail("stencilFunc", getI(GL_STENCIL_FUNC), (long)func);
+        }
+        return;
+    }
+    glStencilFunc((GLenum)func, ref, mask);
+    gs_.func = func; gs_.ref = (unsigned)ref; gs_.valueMask = mask;
+}
+void GfxRendererGL::sStencilMask(unsigned mask) {
+    if (!glShadowOff() && gs_.writeMaskKnown && gs_.writeMask == mask) {
+        if (glShadowVerify()) {
+            ++gVerifySkips;
+            if ((unsigned)getI(GL_STENCIL_WRITEMASK) != mask || (unsigned)getI(GL_STENCIL_BACK_WRITEMASK) != mask)
+                verifyFail("stencilMask", getI(GL_STENCIL_WRITEMASK), (long)mask);
+        }
+        return;
+    }
+    glStencilMask(mask);
+    gs_.writeMask = mask; gs_.writeMaskKnown = true;
+}
+void GfxRendererGL::sStencilOp(unsigned sfail, unsigned dpfail, unsigned dppass) {
+    const unsigned v[3] = {sfail, dpfail, dppass};
+    if (!glShadowOff() && std::equal(v, v + 3, gs_.op[0]) && std::equal(v, v + 3, gs_.op[1])) {
+        if (glShadowVerify()) {
+            ++gVerifySkips;
+            const unsigned r[6] = {(unsigned)getI(GL_STENCIL_FAIL), (unsigned)getI(GL_STENCIL_PASS_DEPTH_FAIL), (unsigned)getI(GL_STENCIL_PASS_DEPTH_PASS),
+                                   (unsigned)getI(GL_STENCIL_BACK_FAIL), (unsigned)getI(GL_STENCIL_BACK_PASS_DEPTH_FAIL), (unsigned)getI(GL_STENCIL_BACK_PASS_DEPTH_PASS)};
+            if (!std::equal(v, v + 3, r) || !std::equal(v, v + 3, r + 3)) verifyFail("stencilOp", (long)r[0], (long)v[0]);
+        }
+        return;
+    }
+    glStencilOp((GLenum)sfail, (GLenum)dpfail, (GLenum)dppass);
+    for (int f = 0; f < 2; ++f) std::copy(v, v + 3, gs_.op[f]);
